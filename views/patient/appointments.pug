doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#FFFFFF")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-appointments.css")
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/patient-appointments.js", defer)
    body.sv-dashboard.appointments-page
        .sv-layout
            include partials/sidebar
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include partials/topbar
                main.appointments-content
                    section.appointments-hero
                        .appointments-hero-copy
                            h2 Mis citas
                            p Consulta el estado y los detalles de tus citas médicas.
                    if previewMode
                        p.appointments-preview-note Vista previa: estas citas son ficticias y solo se muestran para revisar el diseño.
                    section.appointment-stats(aria-label="Resumen de citas")
                        each stat in appointmentStats
                            - const count = stat.status ? appointments.filter((a) => (a.status && a.status.name) === stat.status).length : appointments.length;
                            article.appointment-stat(class="stat-" + stat.key)
                                span.stat-icon(aria-hidden="true")= stat.key === "all" ? "▦" : stat.key === "confirmed" ? "✓" : stat.key === "in-progress" ? "◷" : stat.key === "attended" ? "✓" : "×"
                                span.stat-copy
                                    strong= count
                                    small= stat.label
                    section.appointment-list-panel(aria-label="Listado de citas")
                        .appointment-tabs(role="group", aria-label="Filtrar citas")
                            button.is-active(type="button", data-filter="all", aria-pressed="true") Todas
                            button(type="button", data-filter="upcoming", aria-pressed="false") Próximas
                            button(type="button", data-filter="attended", aria-pressed="false") Asistidas
                            button(type="button", data-filter="cancelled", aria-pressed="false") Canceladas
                        .appointment-tools
                            label.appointment-search
                                span(aria-hidden="true") ⌕
                                input(
                                    type="search",
                                    placeholder="Buscar por especialidad, médico…",
                                    aria-label="Buscar citas",
                                    data-search
                                )
                            label.appointment-select
                                span.sr-only Filtrar por especialidad
                                span.appointment-filter-icon(aria-hidden="true")
                                    svg(viewBox="0 0 24 24")
                                        path(d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z")
                                select(data-specialty, aria-label="Filtrar por especialidad")
                                    option(value="") Todas las especialidades
                                    each name in specialties
                                        option(value=name)= name
                            label.appointment-select.desktop-filter
                                span.sr-only Estado
                                span.appointment-filter-icon(aria-hidden="true") ◷
                                select(data-status)
                                    option(value="") Todos los estados
                                    option(value="Confirmed") Confirmadas
                                    option(value="In Progress") En curso
                                    option(value="Attended") Atendidas
                                    option(value="Cancelled") Canceladas
                        if appointments.length
                            .appointment-table-wrap
                                table.appointment-table
                                    thead
                                        tr
                                            th Fecha y hora
                                            th Especialidad
                                            th Médico
                                            th Sede
                                            th Estado
                                            th Detalles
                                    tbody
                                        each appointment in appointments
                                            - const date = new Date(appointment.start_at);
                                            - const status = (appointment.status && appointment.status.name) || "Confirmed";
                                            - const doctorName = appointment.doctor_label || (appointment.doctor && appointment.doctor.display_name) || "Médico asignado";
                                            - const statusClass = status === "In Progress" ? "in-progress" : status.toLowerCase();
                                            - const statusLabel = status === "Attended" ? "Atendida" : status === "Cancelled" ? "Cancelada" : status === "In Progress" ? "En curso" : "Confirmada";
                                            //- Only confirmed future appointments with remaining attempts can be rescheduled.
                                            - const reschedulesUsed = (appointment.history || []).filter((event) => event.event_type === "Rescheduled").length;
                                            - const canReschedule = !previewMode && status === "Confirmed" && date.getTime() > Date.now() && reschedulesUsed < 3;
                                            //- Cancellation requires a confirmed appointment at least 24 hours away.
                                            - const canCancel = !previewMode && status === "Confirmed" && date.getTime() - Date.now() >= 24 * 60 * 60 * 1000;
                                            tr(
                                                id="appointment-" + appointment.id,
                                                data-appointment,
                                                data-status=status,
                                                data-date=date.toISOString(),
                                                data-specialty=(appointment.specialty && appointment.specialty.name) || "",
                                                data-search-text=((appointment.specialty && appointment.specialty.name) || "") + " " + doctorName
                                            )
                                                td(data-label="Fecha y hora")
                                                    .appointment-date
                                                        strong= date.toLocaleDateString("es-CO", { day: "2-digit", timeZone: "America/Bogota" })
                                                        span= date.toLocaleDateString("es-CO", { month: "short", year: "numeric", timeZone: "America/Bogota" })
                                                    span.appointment-time= date.toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: "America/Bogota" })
                                                td(data-label="Especialidad")
                                                    strong= (appointment.specialty && appointment.specialty.name) || "Consulta médica"
                                                td(data-label="Médico")
                                                    .appointment-doctor-cell
                                                        if appointment.doctor && appointment.doctor.profile_photo_url
                                                            img.appointment-doctor-photo(
                                                                src=appointment.doctor.profile_photo_url,
                                                                alt="Foto de " + doctorName,
                                                                loading="lazy"
                                                            )
                                                        else
                                                            span.appointment-doctor-photo-fallback(
                                                                aria-hidden="true"
                                                            )= doctorName.split(" ").slice(0, 2).map((part) => part[0]).join("")
                                                        span= doctorName
                                                td(data-label="Sede")= appointment.site_label || "Sede SaludVital"
                                                td(data-label="Estado")
                                                    span.appointment-status(class="status-" + statusClass)= statusLabel
                                                td.appointment-details-cell(data-label="Detalles")
                                                    .appointment-row-actions
                                                        button.appointment-detail-toggle(
                                                            type="button",
                                                            aria-haspopup="dialog",
                                                            aria-controls=`appointment-details-${appointment.id}`,
                                                            data-open-appointment-details=appointment.id
                                                        ) Ver detalles
                                                        if canReschedule
                                                            a.appointment-reschedule-link(
                                                                href=`/patient/appointments/reschedule?appointmentId=${appointment.id}`,
                                                                aria-label=`Reprogramar cita de ${(appointment.specialty && appointment.specialty.name) || "consulta médica"}`,
                                                                title="Reprogramar cita"
                                                            )
                                                                svg(
                                                                    viewBox="0 0 24 24",
                                                                    fill="none",
                                                                    stroke="currentColor",
                                                                    stroke-width="1.8",
                                                                    stroke-linecap="round",
                                                                    stroke-linejoin="round",
                                                                    aria-hidden="true",
                                                                    focusable="false"
                                                                )
                                                                    rect(
                                                                        x="3",
                                                                        y="5",
                                                                        width="18",
                                                                        height="16",
                                                                        rx="2"
                                                                    )
                                                                    path(d="M16 3v4M8 3v4M3 10h18")
                                                                    path(d="M12 14a3 3 0 1 0 3 3")
                                                                    path(d="M15 14v3h-3")
                                                        if canCancel
                                                            button.appointment-cancel-button(
                                                                type="button",
                                                                aria-label=`Cancelar cita de ${(appointment.specialty && appointment.specialty.name) || "consulta médica"}`,
                                                                title="Cancelar cita",
                                                                data-open-cancel-dialog=appointment.id
                                                            )
                                                                svg(
                                                                    viewBox="0 0 24 24",
                                                                    fill="none",
                                                                    stroke="currentColor",
                                                                    stroke-width="1.8",
                                                                    stroke-linecap="round",
                                                                    stroke-linejoin="round",
                                                                    aria-hidden="true",
                                                                    focusable="false"
                                                                )
                                                                    path(d="M4 7h16")
                                                                    path(d="M10 11v6M14 11v6")
                                                                    path(
                                                                        d="M5 7l1 14h12l1-14M9 7V4h6v3"
                                                                    )
                                                    dialog.appointment-details-dialog(
                                                        id=`appointment-details-${appointment.id}`,
                                                        aria-labelledby=`appointment-details-title-${appointment.id}`
                                                    )
                                                        .appointment-dialog-header
                                                            div
                                                                span.appointment-dialog-kicker Detalles de tu cita
                                                                h2(
                                                                    id=`appointment-details-title-${appointment.id}`
                                                                )= (appointment.specialty && appointment.specialty.name) || "Consulta médica"
                                                                p= doctorName
                                                            button.appointment-dialog-close(
                                                                type="button",
                                                                aria-label="Cerrar detalles",
                                                                data-close-appointment-details
                                                            ) ×
                                                        .appointment-dialog-body
                                                            .appointment-dialog-status
                                                                span Estado actual
                                                                span.appointment-status(
                                                                    class="status-" + statusClass
                                                                )= statusLabel
                                                            dl.appointment-detail-list
                                                                div
                                                                    dt Fecha y hora
                                                                    dd= date.toLocaleString("es-CO", { dateStyle: "long", timeStyle: "short", timeZone: "America/Bogota" })
                                                                div
                                                                    dt Sede
                                                                    dd= appointment.site_label || "Sede SaludVital"
                                                                if appointment.reason
                                                                    div
                                                                        dt Motivo de la consulta
                                                                        dd= appointment.reason
                                                            if appointment.history.length
                                                                section.appointment-dialog-history(
                                                                    aria-label="Historial de la cita"
                                                                )
                                                                    h3 Historial de la cita
                                                                    ol.appointment-history
                                                                        each event in appointment.history
                                                                            - const previousStart = event.previous_values?.start_at ? new Date(event.previous_values.start_at) : null;
                                                                            - const newStart = event.new_values?.start_at ? new Date(event.new_values.start_at) : null;
                                                                            li
                                                                                if event.event_type === "Cancelled"
                                                                                    span Cita cancelada; el registro y su historial se conservaron.
                                                                                else if previousStart && newStart
                                                                                    span= `Reprogramada de ${previousStart.toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short", timeZone: "America/Bogota" })} a ${newStart.toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short", timeZone: "America/Bogota" })}`
                                                                                else
                                                                                    span Fecha de reprogramación registrada
                                                        .appointment-dialog-footer
                                                            button.appointment-dialog-done(
                                                                type="button",
                                                                data-close-appointment-details
                                                            ) Listo
                                                    if canCancel
                                                        dialog.appointment-details-dialog.appointment-cancel-dialog(
                                                            id=`appointment-cancel-${appointment.id}`,
                                                            aria-labelledby=`appointment-cancel-title-${appointment.id}`
                                                        )
                                                            .appointment-dialog-header
                                                                div
                                                                    span.appointment-dialog-kicker Confirmación
                                                                    h2(
                                                                        id=`appointment-cancel-title-${appointment.id}`
                                                                    ) ¿Deseas cancelar esta cita?
                                                                    p= `${(appointment.specialty && appointment.specialty.name) || "Consulta médica"} · ${date.toLocaleString("es-CO", { dateStyle: "long", timeStyle: "short", timeZone: "America/Bogota" })}`
                                                                button.appointment-dialog-close(
                                                                    type="button",
                                                                    aria-label="Cerrar confirmación",
                                                                    data-close-cancel-dialog
                                                                ) ×
                                                            .appointment-dialog-body
                                                                p Esta acción conservará el registro de tu cita y liberará el horario.
                                                            .appointment-dialog-footer.appointment-cancel-actions
                                                                button.appointment-dialog-done(
                                                                    type="button",
                                                                    data-close-cancel-dialog
                                                                ) Volver
                                                                button.appointment-cancel-confirm(
                                                                    type="button",
                                                                    data-cancel-appointment=appointment.id
                                                                ) Sí, cancelar cita
                            p.appointment-empty(
                                hidden,
                                data-empty,
                                role="status",
                                aria-live="polite"
                            ) No encontramos citas con ese criterio.
                            .appointment-summary
                                span(data-summary, aria-live="polite")= `Mostrando ${appointments.length} de ${appointments.length} citas`
                        else
                            .appointment-no-results
                                strong Aún no tienes citas
                                p Aquí aparecerá el historial de tus citas médicas.
                                if previewAvailable
                                    a(href="/patient/appointments?preview=1") Ver ejemplo con citas ficticias
                    dialog#appointment-feedback.appointment-details-dialog.appointment-feedback-dialog(
                        aria-labelledby="appointment-feedback-title",
                        aria-live="polite"
                    )
                        .appointment-dialog-header
                            div
                                span.appointment-dialog-kicker SaludVital
                                h2#appointment-feedback-title
                                p(data-appointment-feedback-message)
                            button.appointment-dialog-close(
                                type="button",
                                aria-label="Cerrar mensaje",
                                data-close-feedback
                            ) ×
                        .appointment-dialog-footer
                            button.appointment-dialog-done(type="button", data-close-feedback) Entendido
        include partials/bottom-nav
