doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-agenda.css")
    body.sv-dashboard.doctor-home-page.patient-home-page
        .sv-layout
            include ./partials/sidebar.pug
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include ./partials/topbar.pug
                main.doctor-content.doctor-agenda-page(
                    data-doctor-agenda,
                    data-agenda-api-url="/api/doctor/agenda",
                    data-start-consultation-url="/api/doctor/appointments",
                    data-today-date=todayDate,
                    data-initial-view=initialView
                )
                    header.doctor-page-heading.doctor-agenda-heading
                        div
                            p.doctor-eyebrow Agenda médica
                            h1 Mi agenda
                            p Visualiza tus citas y el horario configurado para el día.
                    section.doctor-agenda-toolbar(aria-label="Navegación de fecha")
                        button.doctor-agenda-nav-button(
                            type="button",
                            aria-label="Ver el día anterior",
                            data-agenda-previous
                        )
                            svg(viewBox="0 0 24 24", aria-hidden="true")
                                path(d="m15 18-6-6 6-6")
                        label.doctor-agenda-date-label(for="doctor-agenda-date")
                            span.sr-only Selecciona una fecha para ver tu agenda
                            svg(viewBox="0 0 24 24", aria-hidden="true")
                                path(
                                    d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"
                                )
                            input#doctor-agenda-date(
                                type="date",
                                value=initialDate,
                                data-agenda-date
                            )
                        button.doctor-agenda-today(type="button", data-agenda-today) Hoy
                        button.doctor-agenda-nav-button(
                            type="button",
                            aria-label="Ver el día siguiente",
                            data-agenda-next
                        )
                            svg(viewBox="0 0 24 24", aria-hidden="true")
                                path(d="m9 18 6-6-6-6")
                        .doctor-agenda-view-switcher(role="group", aria-label="Vista de agenda")
                            button.doctor-agenda-view-button(
                                type="button",
                                data-agenda-view="day",
                                aria-pressed=String(initialView === "day")
                            ) Día
                            button.doctor-agenda-view-button(
                                type="button",
                                data-agenda-view="week",
                                aria-pressed=String(initialView === "week")
                            ) Semana
                            button.doctor-agenda-view-button(
                                type="button",
                                data-agenda-view="month",
                                aria-pressed=String(initialView === "month")
                            ) Mes
                    p.doctor-agenda-feedback(
                        role="status",
                        aria-live="polite",
                        data-agenda-feedback,
                        hidden
                    )
                    .doctor-agenda-layout
                        section.doctor-panel.doctor-agenda-calendar(
                            aria-labelledby="doctor-agenda-day-title",
                            aria-busy="true",
                            data-agenda-calendar
                        )
                            header.doctor-panel-heading
                                div
                                    p.doctor-eyebrow(data-agenda-eyebrow) Jornada
                                    h2#doctor-agenda-day-title(data-agenda-title) Cargando agenda…
                            .doctor-agenda-loading(data-agenda-loading)
                                span.doctor-agenda-spinner(aria-hidden="true")
                                span Cargando las citas y el horario del día…
                            .doctor-agenda-timeline(data-agenda-timeline, hidden)
                            .doctor-agenda-empty(data-agenda-empty, hidden)
                                span.doctor-agenda-empty-icon(aria-hidden="true")
                                    svg(viewBox="0 0 24 24")
                                        path(
                                            d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"
                                        )
                                h3(data-agenda-empty-title) No hay actividad para esta fecha
                                p(data-agenda-empty-message) No encontramos citas ni horarios configurados.
                            .doctor-agenda-period-view.doctor-agenda-week-view(
                                data-agenda-week-view,
                                hidden
                            )
                                h3.doctor-agenda-period-title(data-agenda-week-title)
                                .doctor-agenda-week-grid(data-agenda-week-grid)
                            .doctor-agenda-period-view.doctor-agenda-month-view(
                                data-agenda-month-view,
                                hidden
                            )
                                h3.doctor-agenda-period-title(data-agenda-month-title)
                                .doctor-agenda-month-grid(data-agenda-month-grid)
                                p.doctor-agenda-month-empty(data-agenda-month-empty, hidden)
                                    | No hay citas confirmadas para este mes.
                        aside.doctor-agenda-aside(
                            aria-label="Horario y excepciones",
                            data-agenda-aside
                        )
                            section.doctor-panel.doctor-agenda-next-card(
                                aria-labelledby="doctor-agenda-next-title"
                            )
                                header.doctor-panel-heading
                                    div
                                        p.doctor-eyebrow Siguiente en tu agenda
                                        h2#doctor-agenda-next-title Próxima cita
                                    a.doctor-agenda-view-all(href="/doctor/appointments") Ver todas
                                .doctor-agenda-next-content(
                                    data-agenda-next-appointment,
                                    aria-live="polite"
                                )
                                    p.doctor-agenda-aside-loading Cargando próxima cita…
                            .doctor-agenda-day-details(data-agenda-day-details)
                                section.doctor-panel.doctor-agenda-detail-card
                                    header.doctor-panel-heading
                                        div
                                            p.doctor-eyebrow Organización del día
                                            h2 Horario de trabajo
                                    ul.doctor-agenda-period-list(data-agenda-periods)
                                        li.doctor-agenda-aside-loading Cargando horario…
                                section.doctor-panel.doctor-agenda-detail-card
                                    header.doctor-panel-heading
                                        div
                                            p.doctor-eyebrow Cambios de horario
                                            h2 Excepciones del día
                                    ul.doctor-agenda-exception-list(data-agenda-exceptions)
                                        li.doctor-agenda-aside-loading Cargando excepciones…
                include ./partials/start-consultation-dialog.pug
                include ./partials/bottom-nav.pug
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/doctor-agenda.js", defer)
        script(src="/js/doctor-consultation-start.js", defer)
