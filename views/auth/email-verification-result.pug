doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="robots", content="noindex, nofollow")
        meta(name="theme-color", content="#123B73")
        title Verificación de correo | SaludVital
        link(rel="stylesheet", href="/css/app.css")

    body.min-h-screen.bg-slate-50.text-slate-800.antialiased
        //- Decorative background and main page layout.
        .relative.flex.min-h-screen.items-center.justify-center.overflow-hidden.px-4.py-10(class="sm:px-6")
            .pointer-events-none.absolute.-left-24.-top-24.h-72.w-72.rounded-full.blur-3xl(
                class="bg-[#13B8B0]/10",
                aria-hidden="true"
            )
            .pointer-events-none.absolute.-bottom-24.-right-24.h-80.w-80.rounded-full.blur-3xl(
                class="bg-[#168DE2]/10",
                aria-hidden="true"
            )

            main.relative.w-full.max-w-lg
                //- Brand header.
                .mb-7.flex.items-center.justify-center.gap-3
                    .flex.h-12.w-12.items-center.justify-center.rounded-2xl.text-white.shadow-lg(
                        class="bg-[#123B73] shadow-[#123B73]/20",
                        aria-hidden="true"
                    )
                        svg.h-7.w-7(
                            viewBox="0 0 24 24",
                            fill="none",
                            stroke="currentColor",
                            stroke-width="1.8",
                            stroke-linecap="round",
                            stroke-linejoin="round"
                        )
                            path(d="M12 21s8-4 8-11V5l-8-3-8 3v5c0 7 8 11 8 11Z")
                            path(d="m9 12 2 2 4-4")
                    .text-left
                        p.text-xl.font-extrabold.tracking-tight(class="text-[#123B73]") SaludVital
                        p.text-xs.font-medium.tracking-wide.text-slate-500 Cuidamos de ti

                //- Verification result card.
                section.overflow-hidden.rounded-3xl.border.bg-white.shadow-xl(
                    class="border-slate-200/80 shadow-slate-900/5"
                )
                    .bg-gradient-to-r(
                        class="h-1.5 from-[#123B73] via-[#168DE2] to-[#13B8B0]",
                        aria-hidden="true"
                    )

                    .px-6.py-9.text-center(class="sm:px-10 sm:py-11")
                        if verified
                            //- Success state.
                            .mx-auto.mb-6.flex.h-20.w-20.items-center.justify-center.rounded-full.ring-8(
                                class="bg-[#13B8B0]/10 ring-[#13B8B0]/5",
                                aria-hidden="true"
                            )
                                svg.h-10.w-10(
                                    class="text-[#13B8B0]",
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="2",
                                    stroke-linecap="round",
                                    stroke-linejoin="round"
                                )
                                    path(d="m5 12 4 4L19 6")

                            span.mb-4.inline-flex.items-center.rounded-full.px-3.py-1.text-xs.font-bold.uppercase.tracking-wider(
                                class="bg-[#13B8B0]/10 text-[#0D827C]"
                            )
                                | Verificación completada

                            h1.mb-3.text-2xl.font-extrabold.tracking-tight(
                                class="text-[#123B73] sm:text-3xl"
                            )
                                | ¡Tu correo está verificado!

                            p.mx-auto.mb-8.max-w-sm.text-sm.leading-7.text-slate-600(class="sm:text-base")
                                | Tu dirección de correo electrónico ha sido confirmada correctamente. Tu cuenta está un paso más cerca de estar lista para que continúes.

                            a.inline-flex.min-h-12.w-full.items-center.justify-center.gap-2.rounded-xl.px-6.py-3.text-sm.font-bold.text-white.shadow-lg.transition.duration-200(
                                href="/login",
                                class="bg-[#123B73] shadow-[#123B73]/20 hover:-translate-y-0.5 hover:bg-[#0D2E5A] hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#168DE2] sm:text-base"
                            )
                                | Ir al inicio de sesión
                                svg.h-5.w-5(
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="2",
                                    stroke-linecap="round",
                                    stroke-linejoin="round",
                                    aria-hidden="true"
                                )
                                    path(d="M5 12h14")
                                    path(d="m12 5 7 7-7 7")

                        else
                            //- Error state.
                            .mx-auto.mb-6.flex.h-20.w-20.items-center.justify-center.rounded-full.bg-amber-50.ring-8(
                                class="ring-amber-50/70",
                                aria-hidden="true"
                            )
                                svg.h-10.w-10.text-amber-600(
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="1.8",
                                    stroke-linecap="round",
                                    stroke-linejoin="round"
                                )
                                    circle(cx="12", cy="12", r="9")
                                    path(d="M12 8v4")
                                    path(d="M12 16h.01")

                            span.mb-4.inline-flex.items-center.rounded-full.bg-amber-50.px-3.py-1.text-xs.font-bold.uppercase.tracking-wider.text-amber-700
                                | Verificación pendiente

                            h1.mb-3.text-2xl.font-extrabold.tracking-tight(
                                class="text-[#123B73] sm:text-3xl"
                            )
                                | No pudimos verificar tu correo

                            p.mx-auto.mb-8.max-w-sm.text-sm.leading-7.text-slate-600(class="sm:text-base")
                                | El enlace puede haber caducado, ser inválido o haber sido utilizado anteriormente. Puedes volver a intentarlo solicitando un nuevo enlace de verificación.

                            a.inline-flex.min-h-12.w-full.items-center.justify-center.gap-2.rounded-xl.border.bg-white.px-6.py-3.text-sm.font-bold.transition.duration-200(
                                href="/login",
                                class="border-[#168DE2]/30 text-[#123B73] hover:border-[#168DE2] hover:bg-[#168DE2]/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#168DE2] sm:text-base"
                            )
                                svg.h-5.w-5(
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="1.8",
                                    stroke-linecap="round",
                                    stroke-linejoin="round",
                                    aria-hidden="true"
                                )
                                    path(d="m15 18-6-6 6-6")
                                    path(d="M9 12h12")
                                | Volver al inicio de sesión

                    //- Card footer.
                    .border-t.border-slate-100.px-6.py-4.text-center(class="bg-slate-50/80")
                        p.text-xs.leading-5.text-slate-500
                            | ¿Necesitas ayuda?
                            span.font-semibold(class="text-[#123B73]") Contacta con nuestro equipo de soporte.

                //- Security and copyright information.
                footer.mt-6.space-y-2.text-center
                    p.flex.items-center.justify-center.text-xs.text-slate-500(class="gap-1.5")
                        svg.h-4.w-4(
                            class="text-[#13B8B0]",
                            viewBox="0 0 24 24",
                            fill="none",
                            stroke="currentColor",
                            stroke-width="1.8",
                            stroke-linecap="round",
                            stroke-linejoin="round",
                            aria-hidden="true"
                        )
                            rect(x="4", y="10", width="16", height="11", rx="2")
                            path(d="M8 10V7a4 4 0 0 1 8 0v3")
                        | Tu información se trata de forma segura.
                    p.text-xs.text-slate-400
                        | © 2026 SaludVital. Todos los derechos reservados.
