doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f2faff")
        title= pageTitle || "Panel del paciente | SaludVital"
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-appointments.css")
    body.sv-dashboard.patient-home-page
        .sv-layout
            include partials/sidebar
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include partials/topbar
                main.sv-content
                    section.sv-hero(aria-labelledby="hero-title")
                        .sv-hero-copy
                            h2#hero-title Tu salud,<br><span>en buenas manos</span>
                            p Agenda, consulta y gestiona tus citas médicas de forma fácil, rápida y segura.
                    section.sv-actions(aria-label="Accesos rápidos")
                        a.sv-action-card(href="/patient/appointments/new")
                            span.sv-action-icon.action-green
                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                    path(
                                        d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm7 7v6m-3-3h6"
                                    )
                            span.sv-action-arrow(aria-hidden="true") →
                            strong Pedir cita
                            small Agenda una nueva cita médica.
                        a.sv-action-card(href="/patient/appointments")
                            span.sv-action-icon.action-blue
                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                    path(
                                        d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h2m3 0h2m-7 4h2m3 0h2"
                                    )
                            span.sv-action-arrow(aria-hidden="true") →
                            strong Mis citas
                            small Consulta todas tus citas.
                        a.sv-action-card(href="/patient/appointments/reschedule")
                            span.sv-action-icon.action-purple
                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                    path(
                                        d="M20 7v5h-5M4 17v-5h5m10-2a7 7 0 0 0-12-3L4 9m16 6-3 2a7 7 0 0 1-12-3m7-3v4l2 1"
                                    )
                            span.sv-action-arrow(aria-hidden="true") →
                            strong Reprogramar cita
                            small Cambia la fecha de tu cita.
                        a.sv-action-card(href="/patient/notifications")
                            span.sv-action-icon.action-teal
                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                    path(
                                        d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 12h4"
                                    )
                            span.sv-action-arrow(aria-hidden="true") →
                            strong Notificaciones
                            small Activa o configura tus avisos.
                    .sv-panels
                        .sv-panel-column
                            section.sv-panel.sv-appointment(
                                aria-labelledby="next-appointment-title"
                            )
                                .sv-panel-heading
                                    h2#next-appointment-title Próxima cita
                                    a(href="/patient/appointments") Ver todas
                                if nextAppointment
                                    - const appointmentDate = new Date(nextAppointment.start_at);
                                    - const appointmentStatus = nextAppointment.status.name;
                                    - const appointmentStatusClass = appointmentStatus === "In Progress" ? "in-progress" : appointmentStatus.toLowerCase();
                                    - const appointmentStatusLabel = appointmentStatus === "In Progress" ? "En curso" : "Confirmada";
                                    - const appointmentId = nextAppointment.id;
                                    .sv-appointment-content
                                        .sv-date-tile
                                            strong= appointmentDate.toLocaleDateString("es-CO", { day: "2-digit", timeZone: "America/Bogota" })
                                            span= appointmentDate.toLocaleDateString("es-CO", { month: "short", year: "numeric", timeZone: "America/Bogota" })
                                        .sv-appointment-info
                                            p
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(
                                                        d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9v-2a7 7 0 0 1 14 0v2Z"
                                                    )
                                                strong= nextAppointment.specialty.name
                                            p
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(
                                                        d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 21a7 7 0 0 1 14 0"
                                                    )
                                                span= nextAppointment.doctor_label
                                            p
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(
                                                        d="M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                                                    )
                                                span= appointmentDate.toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: "America/Bogota" })
                                            p
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(
                                                        d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Zm-5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                                    )
                                                span= nextAppointment.site_label
                                        span.sv-status(class="status-" + appointmentStatusClass)= appointmentStatusLabel
                                    .sv-appointment-buttons
                                        button.sv-button-outline.appointment-detail-toggle(
                                            type="button",
                                            aria-haspopup="dialog",
                                            aria-controls="appointment-details-" + appointmentId,
                                            data-open-appointment-details=appointmentId
                                        ) Ver detalles
                                        if nextAppointment.can_reschedule
                                            a.sv-button-primary(
                                                href=`/patient/appointments/reschedule?appointmentId=${appointmentId}`
                                            )
                                                span.sv-button-wide Reprogramar cita
                                                span.sv-button-short Reprogramar
                                        else
                                            button.sv-button-primary(
                                                type="button",
                                                aria-haspopup="dialog",
                                                aria-controls="reschedule-unavailable-" + appointmentId,
                                                data-open-reschedule-unavailable=appointmentId
                                            )
                                                span.sv-button-wide Reprogramar cita
                                                span.sv-button-short Reprogramar
                                    dialog.appointment-details-dialog(
                                        id="appointment-details-" + appointmentId,
                                        aria-labelledby="appointment-details-title-" + appointmentId
                                    )
                                        .appointment-dialog-header
                                            div
                                                span.appointment-dialog-kicker Detalles de tu cita
                                                h2(id="appointment-details-title-" + appointmentId)= nextAppointment.specialty.name
                                                .appointment-dialog-doctor
                                                    if nextAppointment.doctor && nextAppointment.doctor.profile_photo_url
                                                        img.appointment-dialog-doctor-photo(
                                                            src=nextAppointment.doctor.profile_photo_url,
                                                            alt="Foto de " + nextAppointment.doctor_label,
                                                            loading="lazy"
                                                        )
                                                    else
                                                        span.appointment-dialog-doctor-avatar(aria-hidden="true")= nextAppointment.doctor_label.split(" ").slice(0, 2).map((part) => part[0]).join("")
                                                    p= nextAppointment.doctor_label
                                            button.appointment-dialog-close(
                                                type="button",
                                                aria-label="Cerrar detalles",
                                                data-close-appointment-details
                                            ) ×
                                        .appointment-dialog-body
                                            .appointment-dialog-status
                                                span Estado actual
                                                span.appointment-status(
                                                    class="status-" + appointmentStatusClass
                                                )= appointmentStatusLabel
                                            dl.appointment-detail-list
                                                div
                                                    dt Fecha y hora
                                                    dd= appointmentDate.toLocaleString("es-CO", { dateStyle: "long", timeStyle: "short", timeZone: "America/Bogota" })
                                                div
                                                    dt Centro de atención
                                                    dd= nextAppointment.site_label
                                                if nextAppointment.reason
                                                    div
                                                        dt Motivo de la consulta
                                                        dd= nextAppointment.reason
                                            if nextAppointment.history.length
                                                section.appointment-dialog-history(
                                                    aria-label="Historial de la cita"
                                                )
                                                    h3 Historial de la cita
                                                    ol.appointment-history
                                                        each event in nextAppointment.history
                                                            - const previousStart = event.previous_values?.start_at ? new Date(event.previous_values.start_at) : null;
                                                            - const newStart = event.new_values?.start_at ? new Date(event.new_values.start_at) : null;
                                                            li
                                                                if previousStart && newStart
                                                                    span= `Reprogramada de ${previousStart.toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short", timeZone: "America/Bogota" })} a ${newStart.toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short", timeZone: "America/Bogota" })}`
                                                                else
                                                                    span Fecha de reprogramación registrada
                                        .appointment-dialog-footer
                                            button.appointment-dialog-done(
                                                type="button",
                                                data-close-appointment-details
                                            ) Listo
                                    unless nextAppointment.can_reschedule
                                        dialog.appointment-details-dialog(
                                            id="reschedule-unavailable-" + appointmentId,
                                            aria-labelledby="reschedule-unavailable-title-" + appointmentId
                                        )
                                            .appointment-dialog-header
                                                div
                                                    span.appointment-dialog-kicker Reprogramación no disponible
                                                    h2(
                                                        id="reschedule-unavailable-title-" + appointmentId
                                                    ) No puedes reprogramar esta cita
                                                button.appointment-dialog-close(
                                                    type="button",
                                                    aria-label="Cerrar mensaje",
                                                    data-close-appointment-details
                                                ) ×
                                            .appointment-dialog-body
                                                p= nextAppointment.reschedule_unavailable_reason
                                            .appointment-dialog-footer
                                                button.appointment-dialog-done(
                                                    type="button",
                                                    data-close-appointment-details
                                                ) Entendido
                                else
                                    .sv-appointment-empty
                                        strong No tienes citas próximas
                                        p Cuando tengas una cita confirmada, aquí verás sus detalles.
                                        a.sv-button-primary(href="/patient/appointments/new") Pedir una cita
                            section.sv-panel.sv-history(aria-labelledby="history-title")
                                .sv-panel-heading
                                    h2#history-title Mis últimas citas
                                    a(href="/patient/appointments") Ver todas
                                .sv-table-wrap
                                    table
                                        thead
                                            tr
                                                th Fecha
                                                th Especialidad
                                                th Médico
                                                th Estado
                                        tbody
                                            tr
                                                td 15 Oct 2026
                                                td Medicina General
                                                td Dr. Carlos Ramírez
                                                td
                                                    span.sv-status Confirmada
                                            tr
                                                td 03 Sep 2026
                                                td Dermatología
                                                td Dra. Ana Torres
                                                td
                                                    span.sv-status.status-blue Asistida
                                            tr
                                                td 12 Ago 2026
                                                td Oftalmología
                                                td Dr. Luis Gómez
                                                td
                                                    span.sv-status.status-red Cancelada
                        .sv-panel-column
                            section.sv-panel.sv-notifications(
                                aria-labelledby="notifications-title"
                            )
                                .sv-panel-heading
                                    h2#notifications-title Notificaciones
                                    a(href="/patient/notifications")
                                        | ⚙
                                        span Configurar
                                .sv-preference
                                    span.sv-preference-icon.pref-green(aria-hidden="true") WhatsApp
                                    span
                                        strong Notificaciones por WhatsApp
                                        small Recibe confirmaciones, recordatorios y novedades.
                                    span.sv-toggle(aria-label="Activadas")
                                .sv-preference
                                    span.sv-preference-icon.pref-blue(aria-hidden="true") SMS
                                    span
                                        strong Notificaciones por SMS
                                        small Recibe recordatorios de tus citas.
                                    span.sv-toggle(aria-label="Activadas")
                                .sv-preference
                                    span.sv-preference-icon.pref-purple(aria-hidden="true") Correo
                                    span
                                        strong Notificaciones por correo electrónico
                                        small Recibe confirmaciones y actualizaciones.
                                    span.sv-toggle(aria-label="Activadas")
                            section.sv-panel.sv-profile(aria-labelledby="profile-title")
                                .sv-panel-heading
                                    h2#profile-title Mi perfil
                                    a(href="/patient/profile") Editar
                                .sv-profile-content
                                    .sv-profile-details
                                        p
                                            | ♙
                                            span Juan Esteban Montoya Marín
                                        p
                                            | ▣
                                            span CC 1.234.567.890
                                        p
                                            | ✉
                                            span juan.montoya@gmail.com
                                        p
                                            | ▯
                                            span +57 310 123 4567
                                        p
                                            | ⌖
                                            span Dosquebradas, Risaralda
                                    .sv-profile-person
                                        span(aria-hidden="true") JM
                                        small Paciente
                    form.sv-mobile-logout(action="/logout", method="POST")
                        button(type="submit") Cerrar sesión
                include partials/bottom-nav
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/patient-appointments.js", defer)
