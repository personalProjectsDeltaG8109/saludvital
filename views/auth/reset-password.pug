doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.recovery-page.text-primary.antialiased
        main.recovery-layout
            include ./partials/recovery-visual

            section.recovery-panel(aria-labelledby="reset-title")
                include ./partials/recovery-mobile-hero

                article.recovery-card.recovery-card-reset
                    img.recovery-card-logo(
                        src="/brand/login/logo-login-mobile.png",
                        alt="SaludVital",
                        width="240",
                        height="80"
                    )

                    //- This reserved artwork area can be replaced with the supplied reset illustration.
                    .recovery-art-slot.recovery-art-slot-compact(
                        data-image-slot="reset-password",
                        aria-hidden="true"
                    )
                        svg(viewBox="0 0 96 96", fill="none")
                            path(
                                d="M28 42V31a20 20 0 0 1 40 0v11",
                                stroke="currentColor",
                                stroke-width="7",
                                stroke-linecap="round"
                            )
                            rect(
                                x="18",
                                y="40",
                                width="60",
                                height="46",
                                rx="10",
                                fill="currentColor"
                            )
                            path(
                                d="m40 63 6 6 12-14",
                                stroke="white",
                                stroke-width="5",
                                stroke-linecap="round",
                                stroke-linejoin="round"
                            )
                    h1#reset-title Crea tu nueva contraseña
                    p.recovery-description Ingresa una nueva contraseña segura para continuar con tu cuenta.

                    if error
                        p.recovery-error(role="alert")= error

                    if success
                        p.recovery-success(role="status")= success
                        a.recovery-primary-action(href="/login") Ir a iniciar sesión
                    else
                        form.recovery-form(action="/reset-password", method="POST")
                            input(type="hidden", name="token", value=token)

                            div
                                label(for="password") Nueva contraseña
                                .recovery-password-field
                                    svg(
                                        aria-hidden="true",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8"
                                    )
                                        rect(x="4", y="10", width="16", height="11", rx="2")
                                        path(d="M8 10V7a4 4 0 0 1 8 0v3")
                                    input#password(
                                        type="password",
                                        name="password",
                                        autocomplete="new-password",
                                        minlength="10",
                                        maxlength="50",
                                        placeholder="Ingresa tu nueva contraseña",
                                        required
                                    )
                                    button.recovery-password-toggle(
                                        type="button",
                                        data-password-toggle="#password",
                                        aria-label="Mostrar contraseña",
                                        aria-pressed="false"
                                    )
                                        svg(
                                            aria-hidden="true",
                                            viewBox="0 0 24 24",
                                            fill="none",
                                            stroke="currentColor",
                                            stroke-width="1.8"
                                        )
                                            path(
                                                d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"
                                            )
                                            circle(cx="12", cy="12", r="3")
                                        span.sr-only(data-password-toggle-label) Mostrar contraseña

                            .recovery-password-guidance(aria-label="Requisitos de la contraseña")
                                strong Tu contraseña debe contener:
                                ul
                                    li Entre 10 y 50 caracteres.
                                    li Una letra mayúscula y al menos tres minúsculas.
                                    li Un número y un carácter especial.

                            div
                                label(for="password_confirmation") Confirmar nueva contraseña
                                .recovery-password-field
                                    svg(
                                        aria-hidden="true",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8"
                                    )
                                        rect(x="4", y="10", width="16", height="11", rx="2")
                                        path(d="M8 10V7a4 4 0 0 1 8 0v3")
                                    input#password_confirmation(
                                        type="password",
                                        name="password_confirmation",
                                        autocomplete="new-password",
                                        minlength="10",
                                        maxlength="50",
                                        placeholder="Confirma tu nueva contraseña",
                                        required
                                    )
                                    button.recovery-password-toggle(
                                        type="button",
                                        data-password-toggle="#password_confirmation",
                                        aria-label="Mostrar contraseña",
                                        aria-pressed="false"
                                    )
                                        svg(
                                            aria-hidden="true",
                                            viewBox="0 0 24 24",
                                            fill="none",
                                            stroke="currentColor",
                                            stroke-width="1.8"
                                        )
                                            path(
                                                d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"
                                            )
                                            circle(cx="12", cy="12", r="3")
                                        span.sr-only(data-password-toggle-label) Mostrar contraseña

                            button.recovery-primary-action(type="submit")
                                | Cambiar contraseña
                                span(aria-hidden="true") →
                            a.recovery-back-link(href="/login") ← Volver al inicio de sesión

                    include ./partials/recovery-whatsapp

        script(src="/js/login.js", defer)
