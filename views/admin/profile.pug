doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#063f79")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-profile.css")
    body.admin-app.admin-profile-page
        include partials/admin-shell.pug
        +adminSidebar("profile")
        .admin-main-shell
            +adminTopbar("/admin/dashboard", "Buscar personas, citas, médicos o secciones...")
            main.admin-profile-content(data-admin-profile, data-endpoint="/api/admin/profile")
                header.admin-profile-heading
                    .admin-profile-heading-icon(aria-hidden="true")
                        svg(
                            viewBox="0 0 24 24",
                            fill="none",
                            stroke="currentColor",
                            stroke-width="1.8",
                            stroke-linecap="round",
                            stroke-linejoin="round"
                        )
                            circle(cx="12", cy="8", r="3.5")
                            path(d="M5 21v-1.5a7 7 0 0 1 14 0V21")
                    div
                        p.admin-eyebrow Perfil de cuenta
                        h1 Mi perfil
                        p Gestiona y consulta la información asociada a tu cuenta.

                section.admin-profile-hero(aria-labelledby="admin-profile-name")
                    .admin-profile-avatar-wrap
                        .admin-profile-avatar(
                            aria-hidden="true",
                            data-profile-avatar,
                            data-profile-avatar-initials=profile.initials
                        )
                            if profile.profilePhotoUrl
                                img(src=profile.profilePhotoUrl, alt="", data-profile-avatar-image)
                                span(data-profile-initials, hidden)= profile.initials
                            else
                                span(data-profile-initials)= profile.initials
                        button.admin-profile-photo-trigger(
                            type="button",
                            aria-label="Opciones de foto de perfil",
                            aria-haspopup="dialog",
                            aria-expanded="false",
                            aria-controls="admin-profile-photo-dialog",
                            data-profile-photo-open
                        )
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8",
                                stroke-linecap="round",
                                stroke-linejoin="round",
                                aria-hidden="true"
                            )
                                path(d="M4 7h3l2-2h6l2 2h3v12H4z")
                                circle(cx="12", cy="13", r="3")
                        input#admin-profile-photo-input(
                            type="file",
                            accept="image/jpeg,image/png,image/webp",
                            hidden,
                            data-profile-photo-input
                        )
                        dialog#admin-profile-photo-dialog.admin-profile-photo-dialog(
                            aria-labelledby="admin-profile-photo-title",
                            data-profile-photo-dialog
                        )
                            h2#admin-profile-photo-title Foto de perfil
                            p.admin-profile-photo-feedback(
                                role="status",
                                aria-live="polite",
                                data-photo-status
                            )
                            p.admin-profile-photo-error(
                                role="alert",
                                aria-live="assertive",
                                data-photo-error,
                                hidden
                            )
                            .admin-profile-photo-actions(data-photo-actions)
                                button.admin-profile-photo-action(type="button", data-photo-upload) Subir o cambiar foto
                                button.admin-profile-photo-action.is-danger(
                                    type="button",
                                    hidden=!profile.profilePhotoUrl,
                                    data-photo-remove
                                ) Eliminar foto
                                button.admin-profile-photo-action(type="button", data-photo-close) Cancelar
                            .admin-profile-photo-preview(data-photo-preview-container, hidden)
                                img(
                                    alt="Vista previa de la nueva foto de perfil",
                                    data-photo-preview
                                )
                                .admin-profile-photo-preview-actions
                                    button.admin-profile-photo-action(
                                        type="button",
                                        data-photo-preview-cancel
                                    ) Cancelar
                                    button.admin-profile-photo-action.is-primary(
                                        type="button",
                                        data-photo-save
                                    ) Guardar foto
                    .admin-profile-identity
                        h2#admin-profile-name(data-profile-identity-name)= profile.displayName || "Nombre no registrado"
                        p(data-profile-identity-email)= profile.email
                        span.admin-profile-role= profile.role === "Administrator" ? "Administrador" : profile.role
                        p.admin-profile-photo-page-feedback(
                            role="status",
                            aria-live="polite",
                            data-photo-page-feedback,
                            hidden
                        )

                nav.admin-profile-tabs(role="tablist", aria-label="Secciones del perfil")
                    button#personal-information-tab.admin-profile-tab(
                        type="button",
                        role="tab",
                        aria-selected="true",
                        aria-controls="personal-information",
                        tabindex="0",
                        data-profile-tab="personal"
                    )
                        span.admin-profile-tab-icon(aria-hidden="true")
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8"
                            )
                                circle(cx="12", cy="8", r="3.5")
                                path(d="M5 20c.7-3.3 3.1-5 7-5s6.3 1.7 7 5")
                        span Información personal
                    button#security-information-tab.admin-profile-tab(
                        type="button",
                        role="tab",
                        aria-selected="false",
                        aria-controls="security-information",
                        tabindex="-1",
                        data-profile-tab="security"
                    )
                        span.admin-profile-tab-icon(aria-hidden="true")
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8"
                            )
                                rect(x="5", y="10", width="14", height="11", rx="2")
                                path(d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3")
                        span Seguridad
                    button#profile-preferences-tab.admin-profile-tab(
                        type="button",
                        role="tab",
                        aria-selected="false",
                        aria-controls="profile-preferences",
                        tabindex="-1",
                        data-profile-tab="preferences"
                    )
                        span.admin-profile-tab-icon(aria-hidden="true")
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8"
                            )
                                path(
                                    d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4m0-12.8L17 7M7 17l-1.4 1.4"
                                )
                                circle(cx="12", cy="12", r="5")
                        span Preferencias

                #personal-information.admin-profile-grid.admin-profile-panel(
                    role="tabpanel",
                    aria-labelledby="personal-information-tab",
                    tabindex="0",
                    data-profile-panel="personal"
                )
                    section.admin-profile-card(aria-labelledby="personal-information-title")
                        header.admin-profile-card-heading
                            h2#personal-information-title Datos personales
                            button.admin-profile-edit-button(
                                type="button",
                                aria-expanded="false",
                                aria-controls="profile-edit-form",
                                data-profile-edit
                            ) Editar
                        p.admin-profile-feedback(
                            role="status",
                            aria-live="polite",
                            data-profile-success,
                            hidden
                        )
                        p.admin-profile-error(
                            role="alert",
                            aria-live="assertive",
                            data-profile-error,
                            hidden
                        )
                        dl.admin-profile-fields(data-profile-readonly)
                            .admin-profile-field
                                dt Nombre completo
                                dd(data-profile-value="displayName")= profile.displayName || "Nombre no registrado"
                            .admin-profile-field
                                dt Correo electrónico
                                dd(data-profile-value="email")= profile.email
                            .admin-profile-field
                                dt Teléfono
                                dd(data-profile-value="phone")= profile.phone || "Sin información registrada"
                            .admin-profile-field
                                dt Rol
                                dd= profile.role === "Administrator" ? "Administrador" : profile.role
                            .admin-profile-field
                                dt Estado de la cuenta
                                dd
                                    span.admin-profile-status(
                                        class=profile.isActive ? "is-active" : "is-inactive"
                                    )
                                        = profile.isActive ? "Activa" : "Inactiva"

                        form#profile-edit-form.admin-profile-form(data-profile-form, hidden)
                            label.admin-profile-input-field(for="profile-display-name") Nombre completo
                            input#profile-display-name(
                                type="text",
                                name="displayName",
                                maxlength="120",
                                autocomplete="name",
                                required,
                                value=profile.displayName || "",
                                data-profile-display-name
                            )
                            label.admin-profile-input-field(for="profile-email") Correo electrónico
                            input#profile-email(
                                type="email",
                                name="email",
                                maxlength="100",
                                autocomplete="email",
                                required,
                                value=profile.email,
                                aria-describedby="profile-email-help",
                                data-profile-email
                            )
                            p#profile-email-help.admin-profile-field-help Si cambias el correo, tendrás que verificar la nueva dirección.
                            label.admin-profile-input-field(for="profile-phone") Teléfono
                            input#profile-phone(
                                type="tel",
                                name="phone",
                                maxlength="20",
                                autocomplete="tel",
                                pattern="\\+?[0-9]{7,15}",
                                value=profile.phone || "",
                                aria-describedby="profile-phone-help",
                                data-profile-phone
                            )
                            p#profile-phone-help.admin-profile-field-help Usa de 7 a 15 dígitos; puedes incluir + al inicio.
                            .admin-profile-form-actions
                                button.admin-profile-cancel-button(
                                    type="button",
                                    data-profile-cancel
                                ) Cancelar
                                button.admin-profile-save-button(type="submit", data-profile-save) Guardar cambios

                    section.admin-profile-card(aria-labelledby="additional-information-title")
                        h2#additional-information-title Información adicional
                        dl.admin-profile-fields
                            .admin-profile-field
                                dt Fecha de registro
                                dd= profile.createdAt ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeZone: "America/Bogota" }).format(new Date(profile.createdAt)) : "Sin información registrada"
                            .admin-profile-field
                                dt Último acceso
                                dd= profile.lastLoginAt ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Bogota" }).format(new Date(profile.lastLoginAt)) : "Sin información registrada"
                            .admin-profile-field
                                dt Última actualización de la cuenta
                                dd= profile.updatedAt ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Bogota" }).format(new Date(profile.updatedAt)) : "Sin información registrada"

                section#security-information.admin-profile-note(
                    aria-labelledby="security-information-title",
                    role="tabpanel",
                    tabindex="0",
                    data-profile-panel="security",
                    hidden
                )
                    header.admin-profile-panel-heading
                        .admin-profile-panel-title
                            .admin-profile-panel-icon.security(aria-hidden="true")
                                svg(
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="1.8"
                                )
                                    path(d="M12 3 19 6v5c0 4.8-2.8 8-7 10-4.2-2-7-5.2-7-10V6l7-3Z")
                                    path(d="m9 12 2 2 4-4")
                            div
                                h2#security-information-title Seguridad de la cuenta
                                p Revisa el acceso y las opciones de recuperación de tu cuenta.
                        span.admin-profile-status(
                            class=profile.emailVerified ? "is-active" : "is-inactive"
                        )= profile.emailVerified ? "Correo verificado" : "Verificación pendiente"
                    if profile.emailVerified && profile.emailVerifiedAt
                        .admin-profile-field.admin-profile-verification-date
                            dt Correo verificado el
                            dd= new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Bogota" }).format(new Date(profile.emailVerifiedAt))
                    .admin-profile-security-card
                        .admin-profile-security-card-icon(aria-hidden="true")
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8"
                            )
                                rect(x="5", y="10", width="14", height="11", rx="2")
                                path(d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3")
                        .admin-profile-security-copy
                            h3 Recuperación de contraseña
                            if profile.emailVerified
                                p Usa el proceso seguro por correo electrónico para recuperar el acceso a tu cuenta.
                                a.admin-profile-action-link(href="/forgot-password")
                                    | Recuperar contraseña
                                    span(aria-hidden="true") →
                            else
                                p Confirma primero el correo electrónico de tu cuenta para habilitar la recuperación de contraseña.

                section#profile-preferences.admin-profile-note(
                    aria-labelledby="profile-preferences-title",
                    role="tabpanel",
                    tabindex="0",
                    data-profile-panel="preferences",
                    hidden
                )
                    header.admin-profile-panel-heading
                        .admin-profile-panel-title
                            .admin-profile-panel-icon.preferences(aria-hidden="true")
                                svg(
                                    viewBox="0 0 24 24",
                                    fill="none",
                                    stroke="currentColor",
                                    stroke-width="1.8"
                                )
                                    circle(cx="12", cy="12", r="8")
                                    path(d="M12 8v4l2.5 1.5")
                            div
                                h2#profile-preferences-title Preferencias de notificaciones
                                p Personaliza los avisos que ves en el panel administrativo.
                        span.admin-profile-preference-badge Configuración personal
                    .admin-profile-preference-card
                        .admin-profile-preference-copy
                            h3 Actividad de entrega
                            p Controla si aparecen en el panel los avisos recientes enviados a pacientes y su contador de fallos.
                    form.admin-profile-preference-form(
                        data-profile-preferences-form,
                        data-endpoint="/api/admin/profile/preferences"
                    )
                        label.admin-profile-preference-option(for="admin-notifications-enabled")
                            input#admin-notifications-enabled(
                                type="checkbox",
                                checked=profile.adminNotificationsEnabled,
                                data-admin-notifications-enabled
                            )
                            span Mostrar avisos recientes de entrega de citas a pacientes
                        p.admin-profile-field-help Esta opción solo cambia lo que ves en el panel. No modifica los envíos ni las métricas de monitoreo.
                        p.admin-profile-feedback(
                            role="status",
                            aria-live="polite",
                            data-preferences-success,
                            hidden
                        )
                        p.admin-profile-error(role="alert", data-preferences-error, hidden)
                        .admin-profile-form-actions
                            button.admin-profile-save-button(type="submit", data-preferences-save) Guardar preferencias

        script(src="/js/admin-dashboard.js", defer)
        script(src="/js/admin-profile.js", defer)
        script(src="/js/admin-profile-photo.js", defer)
        script(src="/js/admin-profile-preferences.js", defer)
