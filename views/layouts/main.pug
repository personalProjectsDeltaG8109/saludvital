doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="description", content="SaludVital appointment management platform")
        title= pageTitle
        link(rel="stylesheet", href="/css/app.css")
    body.min-h-screen.bg-background.text-primary.antialiased
        main.mx-auto.flex.min-h-screen.max-w-5xl.flex-col.items-center.justify-center.px-6.py-12.text-center
            //- Use the primary brand color to ensure sufficient text contrast.
            p.mb-3.text-sm.font-semibold.uppercase.text-primary(class="tracking-[0.2em]") Healthcare appointment management
            h1.text-4xl.font-bold.tracking-tight(class="sm:text-6xl") SaludVital
            p.mt-5.max-w-xl.text-lg.leading-8(class="text-primary/70") Your health, connected.
            //- Keep the wellness accent in the background and use primary for readable text.
            p.mt-8.rounded-full.px-4.py-2.text-sm.font-medium.text-primary(class="bg-wellness/10") Application foundation ready
