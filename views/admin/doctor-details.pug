mixin scheduleTimeList(intervals, isPrevious)
    ul.doctor-schedule-time-list(role="list")
        each interval in intervals
            li(class=isPrevious ? "doctor-schedule-time is-previous" : "doctor-schedule-time")
                svg(
                    aria-hidden="true",
                    viewBox="0 0 24 24",
                    fill="none",
                    stroke="currentColor",
                    stroke-width="1.8",
                    stroke-linecap="round",
                    stroke-linejoin="round"
                )
                    circle(cx="12", cy="12", r="9")
                    path(d="M12 7v5l3 2")
                span= interval.timeRange

doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#063f79")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-doctors.css")
    body.admin-app.admin-doctor-details-page
        include partials/admin-shell.pug
        +adminSidebar("doctors")
        .admin-main-shell
            +adminTopbar
            main.doctor-details-page(
                data-doctor-details,
                data-status-impact-endpoint="/api/admin/doctors",
                data-status-endpoint="/api/admin/doctors",
                data-review-endpoint="/api/admin/doctors/" + doctor.id + "/review"
            )
                a.doctors-back-link.doctor-details-back-link(href="/admin/doctors")
                    svg(
                        aria-hidden="true",
                        viewBox="0 0 24 24",
                        fill="none",
                        stroke="currentColor",
                        stroke-width="1.8",
                        stroke-linecap="round",
                        stroke-linejoin="round"
                    )
                        path(d="M19 12H5m7 7-7-7 7-7")
                    span Volver a médicos
                header.doctor-details-heading
                    div
                        p.admin-eyebrow Perfil profesional
                        h1 Información del médico
                        p Consulta los datos registrados y la configuración de horarios.
                section.doctor-details-hero(aria-labelledby="doctor-name")
                    .doctor-details-avatar
                        if doctor.profilePhotoUrl && doctor.profilePhotoUrl.startsWith("/uploads/profile-photos/")
                            img(src=doctor.profilePhotoUrl, alt="Foto de " + doctor.name)
                        else
                            span(aria-hidden="true")= doctor.name.trim().charAt(0).toUpperCase()
                    .doctor-details-identity
                        h2#doctor-name= doctor.name
                        p= doctor.specialty ? doctor.specialty.name : "Especialidad no asignada"
                        span.doctor-status(
                            class=doctor.isActive ? "is-active" : "is-inactive",
                            data-doctor-status-label
                        )
                            | #{ doctor.isActive ? "Activo" : "Inactivo" }
                        span.doctor-review-status(
                            class=doctor.profileReviewStatus === "approved" ? "is-approved" : doctor.profileReviewStatus === "pending" ? "is-pending" : doctor.profileReviewStatus === "changes_requested" ? "is-changes-requested" : "is-invited"
                        )
                            | #{ doctor.profileReviewStatus === "approved" ? "Perfil aprobado" : doctor.profileReviewStatus === "pending" ? "Perfil en revisión" : doctor.profileReviewStatus === "changes_requested" ? "Debe corregir el perfil" : "Invitación pendiente" }
                    if doctor.profileReviewStatus === "approved"
                        .doctor-details-actions
                            a.doctors-secondary-button.doctor-details-manage(
                                href="/admin/users?search=" + encodeURIComponent(doctor.email) + "&edit=" + doctor.userId
                            ) Editar médico
                            button.doctors-secondary-button.doctor-status-action(
                                type="button",
                                data-doctor-status-action,
                                data-doctor-id=doctor.id,
                                data-is-active=doctor.isActive
                            )= doctor.isActive ? "Desactivar médico" : "Activar médico"
                p.doctor-status-feedback(
                    role="status",
                    aria-live="polite",
                    data-doctor-status-feedback
                )
                if doctor.profileReviewStatus === "pending"
                    section.doctor-review-card(aria-labelledby="doctor-review-heading")
                        div
                            p.admin-eyebrow Revisión de acceso
                            h2#doctor-review-heading Revisar perfil del médico
                            p Verifica los datos antes de activar la cuenta.
                        .doctor-review-actions
                            button.doctors-primary-button(
                                type="button",
                                data-review-action="approve"
                            ) Aprobar y activar cuenta
                            button.doctors-secondary-button(
                                type="button",
                                data-review-open-corrections
                            ) Solicitar correcciones
                if doctor.profileReviewStatus === "changes_requested" && doctor.profileReviewNote
                    section.doctor-review-card.is-warning
                        div
                            p.admin-eyebrow Correcciones solicitadas
                            h2 Nota enviada al médico
                            p= doctor.profileReviewNote
                .doctor-details-grid
                    section.doctor-details-card(aria-labelledby="doctor-contact-heading")
                        h2#doctor-contact-heading Datos del perfil
                        dl.doctor-details-fields
                            if doctor.firstName || doctor.lastName
                                div
                                    dt Nombres y apellidos
                                    dd= [doctor.firstName, doctor.lastName].filter(Boolean).join(" ")
                            if doctor.documentType || doctor.documentNumber
                                div
                                    dt Documento
                                    dd= `${doctor.documentType || ""} ${doctor.documentNumber || ""}`.trim()
                            if doctor.professionalRegistrationNumber
                                div
                                    dt Tarjeta profesional
                                    dd= doctor.professionalRegistrationNumber
                            if doctor.phone
                                div
                                    dt Celular
                                    dd= doctor.phone
                            div
                                dt Correo electrónico
                                dd= doctor.email
                            div
                                dt Correo confirmado
                                dd= doctor.emailVerified ? "Sí" : "No"
                            div
                                dt Especialidad
                                dd= doctor.specialty ? doctor.specialty.name : "Sin especialidad"
                            div
                                dt Cuenta creada
                                dd= doctor.createdAt ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeZone: "America/Bogota" }).format(new Date(doctor.createdAt)) : "Sin registro"
                            div
                                dt Último acceso
                                dd= doctor.lastLoginAt ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Bogota" }).format(new Date(doctor.lastLoginAt)) : "Sin registro"
                    section.doctor-details-card.doctor-schedule-card(
                        aria-labelledby="doctor-schedule-heading"
                    )
                        .doctor-schedule-heading
                            div
                                h2#doctor-schedule-heading Horario configurado
                                p Los horarios se consultan desde la disponibilidad registrada.
                            span.doctor-status(class=doctor.hasSchedule ? "is-active" : "is-inactive")
                                | #{ doctor.hasSchedule ? "Configurado" : "Sin horario activo" }
                        ul.doctor-schedule-week(role="list", aria-label="Horario semanal vigente")
                            each day in doctor.currentSchedule
                                li.doctor-schedule-day
                                    .doctor-schedule-day-name
                                        svg(
                                            aria-hidden="true",
                                            viewBox="0 0 24 24",
                                            fill="none",
                                            stroke="currentColor",
                                            stroke-width="1.8",
                                            stroke-linecap="round",
                                            stroke-linejoin="round"
                                        )
                                            rect(x="3", y="5", width="18", height="16", rx="2")
                                            path(d="M16 3v4M8 3v4M3 10h18")
                                        strong= day.day
                                    if day.intervals.length
                                        +scheduleTimeList(day.intervals, false)
                                    else
                                        span.doctor-schedule-empty Sin horario activo
                        if doctor.upcomingSchedule.length
                            details.doctor-schedule-disclosure
                                summary.doctor-schedule-disclosure-summary
                                    span Próximos horarios programados
                                    svg(
                                        aria-hidden="true",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8",
                                        stroke-linecap="round",
                                        stroke-linejoin="round"
                                    )
                                        path(d="m6 9 6 6 6-6")
                                .doctor-schedule-period-groups
                                    each day in doctor.upcomingSchedule
                                        section.doctor-schedule-period-day(aria-label=day.day)
                                            h3= day.day
                                            each period in day.periods
                                                .doctor-schedule-period
                                                    p.doctor-schedule-period-meta #{ period.validityLabel } · #{ period.status }
                                                    +scheduleTimeList(period.intervals, false)
                        if doctor.previousSchedule.length
                            details.doctor-schedule-disclosure
                                summary.doctor-schedule-disclosure-summary
                                    span Historial de horarios anteriores
                                    svg(
                                        aria-hidden="true",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8",
                                        stroke-linecap="round",
                                        stroke-linejoin="round"
                                    )
                                        path(d="m6 9 6 6 6-6")
                                p.doctor-schedule-history-note Los horarios anteriores se conservan para consulta.
                                .doctor-schedule-period-groups
                                    each day in doctor.previousSchedule
                                        section.doctor-schedule-period-day(aria-label=day.day)
                                            h3= day.day
                                            each period in day.periods
                                                .doctor-schedule-period
                                                    p.doctor-schedule-period-meta #{ period.validityLabel } · #{ period.status }
                                                    +scheduleTimeList(period.intervals, true)
                footer.doctor-details-footer
                    a.doctors-secondary-button(href="/admin/doctors") Volver al directorio
                if doctor.profileReviewStatus === "pending"
                    dialog.doctor-review-dialog(
                        data-review-dialog,
                        aria-labelledby="doctor-corrections-title"
                    )
                        .doctor-review-dialog-content
                            button.doctor-review-dialog-close(
                                type="button",
                                aria-label="Cerrar",
                                data-review-close
                            ) ×
                            p.admin-eyebrow Revisión de perfil
                            h2#doctor-corrections-title Solicitar correcciones
                            p Indica con claridad qué debe actualizar el médico.
                            label.doctor-form-field(for="doctor-review-note")
                                span Mensaje para el médico
                                textarea#doctor-review-note(
                                    rows="5",
                                    minlength="10",
                                    maxlength="500",
                                    required,
                                    data-review-note
                                )
                            p.doctor-review-dialog-feedback(
                                role="alert",
                                data-review-dialog-feedback
                            )
                            .doctor-review-actions
                                button.doctors-secondary-button(type="button", data-review-close) Cancelar
                                button.doctors-primary-button(
                                    type="button",
                                    data-review-action="request_changes"
                                ) Enviar correcciones
            script(src="/js/admin-doctors.js", defer)
