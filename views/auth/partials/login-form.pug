.login-form-wrap
    img.login-brand-logo.login-panel-logo(
        src="/brand/logo-primary.png",
        alt="SaludVital",
        width="260",
        height="88"
    )
    h1#login-title Bienvenido de nuevo
    p.login-subtitle Inicia sesión para acceder a tu cuenta de salud.

    if error
        p#login-error.login-error(role="alert")= error

    form.login-form(action="/login", method="POST")
        div
            label(for="email") Correo electrónico
            input#email(
                type="email",
                name="email",
                autocomplete="username",
                maxlength="80",
                placeholder="Ingresa tu correo electrónico",
                required,
                aria-describedby=error ? "login-error" : undefined
            )

        div
            .login-password-heading
                label(for="password") Contraseña
                a(href="/forgot-password") ¿Olvidaste tu contraseña?
            .login-password-field
                input#password(
                    type="password",
                    name="password",
                    autocomplete="current-password",
                    placeholder="Ingresa tu contraseña",
                    required
                )
                button.login-password-toggle(
                    type="button",
                    data-password-toggle,
                    aria-label="Mostrar contraseña",
                    aria-pressed="false"
                ) Mostrar

        button.login-submit(type="submit")
            | Iniciar sesión
            span(aria-hidden="true") →

    .login-register
        span o
        p ¿Aún no tienes una cuenta?
        a(href="/register") Crear una cuenta

    p.login-security-note
        span(aria-hidden="true") ◈
        | Tu información de salud está protegida.
