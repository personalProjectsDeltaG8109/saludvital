doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.login-page.min-h-screen.text-primary.antialiased
        main.login-layout
            include ./partials/login-desktop

            section.login-panel(aria-labelledby="login-title")
                include ./partials/login-mobile
                include ./partials/login-form

        if whatsappContactUrl
            aside.whatsapp-widget(aria-label="Contacto por WhatsApp")
                .whatsapp-message
                    p.whatsapp-message-title ¿Gestiona tus citas aquí?
                    p Pide tus citas médicas y consulta tus próximas citas.
                    p.whatsapp-message-help ¿Necesitas ayuda? Escríbenos por WhatsApp.
                a.whatsapp-float(
                    href=whatsappContactUrl,
                    target="_blank",
                    rel="noopener noreferrer",
                    aria-label="Contactar a SaludVital por WhatsApp",
                    title="Escríbenos por WhatsApp"
                )
                    img(
                        src="/brand/whatsapp-svgrepo-com.svg",
                        alt="",
                        aria-hidden="true",
                        width="32",
                        height="32"
                    )

        script(src="/js/login.js", defer)
