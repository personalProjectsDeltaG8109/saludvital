doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.min-h-screen.bg-background.text-primary.antialiased
        //- Responsive password recovery page.
        main.flex.min-h-screen.items-center.justify-center.p-4(class="sm:p-8")
            section.w-full.max-w-md.rounded-3xl.border.border-slate-100.bg-white.p-6.shadow-xl(
                class="sm:p-10",
                aria-labelledby="recovery-title"
            )
                //- SaludVital brand.
                a.mb-8.inline-flex.items-center.gap-3(
                    href="/login",
                    aria-label="SaludVital, volver al inicio de sesión"
                )
                    span.flex.size-12.items-center.justify-center.rounded-2xl.bg-primary.text-lg.font-bold.text-white SV
                    span.text-xl.font-bold.text-primary SaludVital

                //- Recovery heading and instructions.
                h1#recovery-title.text-2xl.font-bold.tracking-tight(class="sm:text-3xl") ¿Olvidaste tu contraseña?
                p.mt-3.text-sm.leading-6.text-slate-600
                    | Ingresa el correo electrónico asociado a tu cuenta y te enviaremos instrucciones para recuperarla.

                //- Safe feedback messages.
                if error
                    p.mt-5.rounded-xl.border.border-red-200.bg-red-50.p-3.text-sm.text-red-800(
                        role="alert"
                    )= error

                if success
                    p.mt-5.rounded-xl.border.border-green-200.bg-green-50.p-3.text-sm.text-green-800(
                        role="status"
                    )= success

                //- Submit a password recovery request.
                form.mt-7.space-y-5(action="/forgot-password", method="POST")
                    div
                        label.mb-2.block.text-sm.font-semibold(for="email") Correo electrónico
                        input#email.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900.outline-none.transition(
                            class="placeholder:text-slate-400 focus:border-secondary focus:ring-2 focus:ring-secondary/20",
                            type="email",
                            name="email",
                            autocomplete="email",
                            maxlength="100",
                            placeholder="ejemplo@correo.com",
                            required
                        )

                    button.w-full.rounded-full.bg-primary.px-5.py-3.font-semibold.text-white.transition(
                        class="hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2",
                        type="submit"
                    ) Enviar instrucciones

                a.mt-6.flex.items-center.justify-center.text-sm.font-semibold.text-primary(
                    class="hover:text-secondary hover:underline",
                    href="/login"
                ) Volver a iniciar sesión
