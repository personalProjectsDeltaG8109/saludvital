aside.doctor-sidebar
    a.doctor-brand(href="/doctor/dashboard", aria-label="SaludVital, inicio")
        img(src="/brand/logo-primary.png", alt="SaludVital")

    nav.doctor-nav(aria-label="Navegación principal")
        a.doctor-nav-link(class=activeNav === "home" ? "is-active" : null, href="/doctor/dashboard", aria-current=activeNav === "home" ? "page" : null)
            span(aria-hidden="true")
                svg(viewBox="0 0 24 24")
                    path(d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z")
            | Inicio
        a.doctor-nav-link(class=activeNav === "appointments" ? "is-active" : null, href="/doctor/appointments", aria-current=activeNav === "appointments" ? "page" : null)
            span(aria-hidden="true")
                svg(viewBox="0 0 24 24")
                    path(d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h2m3 0h2")
            | Mis citas
        a.doctor-nav-link(class=activeNav === "patients" ? "is-active" : null, href="/doctor/patients", aria-current=activeNav === "patients" ? "page" : null)
            span(aria-hidden="true")
                svg(viewBox="0 0 24 24")
                    path(d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-3a4 4 0 0 1 0 7m3 6v-2a4 4 0 0 0-3-3.87")
            | Pacientes

    .doctor-sidebar-footer
        form(action="/logout", method="POST")
            button.doctor-logout(type="submit") Cerrar sesión
