doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.min-h-screen.bg-background.text-primary.antialiased
        //- Responsive password reset page.
        main.flex.min-h-screen.items-center.justify-center.p-4(class="sm:p-8")
            section.w-full.max-w-md.rounded-3xl.border.border-slate-100.bg-white.p-6.shadow-xl(
                class="sm:p-10",
                aria-labelledby="reset-title"
            )
                //- SaludVital brand.
                a.mb-8.inline-flex.items-center.gap-3(
                    href="/login",
                    aria-label="SaludVital, volver al inicio de sesión"
                )
                    span.flex.size-12.items-center.justify-center.rounded-2xl.bg-primary.text-lg.font-bold.text-white SV
                    span.text-xl.font-bold.text-primary SaludVital

                //- Reset heading and instructions.
                h1#reset-title.text-2xl.font-bold.tracking-tight(class="sm:text-3xl") Crea una nueva contraseña
                p.mt-3.text-sm.leading-6.text-slate-600
                    | Elige una contraseña segura para volver a acceder a tu cuenta.

                //- Feedback messages.
                if error
                    p.mt-5.rounded-xl.border.border-red-200.bg-red-50.p-3.text-sm.text-red-800(
                        role="alert"
                    )= error

                if success
                    p.mt-5.rounded-xl.border.border-green-200.bg-green-50.p-3.text-sm.text-green-800(
                        role="status"
                    )= success
                    a.mt-6.flex.w-full.items-center.justify-center.rounded-full.bg-primary.px-5.py-3.font-semibold.text-white(
                        class="hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2",
                        href="/login"
                    ) Ir a iniciar sesión

                else
                    //- Submit the new password and the recovery token.
                    form.mt-7.space-y-5(action="/reset-password", method="POST")
                        input(type="hidden", name="token", value=token)

                        div
                            label.mb-2.block.text-sm.font-semibold(for="password") Nueva contraseña
                            input#password.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900.outline-none.transition(
                                class="placeholder:text-slate-400 focus:border-secondary focus:ring-2 focus:ring-secondary/20",
                                type="password",
                                name="password",
                                autocomplete="new-password",
                                minlength="10",
                                maxlength="50",
                                required
                            )

                        div
                            label.mb-2.block.text-sm.font-semibold(for="password_confirmation") Confirmar contraseña
                            input#password_confirmation.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900.outline-none.transition(
                                class="placeholder:text-slate-400 focus:border-secondary focus:ring-2 focus:ring-secondary/20",
                                type="password",
                                name="password_confirmation",
                                autocomplete="new-password",
                                minlength="10",
                                maxlength="50",
                                required
                            )

                        p.text-xs.leading-5.text-slate-500
                            | Usa entre 10 y 50 caracteres, una mayúscula, tres minúsculas, un número y un carácter especial.

                        button.w-full.rounded-full.bg-primary.px-5.py-3.font-semibold.text-white.transition(
                            class="hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2",
                            type="submit"
                        ) Restablecer contraseña

                if !success
                    a.mt-6.flex.items-center.justify-center.text-sm.font-semibold.text-primary(
                        class="hover:text-secondary hover:underline",
                        href="/login"
                    ) Volver a iniciar sesión
