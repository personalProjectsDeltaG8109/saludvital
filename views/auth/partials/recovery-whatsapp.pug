if whatsappContactUrl
    a.recovery-whatsapp(
        href=whatsappContactUrl,
        target="_blank",
        rel="noopener noreferrer",
        aria-label="Solicitar cita por WhatsApp"
    )
        img(src="/brand/whatsapp-svgrepo-com.svg", alt="", width="38", height="38")
