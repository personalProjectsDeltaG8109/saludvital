{
    "name": "saludvital",
    "version": "1.0.0",
    "description": "Healthcare appointment management platform",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "db:test:prepare": "node scripts/prepare-test-database.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "test:e2e": "node tests/e2e/app.e2e.js && node tests/e2e/admin-doctor-status.e2e.js && node tests/e2e/admin-specialties.e2e.js && node tests/e2e/admin-specialty-create.e2e.js && node tests/e2e/admin-specialty-edit.e2e.js && node tests/e2e/admin-appointments.e2e.js && node tests/e2e/admin-appointment-export.e2e.js && node tests/e2e/admin-appointment-details.e2e.js && node tests/e2e/admin-appointment-create.e2e.js && node tests/e2e/admin-appointment-edit.e2e.js && node tests/e2e/admin-doctor-schedules.e2e.js && node tests/e2e/admin-doctor-schedule-configuration.e2e.js && node tests/e2e/admin-doctor-schedule-edit.e2e.js && node tests/e2e/admin-doctor-schedule-exceptions.e2e.js && node tests/e2e/admin-audit.e2e.js && node tests/e2e/admin-profile.e2e.js && node tests/e2e/admin-reports.e2e.js && node tests/e2e/admin-whatsapp.e2e.js && node tests/e2e/doctor-agenda.e2e.js && node tests/e2e/doctor-profile.e2e.js",
        "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
        "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "db:seed:undo": "sequelize-cli db:seed:undo:all"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/personalProjectsDeltaG8109/saludvital.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/personalProjectsDeltaG8109/saludvital/issues"
    },
    "homepage": "https://github.com/personalProjectsDeltaG8109/saludvital#readme",
    "private": true,
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.24.5",
        "nodemailer": "^10.1.2",
        "pug": "^3.0.4",
        "sequelize": "^6.37.8"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-pug": "^3.6.0",
        "@tailwindcss/cli": "^4.3.3",
        "eslint": "^10.12.0",
        "jest": "^30.5.2",
        "nodemon": "^3.1.14",
        "playwright": "^1.64.0",
        "prettier": "^3.9.10",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.3.1",
        "tailwindcss": "^4.3.3"
    },
    "overrides": {
        "@parcel/watcher": "2.6.0"
    }
}
