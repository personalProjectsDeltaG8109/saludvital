
# Define the application execution environment.
NODE_ENV=development

# Define the local HTTP server port.
PORT=3000

# Define the mySQL connection settings.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saludvital
DB_USER=root
DB_PASSWORD=

# Define the JWT signing secret for local development.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion
EMAIL_FROM=SaludVital <tu_correo@gmail.com>
APP_BASE_URL=http://localhost:3000

# Optional public WhatsApp contact number used by the login page (international format).
LOGIN_WHATSAPP_CONTACT_NUMBER=

# Meta WhatsApp Cloud API. Keep all secret values in the server environment.
META_WHATSAPP_ACCESS_TOKEN=your_meta_access_token
META_WHATSAPP_APP_SECRET=your_meta_app_secret
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_private_verify_token
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_TEMPLATE_LANGUAGE=es_CO
META_WHATSAPP_REMINDER_TEMPLATE_NAME=
META_WHATSAPP_RESCHEDULE_TEMPLATE_NAME=
META_WHATSAPP_CANCELLATION_TEMPLATE_NAME=

# Resend transactional email. The sender domain must be verified with Resend.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notificaciones@example.com
RESEND_FROM_NAME=SaludVital
RESEND_REMINDER_SUBJECT=
RESEND_REMINDER_HTML=
RESEND_RESCHEDULE_SUBJECT=
RESEND_RESCHEDULE_HTML=
RESEND_CANCELLATION_SUBJECT=
RESEND_CANCELLATION_HTML=

# Inalambria Express SMS for Colombian numbers.
INALAMBRIA_API_KEY=your_inalambria_api_key

# Keep automated delivery disabled until provider setup and test sends are verified.
NOTIFICATION_DELIVERY_ENABLED=false

# WhatsApp chatbot runs only outside production and can be disabled in development.
WHATSAPP_CHATBOT_ENABLED=true
WHATSAPP_MESSAGE_RETENTION_DAYS=30
WHATSAPP_VERIFICATION_SECRET=replace_with_a_long_random_secret
