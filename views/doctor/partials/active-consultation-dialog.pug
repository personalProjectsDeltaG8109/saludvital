dialog.max-w-none.overflow-hidden.rounded-3xl.border.border-sky-100.bg-white.p-0.text-slate-800.shadow-xl(
    class="w-[min(92vw,32rem)] backdrop:bg-slate-950/40 backdrop:backdrop-blur-sm",
    aria-labelledby="active-consultation-title",
    aria-describedby="active-consultation-description",
    data-active-consultation-dialog
)
    section.p-6(class="sm:p-8")
        header.flex.items-start.gap-4
            span.grid.h-12.w-12.shrink-0.place-items-center.rounded-2xl.bg-amber-50.text-amber-600(
                aria-hidden="true"
            )
                svg(
                    width="25",
                    height="25",
                    viewBox="0 0 24 24",
                    fill="none",
                    stroke="currentColor",
                    stroke-width="1.8",
                    aria-hidden="true"
                )
                    path(d="M12 8v4l2.5 2.5M4.9 19.1a10 10 0 1 1 14.2 0M12 2v2")
            div
                h2#active-consultation-title.text-xl.font-extrabold.tracking-tight.text-primary Consulta en curso detectada
                p#active-consultation-description.mt-1.text-sm.leading-6.text-slate-600 Ya tienes una consulta abierta. Puedes continuarla o permanecer en la agenda.
        p.mt-4.min-h-5.text-sm.font-medium.text-red-600(
            role="status",
            aria-live="polite",
            data-active-consultation-feedback
        )
        .mt-5.flex.flex-col-reverse.gap-3(class="sm:flex-row sm:justify-end")
            button.inline-flex.min-h-11.items-center.justify-center.rounded-xl.border.border-slate-200.px-5.text-sm.font-semibold.text-slate-700.transition-colors(
                type="button",
                class="hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary",
                data-stay-in-agenda
            ) Permanecer en la agenda
            a.inline-flex.min-h-11.items-center.justify-center.rounded-xl.bg-secondary.px-5.text-sm.font-bold.text-white.shadow-md.transition-colors(
                class="hover:bg-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary",
                data-open-active-consultation-link
            ) Ir a la consulta abierta
