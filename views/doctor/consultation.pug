doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-consultation.css")
    body.sv-dashboard.doctor-home-page.patient-home-page
        .sv-layout
            include ./partials/sidebar.pug
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include ./partials/topbar.pug
                main.doctor-content.consultation-page(
                    data-consultation-id=consultation.id,
                    data-consultation-started-at=new Date(consultation.started_at).toISOString()
                )
                    header.consultation-heading
                        a(href="/doctor/appointments") ← Volver a mis citas
                        h1 Consulta médica
                        p Registra la atención y revisa la información antes de finalizar.
                        p.consultation-timer(
                            aria-label="Tiempo transcurrido desde el inicio de la consulta"
                        )
                            span Tiempo transcurrido:
                            strong(data-consultation-timer, role="timer", aria-live="off") 00:00:00
                    section.consultation-patient-card(aria-label="Información de la cita")
                        div
                            span Paciente
                            strong= `${patient.first_name} ${patient.last_name}`
                            small= `${(appointment.specialty && appointment.specialty.name) || "Consulta médica"} · ${(appointment.status && appointment.status.name) || "En curso"}`
                        div
                            span Motivo agendado
                            strong= appointment.reason || "No especificado"
                    nav.consultation-progress(aria-label="Pasos de la consulta")
                        button.is-active(type="button", data-step-indicator="0") 1. Atención
                        button(type="button", data-step-indicator="1") 2. Diagnóstico
                        button(type="button", data-step-indicator="2") 3. Tratamiento
                        button(type="button", data-step-indicator="3") 4. Finalizar
                    p.consultation-feedback(
                        role="status",
                        aria-live="polite",
                        data-consultation-feedback
                    )
                    form.consultation-form(data-consultation-form, novalidate)
                        section.consultation-step(data-consultation-step="0")
                            h2 Atención
                            p#consultation-form-guidance.consultation-form-guidance
                                | Los campos marcados con * son obligatorios para finalizar. Puedes guardar un borrador antes de completarlos.
                            label(for="consultation-symptoms") Motivo de consulta
                                textarea#consultation-symptoms(
                                    name="symptoms",
                                    rows="3",
                                    maxlength="5000",
                                    aria-describedby="symptoms-help",
                                    required
                                )
                                small#symptoms-help.consultation-field-help Hasta 5.000 caracteres.
                            label(for="consultation-feeling") ¿Cómo se siente el paciente?
                                textarea#consultation-feeling(
                                    name="patientFeeling",
                                    rows="2",
                                    maxlength="5000",
                                    aria-describedby="patient-feeling-help"
                                )
                                small#patient-feeling-help.consultation-field-help Hasta 5.000 caracteres.
                            h3 Signos vitales
                            .consultation-vitals
                                label Presión arterial
                                    input(
                                        type="text",
                                        name="bloodPressure",
                                        placeholder="120/80",
                                        maxlength="20"
                                    )
                                label Frecuencia cardiaca (lpm)
                                    input(
                                        type="number",
                                        name="heartRate",
                                        min="0",
                                        max="300",
                                        step="1"
                                    )
                                label Temperatura (°C)
                                    input(
                                        type="number",
                                        name="temperature",
                                        min="25",
                                        max="45",
                                        step="0.1"
                                    )
                                label Peso (kg)
                                    input(
                                        type="number",
                                        name="weight",
                                        min="0",
                                        max="500",
                                        step="0.1"
                                    )
                                label Estatura (m)
                                    input(
                                        type="number",
                                        name="height",
                                        min="0",
                                        max="3",
                                        step="0.01"
                                    )
                            label(for="consultation-evaluation") Evaluación médica
                                textarea#consultation-evaluation(
                                    name="clinicalNotes",
                                    rows="4",
                                    maxlength="10000",
                                    aria-describedby="evaluation-help",
                                    required
                                )
                                small#evaluation-help.consultation-field-help Hasta 10.000 caracteres.
                            .consultation-actions
                                button(type="button", data-save-draft) Guardar borrador
                                button(type="button", data-next-step) Siguiente
                        section.consultation-step(hidden, data-consultation-step="1")
                            h2 Diagnóstico
                            p Agrega uno o varios diagnósticos y sus observaciones opcionales.
                            .consultation-inline-fields
                                label(for="diagnosis-entry") Diagnóstico
                                    input#diagnosis-entry(
                                        type="text",
                                        maxlength="500",
                                        aria-describedby="diagnosis-help",
                                        data-diagnosis-input
                                    )
                                    small#diagnosis-help.consultation-field-help Hasta 500 caracteres.
                                label(for="diagnosis-notes-entry") Notas
                                    input#diagnosis-notes-entry(
                                        type="text",
                                        maxlength="5000",
                                        aria-describedby="diagnosis-notes-help",
                                        data-diagnosis-notes
                                    )
                                    small#diagnosis-notes-help.consultation-field-help Opcional; hasta 5.000 caracteres.
                                button(type="button", data-add-diagnosis) Agregar diagnóstico
                            ul.consultation-list(
                                data-diagnosis-list,
                                aria-label="Diagnósticos agregados"
                            )
                            .consultation-actions
                                button(type="button", data-previous-step) Anterior
                                button(type="button", data-save-draft) Guardar borrador
                                button(type="button", data-next-step) Siguiente
                        section.consultation-step(hidden, data-consultation-step="2")
                            h2 Tratamiento y órdenes
                            h3 Medicamentos (opcional)
                            p.consultation-form-guidance
                                | Si agregas un medicamento, completa su nombre, dosis, frecuencia y duración.
                            .consultation-medication-fields
                                label Medicamento
                                    input#medication-name(
                                        type="text",
                                        maxlength="150",
                                        aria-describedby="medication-name-help",
                                        data-medication-name
                                    )
                                    small#medication-name-help.consultation-field-help Hasta 150 caracteres.
                                label Dosis
                                    input#medication-dosage(
                                        type="text",
                                        maxlength="100",
                                        aria-describedby="medication-dosage-help",
                                        data-medication-dosage
                                    )
                                    small#medication-dosage-help.consultation-field-help Hasta 100 caracteres.
                                label Frecuencia
                                    input#medication-frequency(
                                        type="text",
                                        maxlength="100",
                                        aria-describedby="medication-frequency-help",
                                        data-medication-frequency
                                    )
                                    small#medication-frequency-help.consultation-field-help Hasta 100 caracteres.
                                label Duración
                                    input#medication-duration(
                                        type="text",
                                        maxlength="100",
                                        aria-describedby="medication-duration-help",
                                        data-medication-duration
                                    )
                                    small#medication-duration-help.consultation-field-help Hasta 100 caracteres.
                                label Instrucciones
                                    input#medication-instructions(
                                        type="text",
                                        maxlength="5000",
                                        aria-describedby="medication-instructions-help",
                                        data-medication-instructions
                                    )
                                    small#medication-instructions-help.consultation-field-help Opcionales; hasta 5.000 caracteres.
                                button(type="button", data-add-medication) Agregar medicamento
                            ul.consultation-list(
                                data-medication-list,
                                aria-label="Medicamentos agregados"
                            )
                            label(for="consultation-recommendations") Recomendaciones (opcional)
                                textarea#consultation-recommendations(
                                    name="recommendations",
                                    rows="3",
                                    maxlength="10000",
                                    aria-describedby="recommendations-help"
                                )
                                small#recommendations-help.consultation-field-help Hasta 10.000 caracteres.
                            label(for="consultation-orders") Órdenes médicas opcionales (una por línea)
                            textarea#consultation-orders(
                                name="medicalOrders",
                                rows="3",
                                maxlength="30029",
                                aria-describedby="medical-orders-help"
                            )
                            small#medical-orders-help.consultation-field-help
                                | Máximo 30 órdenes; cada línea admite hasta 1.000 caracteres.
                            .consultation-actions
                                button(type="button", data-previous-step) Anterior
                                button(type="button", data-save-draft) Guardar borrador
                                button(type="button", data-next-step) Revisar resumen
                        section.consultation-step(hidden, data-consultation-step="3")
                            h2 Resumen de la consulta
                            p Revisa los datos registrados antes de finalizar.
                            dl.consultation-summary(data-consultation-summary)
                            .consultation-actions
                                button(type="button", data-previous-step) Anterior
                                button(type="button", data-save-draft) Guardar borrador
                                button.consultation-complete(
                                    type="button",
                                    data-complete-consultation
                                ) Finalizar consulta
                include ./partials/bottom-nav.pug
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/doctor-consultation.js", defer)
