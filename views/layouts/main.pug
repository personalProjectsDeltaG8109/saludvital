
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="description" content="SaludVital appointment management platform")
        title= pageTitle
        link(rel="stylesheet" href="/css/app.css")
    body(class="min-h-screen bg-slate-50 text-slate-900 antialiased")
        main(class="mx-auto flex min-h-screen max-w-5xl flex-col items-center justify-center px-6 py-12 text-center")
            p(class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700") Healthcare appointment management
            h1(class="text-4xl font-bold tracking-tight sm:text-6xl") SaludVital
            p(class="mt-5 max-w-xl text-lg leading-8 text-slate-600") Your health, connected.
            p(class="mt-8 rounded-full bg-emerald-100 px-4 py-2 text-sm font-medium text-emerald-800") Application foundation ready
