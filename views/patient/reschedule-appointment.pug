doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f2faff")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-reschedule.css")
    body.sv-dashboard.reschedule-page
        .sv-layout
            include partials/sidebar
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include partials/topbar
                main.reschedule-content
                    section.reschedule-hero
                        span.reschedule-hero-icon(aria-hidden="true")
                            svg(viewBox="0 0 24 24")
                                path(
                                    d="M20 7v5h-5M4 17v-5h5m10-2a7 7 0 0 0-12-3L4 9m16 6-3 2a7 7 0 0 1-12-3m7-3v4l2 1"
                                )
                        .reschedule-hero-copy
                            h2 Reprogramar cita
                            p Selecciona la cita que deseas reprogramar y elige una nueva fecha y hora disponible con el mismo médico.
                    ol.reschedule-stepper(aria-label="Pasos para reprogramar una cita")
                        li.is-current(data-reschedule-step="1")
                            span 1
                            strong Seleccionar cita
                        li(data-reschedule-step="2")
                            span 2
                            strong Nueva fecha y hora
                        li(data-reschedule-step="3")
                            span 3
                            strong Confirmar
                        li(data-reschedule-step="4")
                            span 4
                            strong Resultado
                    if appointments.length
                        form#reschedule-form.reschedule-form
                            section.reschedule-panel(aria-labelledby="reschedule-select-title")
                                .reschedule-panel-heading
                                    div
                                        h2#reschedule-select-title 1. Selecciona la cita a reprogramar
                                        p Elige una de tus citas próximas que se puedan reprogramar.
                                    aside.reschedule-notice(role="note")
                                        span(aria-hidden="true") i
                                        | Cada cita puede reprogramarse máximo 3 veces y solo con al menos 24 horas de anticipación.
                                .reschedule-table-wrap
                                    table.reschedule-table
                                        thead
                                            tr
                                                th(aria-label="Seleccionar")
                                                th Fecha y hora
                                                th Especialidad
                                                th Médico
                                                th Sede
                                                th Estado
                                                th Acción
                                        tbody
                                            each appointment, index in appointments
                                                - const startAt = new Date(appointment.start_at);
                                                - const doctorName = appointment.doctor_label || "Médico asignado";
                                                - const specialtyName = appointment.specialty ? appointment.specialty.name : "Consulta médica";
                                                - const reschedulesUsed = (appointment.history || []).filter((event) => event.event_type === "Rescheduled").length;
                                                tr.reschedule-appointment-row(
                                                    data-reschedule-appointment,
                                                    data-id=appointment.id,
                                                    data-doctor-id=appointment.doctor_id,
                                                    data-reschedules-used=reschedulesUsed,
                                                    data-specialty=specialtyName,
                                                    data-doctor-name=doctorName,
                                                    data-site=appointment.site_label || "Sede SaludVital",
                                                    data-start-at=startAt.toISOString(),
                                                    class=index === 0 ? "is-selected" : null
                                                )
                                                    td(data-label="Seleccionar")
                                                        input(
                                                            type="radio",
                                                            name="appointmentId",
                                                            value=appointment.id,
                                                            checked=appointment.id === selectedAppointmentId,
                                                            aria-label="Seleccionar esta cita"
                                                        )
                                                    td(data-label="Fecha y hora")
                                                        strong= startAt.toLocaleDateString("es-CO", { day: "2-digit", month: "short", year: "numeric", timeZone: "America/Bogota" })
                                                        span= startAt.toLocaleTimeString("es-CO", { hour: "numeric", minute: "2-digit", timeZone: "America/Bogota" })
                                                    td(data-label="Especialidad")
                                                        strong= specialtyName
                                                    td(data-label="Médico")= doctorName
                                                    td(data-label="Sede")= appointment.site_label || "Sede SaludVital"
                                                    td(data-label="Estado")
                                                        span.reschedule-status Confirmada
                                                    td(data-label="Acción")
                                                        span.reschedule-action Seleccionar
                            section.reschedule-panel(aria-labelledby="reschedule-date-title")
                                .reschedule-panel-heading
                                    div
                                        h2#reschedule-date-title 2. Elige una nueva fecha y hora
                                        p Selecciona una fecha y un horario disponible con el mismo médico.
                                .reschedule-date-time
                                    .reschedule-calendar
                                        .reschedule-calendar-heading
                                            button(
                                                type="button",
                                                data-month-shift="-1",
                                                aria-label="Mes anterior"
                                            ) ‹
                                            h3(data-calendar-month)
                                            button(
                                                type="button",
                                                data-month-shift="1",
                                                aria-label="Mes siguiente"
                                            ) ›
                                        .reschedule-weekdays(aria-hidden="true")
                                            span Do
                                            span Lu
                                            span Ma
                                            span Mi
                                            span Ju
                                            span Vi
                                            span Sá
                                        .reschedule-calendar-days(data-calendar-days)
                                    .reschedule-times
                                        h3 Horarios disponibles
                                        p(data-selected-date-label) Selecciona una fecha disponible.
                                        p.reschedule-message(role="status", data-time-message) Selecciona una cita para consultar horarios.
                                        .reschedule-time-grid(data-time-list)
                                    aside.reschedule-summary
                                        h3 Resumen de la nueva cita
                                        p.reschedule-limit-note(data-reschedule-limit-note)
                                        .reschedule-summary-person
                                            span.reschedule-doctor-avatar(aria-hidden="true")= patientName.split(" ").map((name) => name.charAt(0)).slice(0, 2).join("").toUpperCase()
                                            span
                                                strong(data-summary-doctor) Médico asignado
                                                small(data-summary-specialty) Especialidad
                                        p
                                            span(aria-hidden="true") ▦
                                            span(data-summary-date) Selecciona una fecha
                                        p
                                            span(aria-hidden="true") ◷
                                            span(data-summary-time) Selecciona un horario
                                        p
                                            span(aria-hidden="true") ◉
                                            span(data-summary-site) Sede
                            .reschedule-actions
                                a.reschedule-cancel(href="/patient/dashboard") Cancelar
                                button.reschedule-submit(type="submit", disabled) Confirmar reprogramación
                            dialog.reschedule-dialog(
                                data-confirm-reschedule-dialog,
                                aria-labelledby="reschedule-confirm-title"
                            )
                                .reschedule-dialog-content
                                    span.reschedule-dialog-icon(aria-hidden="true") ?
                                    h2#reschedule-confirm-title ¿Confirmas la reprogramación?
                                    p Confirma que deseas cambiar el horario de tu cita con el mismo médico.
                                    dl.reschedule-dialog-details
                                        div
                                            dt Médico
                                            dd(data-confirm-doctor)
                                        div
                                            dt Fecha y hora actuales
                                            dd(data-confirm-current-datetime)
                                        div
                                            dt Nuevo horario
                                            dd(data-confirm-new-datetime)
                                    .reschedule-dialog-actions
                                        button.reschedule-dialog-secondary(
                                            type="button",
                                            data-cancel-reschedule
                                        ) Volver
                                        button.reschedule-dialog-primary(
                                            type="button",
                                            data-confirm-reschedule
                                        ) Sí, reprogramar
                            dialog.reschedule-dialog(
                                data-feedback-dialog,
                                aria-labelledby="reschedule-feedback-title",
                                aria-describedby="reschedule-feedback-message"
                            )
                                .reschedule-dialog-content
                                    span.reschedule-dialog-icon(data-feedback-icon, aria-hidden="true")
                                    h2#reschedule-feedback-title(data-feedback-title)
                                    p#reschedule-feedback-message(data-feedback-message)
                                    .reschedule-dialog-actions
                                        button.reschedule-dialog-secondary(
                                            type="button",
                                            data-close-feedback
                                        ) Entendido
                                        a.reschedule-dialog-primary(
                                            href="/patient/appointments",
                                            data-view-appointments,
                                            hidden
                                        ) Ver mis citas
                    else
                        section.reschedule-empty
                            strong No tienes citas para reprogramar
                            p Solo aparecen aquí las citas confirmadas con más de 24 horas de anticipación y que no han alcanzado el máximo de 3 reprogramaciones.
                    include partials/bottom-nav
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/patient-reschedule.js", defer)
