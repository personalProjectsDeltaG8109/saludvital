doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-doctor-schedules.css")
    body.admin-app
        include partials/admin-shell.pug
        +adminSidebar("schedules")
        .admin-main-shell
            +adminTopbar("/admin/doctor-schedules", "Buscar médicos por nombre o correo...")
            main.doctor-schedules-page(
                data-doctor-schedules,
                data-endpoint="/api/admin/doctor-schedules",
                data-weekly-endpoint="/api/admin/doctor-schedules",
                data-exceptions-endpoint="/api/admin/doctor-schedule-exceptions",
                data-affected-appointments-endpoint="/api/admin/doctor-schedules/affected-appointments"
            )
                p.schedule-config-page-feedback(
                    role="status",
                    aria-live="polite",
                    data-config-page-feedback,
                    hidden
                )
                header.schedule-heading
                    .schedule-heading-icon(aria-hidden="true")
                        span ◷
                    div
                        p.admin-eyebrow Gestión médica
                        h1 Horarios y disponibilidad
                        p Gestiona los horarios de atención de los médicos y su disponibilidad.
                    button.schedule-configure-open(type="button", data-configure-open, disabled)
                        span(aria-hidden="true") ＋
                        | Configurar horario
                section.schedule-stats(aria-label="Resumen de horarios")
                    article.schedule-stat
                        span Médicos activos
                        strong(data-stat-active-doctors) —
                    article.schedule-stat.is-configured
                        span Con horario configurado
                        strong(data-stat-configured) —
                    article.schedule-stat.is-exceptions
                        span Excepciones próximas
                        strong(data-stat-exceptions) —
                        small Próximos 7 días
                    article.schedule-stat.is-affected
                        span Citas afectadas
                        strong(data-stat-affected) —
                        small(data-stat-affected-caption) Requieren revisión
                section.schedule-filters-panel(aria-label="Filtros de horarios")
                    form.schedule-filters(data-schedule-filters)
                        label.schedule-search
                            span Buscar médico
                            input(
                                type="search",
                                maxlength="100",
                                placeholder="Nombre o correo electrónico",
                                data-schedule-search
                            )
                        label
                            span Médico
                            select(data-schedule-doctor)
                                option(value="") Todos los médicos
                        label
                            span Especialidad
                            select(data-schedule-specialty)
                                option(value="") Todas las especialidades
                        label
                            span Estado del horario
                            select(data-schedule-status)
                                option(value="all") Todos
                                option(value="configured") Con horario
                                option(value="unconfigured") Sin horario
                        label.schedule-week
                            span Semana (lunes)
                            .schedule-week-control
                                button(
                                    type="button",
                                    aria-label="Semana anterior",
                                    data-week-previous
                                ) ‹
                                input(
                                    type="date",
                                    data-schedule-week,
                                    aria-label="Seleccionar lunes de la semana"
                                )
                                button(
                                    type="button",
                                    aria-label="Semana siguiente",
                                    data-week-next
                                ) ›
                        button.schedule-search-button(type="submit") Buscar
                .schedule-content
                    section.schedule-panel(aria-labelledby="weekly-schedule-title")
                        header.schedule-panel-heading
                            div
                                h2#weekly-schedule-title Horario semanal
                                p(data-schedule-week-label) Consulta los horarios registrados para la semana seleccionada.
                        p.schedule-feedback(
                            role="status",
                            aria-live="polite",
                            data-schedule-feedback
                        ) Cargando horarios…
                        p.schedule-error(role="alert", data-schedule-error, hidden)
                        section.weekly-selected-view(
                            data-weekly-view,
                            aria-labelledby="weekly-doctor-title",
                            hidden
                        )
                            header.weekly-view-heading
                                div
                                    h3#weekly-doctor-title(data-weekly-doctor-name) Horario del médico
                                    p(data-weekly-date-range)
                                button.schedule-back-button(type="button", data-weekly-clear) Ver todos los médicos
                            p.weekly-feedback(
                                role="status",
                                aria-live="polite",
                                data-weekly-feedback,
                                hidden
                            ) Cargando disponibilidad de la semana…
                            p.weekly-error(role="alert", data-weekly-error, hidden)
                            .weekly-view-layout(data-weekly-content, hidden)
                                section.weekly-calendar-card(
                                    aria-label="Agenda semanal del médico"
                                )
                                    .weekly-grid(data-weekly-grid)
                                aside.weekly-information-panel(
                                    aria-label="Información del horario"
                                )
                                    h4 Información del horario
                                    dl.weekly-information-list
                                        div
                                            dt Especialidad
                                            dd(data-weekly-specialty) —
                                        div
                                            dt Duración de cita
                                            dd(data-weekly-duration) —
                                        div
                                            dt Días de atención
                                            dd(data-weekly-working-days) —
                                        div
                                            dt Horario de atención
                                            dd(data-weekly-working-hours) —
                                    section.weekly-editable-schedules(
                                        aria-labelledby="weekly-editable-title"
                                    )
                                        h5#weekly-editable-title Horarios configurados
                                        ul(data-weekly-editable-blocks)
                            ul.weekly-legend(aria-label="Estados de horario")
                                li.is-available Disponible
                                li.is-additional-availability Disponibilidad adicional
                                li.is-appointment Cita
                                li.is-blocked No disponible
                            p.weekly-empty(data-weekly-empty, hidden) Este médico no tiene horario configurado para la semana seleccionada.
                        .schedule-doctor-list(data-schedule-doctor-list)
                        p.schedule-empty(data-schedule-empty, hidden) No hay médicos que coincidan con los filtros seleccionados.
                    aside.schedule-panel.schedule-exceptions-panel(
                        aria-labelledby="upcoming-exceptions-title"
                    )
                        header.schedule-panel-heading
                            div
                                h2#upcoming-exceptions-title Próximas excepciones
                                p Excepciones registradas para los próximos 7 días.
                            button.schedule-exceptions-manage(type="button", data-exceptions-open) Administrar
                        p.schedule-exceptions-empty(data-schedule-exceptions-empty, hidden) No hay excepciones próximas.
                        ul.schedule-exceptions-list(data-schedule-exceptions)
                    aside.schedule-panel.schedule-affected-panel(
                        aria-labelledby="affected-appointments-title"
                    )
                        header.schedule-panel-heading
                            div
                                h2#affected-appointments-title Citas afectadas por cambios
                                p(data-affected-count) Citas confirmadas que requieren revisión.
                        p.schedule-feedback(data-affected-loading, role="status") Cargando citas afectadas...
                        p.schedule-error(data-affected-error, role="alert", hidden)
                        p.schedule-empty(data-affected-empty, hidden) No hay citas confirmadas afectadas por los horarios o excepciones actuales.
                        ul.schedule-affected-list(data-affected-list, aria-live="polite")
                        nav.schedule-affected-pagination(data-affected-pagination, aria-label="Paginación de citas afectadas", hidden)
                            button(type="button", data-affected-previous, disabled) Anterior
                            span(data-affected-page)
                            button(type="button", data-affected-next) Siguiente
                p.schedule-footnote Los horarios se muestran según la disponibilidad configurada. Cada cita utiliza la duración establecida por el sistema.
            dialog.schedule-config-dialog(
                data-schedule-config-dialog,
                aria-labelledby="schedule-config-title"
            )
                form.schedule-config-form(data-schedule-config-form)
                    header.schedule-config-heading
                        div
                            p.admin-eyebrow Configuración de disponibilidad
                            h2#schedule-config-title(data-config-title) Configurar horario
                            p(data-config-doctor-label) Selecciona un médico activo para continuar.
                        button.schedule-config-close(
                            type="button",
                            aria-label="Cerrar configuración",
                            data-config-close
                        ) ×
                    p.schedule-config-error(role="alert", data-config-error, tabindex="-1", hidden)
                    p.schedule-config-success(role="status", data-config-success, hidden)
                    .schedule-config-fields
                        label
                            span Médico
                            select(required, data-config-doctor)
                                option(value="") Selecciona un médico activo
                        label
                            span Inicio de vigencia
                            input(type="date", required, data-config-valid-from)
                        label
                            span Fin de vigencia (opcional)
                            input(type="date", data-config-valid-until)
                    fieldset.schedule-config-days
                        legend Días y horas de atención
                        each day, index in ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]
                            .schedule-config-day(data-config-day=index + 1)
                                label.schedule-config-day-toggle
                                    input(type="checkbox", data-day-enabled)
                                    span= day
                                .schedule-config-intervals(data-config-intervals)
                                    .schedule-config-interval(data-config-interval)
                                        label
                                            span Desde
                                            input(
                                                type="time",
                                                min="07:00",
                                                max="18:30",
                                                step="1800",
                                                data-interval-start,
                                                disabled
                                            )
                                        label
                                            span Hasta
                                            input(
                                                type="time",
                                                min="07:30",
                                                max="19:00",
                                                step="1800",
                                                data-interval-end,
                                                disabled
                                            )
                                        button.schedule-config-remove(
                                            type="button",
                                            data-remove-interval,
                                            aria-label="Eliminar intervalo",
                                            hidden
                                        ) ×
                                button.schedule-config-add(
                                    type="button",
                                    data-add-interval,
                                    hidden
                                ) Agregar otro intervalo
                    label.schedule-config-duration
                        span Duración de cita
                        input(
                            type="text",
                            value="30 minutos · duración del sistema",
                            readonly,
                            aria-readonly="true"
                        )
                    section.schedule-config-impact(
                        data-config-impact,
                        hidden,
                        aria-labelledby="config-impact-title"
                    )
                        h3#config-impact-title Revisa las citas confirmadas
                        p El horario propuesto afecta estas citas confirmadas. Al confirmar, se cancelarán. Las notificaciones se encolarán si la configuración y las preferencias de cada paciente lo permiten.
                        ul(data-config-impact-list)
                    footer.schedule-config-actions
                        button.schedule-config-cancel(type="button", data-config-close) Cancelar
                        button.schedule-config-delete(type="button", data-config-delete, hidden) Eliminar intervalo
                        button.schedule-config-submit(type="submit", data-config-submit) Guardar horario
            dialog.schedule-exception-dialog(
                data-exception-manager-dialog,
                aria-labelledby="exception-manager-title"
            )
                section.schedule-exception-manager(data-exception-manager)
                    header.schedule-exception-heading
                        div
                            p.admin-eyebrow Gestión de disponibilidad
                            h2#exception-manager-title Excepciones de horario
                            p Administra los periodos que modifican la disponibilidad del médico.
                        button.schedule-config-close(
                            type="button",
                            aria-label="Cerrar excepciones",
                            data-exception-close
                        ) ×
                    p.schedule-exception-error(
                        role="alert",
                        data-exception-error,
                        tabindex="-1",
                        hidden
                    )
                    p.schedule-exception-feedback(role="status", data-exception-feedback, hidden)
                    .schedule-exception-toolbar
                        label
                            span Estado
                            select(data-exception-status)
                                option(value="all") Todos
                                option(value="active") Activas
                                option(value="inactive") Inactivas
                        button.schedule-config-submit(type="button", data-exception-create) Nueva excepción
                    p(data-exception-loading, role="status", hidden) Cargando excepciones...
                    p(data-exception-empty, hidden) No hay excepciones para mostrar.
                    ul.schedule-exception-manage-list(data-exception-list)
                    form.schedule-exception-form(data-exception-form, hidden)
                        input(type="hidden", data-exception-id)
                        .schedule-exception-fields
                            label
                                span Médico
                                select(required, data-exception-doctor)
                                    option(value="") Selecciona un médico activo
                            label
                                span Tipo de excepción
                                select(required, data-exception-type)
                                    option(value="Unavailable") No disponible
                                    option(value="AdditionalAvailability") Disponibilidad adicional
                            label
                                span Inicio
                                input(
                                    type="datetime-local",
                                    step="1800",
                                    required,
                                    data-exception-start
                                )
                            label
                                span Fin
                                input(
                                    type="datetime-local",
                                    step="1800",
                                    required,
                                    data-exception-end
                                )
                            label.schedule-exception-reason
                                span Descripción (vacaciones, permiso, día no laborable...)
                                input(
                                    type="text",
                                    maxlength="255",
                                    required,
                                    data-exception-reason
                                )
                        footer.schedule-config-actions
                            button.schedule-config-cancel(type="button", data-exception-back) Volver
                            button.schedule-config-submit(type="submit", data-exception-submit) Guardar excepción
                section.schedule-exception-impact(
                    data-exception-impact,
                    hidden,
                    aria-labelledby="exception-impact-title"
                )
                    h3#exception-impact-title Citas confirmadas que requieren revisión
                    p Estas citas coinciden con el periodo. Confirmar solo guardará la excepción; las citas no se modificarán.
                    ul(data-exception-impact-list)
                    footer.schedule-config-actions
                        button.schedule-config-cancel(type="button", data-exception-impact-cancel) Volver
                        button.schedule-config-submit(type="button", data-exception-impact-confirm) Confirmar y continuar
            script(src="/js/admin-dashboard.js", defer)
            script(src="/js/admin-doctor-schedules.js", defer)
