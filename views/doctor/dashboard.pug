
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="stylesheet" href="/css/app.css")
    body(class="min-h-screen bg-slate-50 flex items-center justify-center p-6")
        main(class="w-full max-w-lg rounded-2xl bg-white p-8 shadow-lg")
            h1(class="mb-4 text-2xl font-bold text-primary") Acceso de Doctor
            p(class="mb-2 text-slate-700") Inicio de sesión correcto.
            p(class="mb-6 text-slate-600")
                | Rol verificado:
                strong= ` ${role}`
            form(action="/logout" method="POST")
                button(type="submit" class="rounded-lg bg-primary px-5 py-3 font-semibold text-white") Cerrar sesión

    script(src="/js/session-timeout.js" defer)