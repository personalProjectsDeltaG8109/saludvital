doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f2faff")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-profile.css")
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/patient-profile.js", defer)
    body.sv-dashboard.profile-page
        .sv-layout
            include partials/sidebar
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include partials/topbar
                main.profile-content
                    section.profile-hero(aria-labelledby="profile-title")
                        .profile-hero-copy
                            h2#profile-title Mi perfil
                            p Mantén tu información actualizada para una mejor atención médica.
                        .profile-hero-badge
                            span(aria-hidden="true") ✓
                            span Tu información<br>segura y protegida
                    .profile-layout
                        aside.profile-overview
                            section.profile-card.profile-identity
                                .profile-avatar-wrap
                                    span.profile-avatar(
                                        aria-hidden="true",
                                        data-profile-initials=patient.first_name.charAt(0).toUpperCase() + patient.last_name.charAt(0).toUpperCase()
                                    )
                                        if patient.profile_photo_url
                                            img.profile-avatar-image(
                                                src=patient.profile_photo_url,
                                                alt=""
                                            )
                                        else
                                            = patient.first_name.charAt(0).toUpperCase() + patient.last_name.charAt(0).toUpperCase()
                                    label.profile-avatar-upload(
                                        for="profile-photo-input",
                                        aria-label="Cambiar foto de perfil"
                                    )
                                        svg(viewBox="0 0 24 24", aria-hidden="true")
                                            path(
                                                d="M4 7h3l2-2h6l2 2h3v12H4zM12 10a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"
                                            )
                                        input#profile-photo-input(
                                            type="file",
                                            accept="image/jpeg,image/png,image/webp",
                                            data-profile-photo
                                        )
                                .profile-identity-copy
                                    h2= patient.first_name + " " + patient.last_name
                                    span.profile-role Paciente
                                .profile-contact-list
                                    p
                                        span(aria-hidden="true") ✉
                                        span= patient.user.email
                                    p
                                        span(aria-hidden="true") ☎
                                        span= patient.phone.startsWith("+") ? patient.phone : "+57 " + patient.phone
                                    p
                                        span(aria-hidden="true") ▣
                                        span= patient.document_type + " " + patient.document_number
                                    p
                                        span(aria-hidden="true") ◉
                                        span= patient.municipality + ", " + patient.department
                            section.profile-card.profile-photo-card
                                .profile-photo-heading
                                    div
                                        h2 Foto de perfil
                                        p JPG, PNG o WEBP · máximo 2 MB
                                .profile-photo-content
                                    if patient.profile_photo_url
                                        img.profile-photo-preview(
                                            src=patient.profile_photo_url,
                                            alt="Foto de perfil actual"
                                        )
                                    else
                                        span.profile-photo-preview.profile-photo-placeholder(
                                            aria-hidden="true"
                                        )= patient.first_name.charAt(0).toUpperCase()
                                    button.profile-photo-button(type="button", data-trigger-photo)
                                        span(aria-hidden="true") ✎
                                        | Cambiar foto
                        .profile-main-column
                            section.profile-stats(aria-label="Resumen de actividad")
                                article.profile-stat
                                    span(aria-hidden="true") ▦
                                    strong= appointmentCount
                                    small Citas realizadas
                                article.profile-stat
                                    span(aria-hidden="true") ♡
                                    strong= specialtyCount
                                    small Especialidades
                                article.profile-stat
                                    span(aria-hidden="true") ◷
                                    strong= yearsAsPatient === 0 ? "Menos de 1 año" : yearsAsPatient === 1 ? "1 año" : yearsAsPatient + " años"
                                    small como paciente
                            .profile-details
                                details.profile-card.profile-section(
                                    open,
                                    data-profile-section,
                                    data-section="personal"
                                )
                                    summary
                                        span.profile-section-icon(aria-hidden="true") ◉
                                        span Información personal
                                        span.profile-section-chevron(aria-hidden="true") ›
                                    .profile-section-body
                                        .profile-section-heading
                                            div
                                                h2 Información personal
                                                p Datos de contacto e identificación.
                                            button.profile-edit-button(
                                                type="button",
                                                data-edit-section="personal"
                                            )
                                                span(aria-hidden="true") ✎
                                                | Editar
                                        .profile-readonly(data-readonly-section="personal")
                                            dl.profile-data-list
                                                div
                                                    dt Nombres
                                                    dd= patient.first_name
                                                div
                                                    dt Apellidos
                                                    dd= patient.last_name
                                                div
                                                    dt Tipo de documento
                                                    dd= patient.document_type === "CC" ? "Cédula de ciudadanía" : "Cédula de extranjería"
                                                div
                                                    dt Número de documento
                                                    dd= patient.document_number
                                                div
                                                    dt Fecha de nacimiento
                                                    dd= new Date(String(patient.date_of_birth).slice(0, 10) + "T12:00:00").toLocaleDateString("es-CO", { day: "2-digit", month: "long", year: "numeric", timeZone: "America/Bogota" })
                                                div
                                                    dt Teléfono
                                                    dd= patient.phone.startsWith("+") ? patient.phone : "+57 " + patient.phone
                                                div
                                                    dt Correo electrónico
                                                    dd= patient.user.email
                                                div
                                                    dt Dirección de residencia
                                                    dd= patient.address || "Sin registrar"
                                                div
                                                    dt Departamento y municipio
                                                    dd= patient.municipality + ", " + patient.department
                                        form.profile-edit-form(
                                            hidden,
                                            data-profile-form="personal"
                                        )
                                            .profile-form-grid
                                                label
                                                    span Nombres
                                                    input(
                                                        type="text",
                                                        name="first_name",
                                                        value=patient.first_name,
                                                        maxlength="50",
                                                        required
                                                    )
                                                label
                                                    span Apellidos
                                                    input(
                                                        type="text",
                                                        name="last_name",
                                                        value=patient.last_name,
                                                        maxlength="50",
                                                        required
                                                    )
                                                label
                                                    span Correo electrónico
                                                    input(
                                                        type="email",
                                                        name="email",
                                                        value=patient.user.email,
                                                        maxlength="100",
                                                        required,
                                                        autocomplete="email"
                                                    )
                                                label
                                                    span Teléfono
                                                    input(
                                                        type="tel",
                                                        name="phone",
                                                        value=patient.phone,
                                                        maxlength="15",
                                                        pattern="[0-9]{7,15}",
                                                        required
                                                    )
                                                label
                                                    span Fecha de nacimiento
                                                    input(
                                                        type="date",
                                                        name="date_of_birth",
                                                        value=String(patient.date_of_birth).slice(0, 10),
                                                        required
                                                    )
                                                label
                                                    span Tipo de documento
                                                    select(name="document_type", required)
                                                        option(
                                                            value="CC",
                                                            selected=patient.document_type === "CC"
                                                        ) Cédula de ciudadanía
                                                        option(
                                                            value="CE",
                                                            selected=patient.document_type === "CE"
                                                        ) Cédula de extranjería
                                                label
                                                    span Número de documento
                                                    input(
                                                        type="text",
                                                        name="document_number",
                                                        value=patient.document_number,
                                                        maxlength="15",
                                                        pattern="[0-9]{1,15}",
                                                        required
                                                    )
                                                label.profile-form-wide
                                                    span Dirección de residencia
                                                    input(
                                                        type="text",
                                                        name="address",
                                                        value=patient.address || "",
                                                        maxlength="150"
                                                    )
                                                label
                                                    span Departamento
                                                    select(
                                                        name="department",
                                                        required,
                                                        data-profile-department
                                                    )
                                                        each department in departments
                                                            option(
                                                                value=department.code,
                                                                selected=department.code === currentDepartmentCode
                                                            )= department.name
                                                label
                                                    span Municipio
                                                    select(
                                                        name="municipality",
                                                        required,
                                                        data-profile-municipality
                                                    )
                                                        each municipality in municipalities
                                                            option(
                                                                value=municipality.code,
                                                                selected=municipality.name === patient.municipality
                                                            )= municipality.name
                                            .profile-form-actions
                                                button.profile-cancel(
                                                    type="button",
                                                    data-cancel-section="personal"
                                                ) Cancelar
                                                button.profile-save(type="submit") Guardar cambios
                                details.profile-card.profile-section(
                                    open,
                                    data-profile-section,
                                    data-section="medical",
                                    data-edit-dependent,
                                    hidden
                                )
                                    summary
                                        span.profile-section-icon.is-medical(aria-hidden="true") ♧
                                        span Información médica
                                        span.profile-section-chevron(aria-hidden="true") ›
                                    .profile-section-body
                                        .profile-section-heading
                                            div
                                                h2 Información médica
                                                p Esta información ayuda a brindarte una mejor atención.
                                            button.profile-edit-button(
                                                type="button",
                                                data-edit-section="medical"
                                            )
                                                span(aria-hidden="true") ✎
                                                | Editar
                                        .profile-readonly(data-readonly-section="medical")
                                            dl.profile-data-list
                                                div
                                                    dt Tipo de sangre
                                                    dd= patient.blood_type || "Sin registrar"
                                                div
                                                    dt Alergias
                                                    dd= patient.allergies || "Ninguna registrada"
                                                div
                                                    dt Condiciones médicas
                                                    dd= patient.existing_conditions || "Ninguna registrada"
                                        form.profile-edit-form(hidden, data-profile-form="medical")
                                            .profile-form-grid
                                                label
                                                    span Tipo de sangre
                                                    select(name="blood_type")
                                                        option(value="") Seleccionar
                                                        each bloodType in ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
                                                            option(
                                                                value=bloodType,
                                                                selected=patient.blood_type === bloodType
                                                            )= bloodType
                                                label.profile-form-wide
                                                    span Alergias
                                                    textarea(
                                                        name="allergies",
                                                        rows="2",
                                                        maxlength="255"
                                                    )= patient.allergies || ""
                                                label.profile-form-wide
                                                    span Condiciones médicas
                                                    textarea(
                                                        name="existing_conditions",
                                                        rows="2",
                                                        maxlength="255"
                                                    )= patient.existing_conditions || ""
                                            .profile-form-actions
                                                button.profile-cancel(
                                                    type="button",
                                                    data-cancel-section="medical"
                                                ) Cancelar
                                                button.profile-save(type="submit") Guardar cambios
                                details.profile-card.profile-section(
                                    open,
                                    data-profile-section,
                                    data-section="emergency",
                                    data-edit-dependent,
                                    hidden
                                )
                                    summary
                                        span.profile-section-icon.is-emergency(aria-hidden="true") ♡
                                        span Contacto de emergencia
                                        span.profile-section-chevron(aria-hidden="true") ›
                                    .profile-section-body
                                        .profile-section-heading
                                            div
                                                h2 Contacto de emergencia
                                                p Persona a quien podemos contactar si lo necesitamos.
                                            button.profile-edit-button(
                                                type="button",
                                                data-edit-section="emergency"
                                            )
                                                span(aria-hidden="true") ✎
                                                | Editar
                                        .profile-readonly(data-readonly-section="emergency")
                                            if emergencyContact
                                                dl.profile-data-list
                                                    div
                                                        dt Nombres
                                                        dd= emergencyContact.first_name
                                                    div
                                                        dt Apellidos
                                                        dd= emergencyContact.last_name
                                                    div
                                                        dt Teléfono
                                                        dd= emergencyContact.phone.startsWith("+") ? emergencyContact.phone : "+57 " + emergencyContact.phone
                                                    div
                                                        dt Correo electrónico
                                                        dd= emergencyContact.email || "Sin registrar"
                                                    div
                                                        dt Parentesco
                                                        dd= emergencyContact.relationship || "Sin registrar"
                                            else
                                                p.profile-no-emergency Aún no has agregado un contacto de emergencia.
                                        form.profile-edit-form(
                                            hidden,
                                            data-profile-form="emergency"
                                        )
                                            .profile-form-grid
                                                label
                                                    span Nombres
                                                    input(
                                                        type="text",
                                                        name="first_name",
                                                        value=(emergencyContact && emergencyContact.first_name) || "",
                                                        maxlength="50"
                                                    )
                                                label
                                                    span Apellidos
                                                    input(
                                                        type="text",
                                                        name="last_name",
                                                        value=(emergencyContact && emergencyContact.last_name) || "",
                                                        maxlength="50"
                                                    )
                                                label
                                                    span Teléfono
                                                    input(
                                                        type="tel",
                                                        name="phone",
                                                        value=(emergencyContact && emergencyContact.phone) || "",
                                                        maxlength="15",
                                                        pattern="[0-9]{7,15}"
                                                    )
                                                label
                                                    span Correo electrónico
                                                    input(
                                                        type="email",
                                                        name="email",
                                                        value=(emergencyContact && emergencyContact.email) || "",
                                                        maxlength="254"
                                                    )
                                                label
                                                    span Parentesco
                                                    input(
                                                        type="text",
                                                        name="relationship",
                                                        value=(emergencyContact && emergencyContact.relationship) || "",
                                                        maxlength="50"
                                                    )
                                            .profile-form-actions
                                                button.profile-cancel(
                                                    type="button",
                                                    data-cancel-section="emergency"
                                                ) Cancelar
                                                button.profile-save(type="submit") Guardar cambios
                    section.profile-quick-actions(aria-label="Seguridad y preferencias")
                        a.profile-quick-card(href="/forgot-password")
                            span.profile-quick-icon.is-security(aria-hidden="true") ♙
                            span
                                strong Contraseña
                                small Mantén tu cuenta segura con una contraseña fuerte.
                            span.profile-quick-action Cambiar contraseña →
                        a.profile-quick-card(href="/patient/notifications")
                            span.profile-quick-icon.is-notifications(aria-hidden="true") ♧
                            span
                                strong Preferencias de notificaciones
                                small Configura cómo quieres recibir recordatorios y novedades.
                            span.profile-quick-action Gestionar notificaciones →
                        button.profile-quick-card.profile-delete-card(
                            type="button",
                            data-open-delete
                        )
                            span.profile-quick-icon.is-danger(aria-hidden="true") ♲
                            span
                                strong Eliminar cuenta
                                small La cuenta se desactivará y se cerrará tu sesión.
                            span.profile-quick-action Eliminar cuenta →
                    p.profile-feedback(role="status", aria-live="polite", data-profile-feedback)
                    dialog.profile-delete-dialog(
                        data-delete-dialog,
                        aria-labelledby="delete-account-title"
                    )
                        form.profile-delete-form(data-delete-form)
                            button.profile-dialog-close(
                                type="button",
                                aria-label="Cerrar",
                                data-close-delete
                            ) ×
                            span.profile-delete-icon(aria-hidden="true") !
                            h2#delete-account-title Eliminar cuenta
                            p Esta acción cerrará tu acceso a SaludVital. Tus citas e historia clínica se conservarán asociadas a un perfil desactivado.
                            label
                                span Contraseña actual
                                input(
                                    type="password",
                                    name="password",
                                    required,
                                    autocomplete="current-password"
                                )
                            label
                                span Escribe ELIMINAR para confirmar
                                input(
                                    type="text",
                                    name="confirmation",
                                    required,
                                    autocomplete="off",
                                    data-delete-confirmation
                                )
                            p.profile-delete-feedback(
                                role="alert",
                                aria-live="polite",
                                data-delete-feedback
                            )
                            .profile-form-actions
                                button.profile-cancel(type="button", data-close-delete) Cancelar
                                button.profile-delete-confirm(type="submit", disabled) Eliminar cuenta
                include partials/bottom-nav
