doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f2faff")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-clinical-history.css")
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/patient-clinical-history.js", defer)
    body.sv-dashboard.clinical-history-page(data-preview-mode=previewMode ? "true" : "false")
        .sv-layout
            include partials/sidebar
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include partials/topbar
                main.clinical-history-content
                    section.clinical-history-hero(aria-labelledby="clinical-history-title")
                        .clinical-history-hero-copy
                            h2#clinical-history-title Historial clínico
                            p Consulta el registro de tus atenciones médicas, diagnósticos y tratamientos.

                    if previewMode
                        p.clinical-preview-note Vista previa: los registros mostrados son ficticios y solo sirven para revisar el diseño.

                    section.clinical-history-stats(aria-label="Resumen de tu historial clínico")
                        article.clinical-stat.stat-consultations
                            span.clinical-stat-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(
                                        d="M7 3h10v3h3v15H4V6h3V3Zm0 3h10V3H7v3Zm1 5h8m-8 4h8m-8 4h5"
                                    )
                            span.clinical-stat-copy
                                strong= totals.consultations
                                small Consultas realizadas
                        article.clinical-stat.stat-diagnoses
                            span.clinical-stat-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(
                                        d="M7 3v5a5 5 0 0 0 10 0V3m-13 0h6m4 0h6m-8 5v5a5 5 0 0 0 10 0v-1m-10 1a5 5 0 0 1-5 5v3"
                                    )
                            span.clinical-stat-copy
                                strong= totals.diagnoses
                                small Diagnósticos registrados
                        article.clinical-stat.stat-treatments
                            span.clinical-stat-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(
                                        d="m9 15 6-6m-8 9-2-2a4 4 0 0 1 0-6l4-4a4 4 0 0 1 6 0m2 1 2 2a4 4 0 0 1 0 6l-4 4a4 4 0 0 1-6 0"
                                    )
                            span.clinical-stat-copy
                                strong= totals.treatments
                                small Tratamientos asignados
                    .clinical-history-layout
                        section.clinical-list-panel(aria-labelledby="clinical-list-title")
                            .clinical-panel-heading
                                h2#clinical-list-title Mis consultas
                            .clinical-list-tools
                                label.clinical-search
                                    span(aria-hidden="true")
                                        svg(viewBox="0 0 24 24")
                                            circle(cx="10.8", cy="10.8", r="6.8")
                                            path(d="m16 16 5 5")
                                    input(
                                        type="search",
                                        placeholder="Buscar por médico, especialidad o fecha...",
                                        aria-label="Buscar en mis consultas",
                                        data-consultation-search
                                    )
                                label.clinical-filter
                                    span.sr-only Filtrar consultas
                                    select(
                                        aria-label="Filtrar consultas",
                                        data-consultation-filter
                                    )
                                        option(value="all") Todas las consultas
                                        option(value="diagnosis") Con diagnósticos
                                        option(value="treatment") Con tratamientos

                            if consultations.length
                                .clinical-consultation-list(data-consultation-list)
                                    each consultation, index in consultations
                                        - const diagnosisCount = consultation.diagnosis_count || 0;
                                        - const treatmentCount = consultation.treatment_count || 0;
                                        - const specialty = consultation.specialty_label || (consultation.appointment && consultation.appointment.specialty && consultation.appointment.specialty.name) || "Consulta médica";
                                        button.clinical-consultation-card(
                                            type="button",
                                            class=index === 0 ? "is-selected" : null,
                                            data-consultation-card,
                                            data-consultation-id=consultation.id,
                                            data-preview-detail=previewMode ? JSON.stringify(previewConsultations.find((record) => record.id === consultation.id)) : null,
                                            data-search-text=[specialty, consultation.doctor_label, consultation.date_label].join(" ").toLowerCase(),
                                            data-has-diagnosis=diagnosisCount > 0 ? "true" : "false",
                                            data-has-treatment=treatmentCount > 0 ? "true" : "false",
                                            aria-pressed=index === 0 ? "true" : "false",
                                            aria-expanded=index === 0 ? "true" : "false"
                                        )
                                            if consultation.doctor_photo_url
                                                img.clinical-doctor-avatar(
                                                    src=consultation.doctor_photo_url,
                                                    alt="Foto de " + consultation.doctor_label,
                                                    loading="lazy"
                                                )
                                            else
                                                span.clinical-card-icon(
                                                    class="icon-" + (index % 5),
                                                    aria-hidden="true"
                                                )
                                                    if index === 1
                                                        svg(viewBox="0 0 24 24")
                                                            path(
                                                                d="M9 4v5a3 3 0 0 0 6 0V4m-8 0h4m2 0h4m-5 5v5a5 5 0 0 0 5 5h1"
                                                            )
                                                    else if index === 2
                                                        svg(viewBox="0 0 24 24")
                                                            path(
                                                                d="M20.8 8.7c0 5-8.8 11-8.8 11s-8.8-6-8.8-11a4.7 4.7 0 0 1 8.8-2.3 4.7 4.7 0 0 1 8.8 2.3Z"
                                                            )
                                                    else if index === 3
                                                        svg(viewBox="0 0 24 24")
                                                            path(
                                                                d="M4 7a3 3 0 0 1 3-3h4v16H7a3 3 0 0 1-3-3V7Zm16 0a3 3 0 0 0-3-3h-4v16h4a3 3 0 0 0 3-3V7Z"
                                                            )
                                                    else
                                                        svg(viewBox="0 0 24 24")
                                                            path(
                                                                d="M7 3h10v3h3v15H4V6h3V3Zm0 3h10V3H7v3Zm1 5h8m-8 4h8"
                                                            )
                                            span.clinical-card-copy
                                                strong= specialty
                                                span= consultation.doctor_label || "Profesional de salud"
                                                small= specialty
                                            time.clinical-card-date= consultation.date_label
                                            span.clinical-card-arrow(aria-hidden="true") ›
                                p.clinical-list-empty(hidden, data-consultation-empty) No encontramos consultas con ese criterio.
                                nav.clinical-history-pagination(
                                    aria-label="Paginación del historial clínico"
                                )
                                    p Mostrando #{ pagination.firstResult }–#{ pagination.lastResult } de #{ pagination.total } consultas
                                    .clinical-pagination-controls
                                        if pagination.page > 1
                                            a(
                                                href="?page=" + (pagination.page - 1) + "&pageSize=" + pagination.pageSize
                                            ) Anterior
                                        else
                                            span(aria-disabled="true") Anterior
                                        span Página #{ pagination.page } de #{ Math.max(pagination.totalPages, 1) }
                                        if pagination.page < pagination.totalPages
                                            a(
                                                href="?page=" + (pagination.page + 1) + "&pageSize=" + pagination.pageSize
                                            ) Siguiente
                                        else
                                            span(aria-disabled="true") Siguiente
                                    label.clinical-page-size
                                        | Consultas por página
                                        select(
                                            aria-label="Consultas por página",
                                            onchange="location.href='?page=1&pageSize='+this.value"
                                        )
                                            each size in [10, 20, 50]
                                                option(
                                                    value=size,
                                                    selected=pagination.pageSize === size
                                                )= size
                            else
                                .clinical-empty-state
                                    span.clinical-empty-icon(aria-hidden="true")
                                        svg(viewBox="0 0 24 24")
                                            path(d="M7 3h8l5 5v13H4V3h3Zm8 0v5h5m-9 4h6m-6 4h6")
                                    strong Aún no tienes consultas registradas
                                    p Aquí aparecerán las atenciones médicas que hayan sido completadas.
                                    if previewAvailable
                                        a(href="/patient/clinical-history?preview=1") Ver ejemplo con historial ficticio

                        section.clinical-detail-panel(
                            aria-label="Detalle de la consulta",
                            data-consultation-detail,
                            aria-live="polite"
                        )
                            .clinical-detail-placeholder(data-clinical-detail-placeholder)
                                span.clinical-empty-icon(aria-hidden="true")
                                    svg(viewBox="0 0 24 24")
                                        path(d="M7 3h8l5 5v13H4V3h3Zm8 0v5h5m-9 4h6m-6 4h6")
                                strong Selecciona una consulta
                                p El detalle clínico se cargará cuando abras un registro.
                            p.clinical-detail-loading(hidden, data-clinical-detail-loading) Cargando detalle…
                            p.clinical-detail-error(
                                hidden,
                                data-clinical-detail-error,
                                role="alert"
                            ) No pudimos cargar el detalle. Inténtalo de nuevo.
                            div(data-clinical-detail-content)
        include partials/bottom-nav
