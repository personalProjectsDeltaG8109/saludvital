doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-dashboard.css")
    body.sv-dashboard.doctor-home-page.patient-home-page
        .sv-layout
            include ./partials/sidebar.pug
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include ./partials/topbar.pug
                main.doctor-content.doctor-subpage-content.doctor-appointments-page(
                    data-appointments-api-url="/api/doctor/appointments"
                )
                    header.doctor-page-heading.doctor-appointments-heading
                        div
                            h1 Mis citas
                            p Consulta, organiza y encuentra tus citas médicas.

                    section.doctor-panel.doctor-appointments-panel(aria-label="Citas del médico")
                        .doctor-appointment-summary(aria-label="Resumen de citas por estado")
                            form.doctor-summary-filter(method="get", action=appointmentsPath, data-appointment-quick-filter)
                                input(type="hidden", name="startDate", value=appointmentFilters.startDate)
                                input(type="hidden", name="endDate", value=appointmentFilters.endDate)
                                input(type="hidden", name="search", value=appointmentFilters.search)
                                button.doctor-summary-item.is-total(
                                    type="submit",
                                    name="status",
                                    value="",
                                    aria-pressed=String(!appointmentFilters.status)
                                )
                                    span.doctor-summary-icon(aria-hidden="true") ▦
                                    span.doctor-summary-copy
                                        strong= appointmentTotalCount
                                        small Todas
                            each statusItem in appointmentStatuses
                                form.doctor-summary-filter(method="get", action=appointmentsPath, data-appointment-quick-filter)
                                    input(type="hidden", name="startDate", value=appointmentFilters.startDate)
                                    input(type="hidden", name="endDate", value=appointmentFilters.endDate)
                                    input(type="hidden", name="search", value=appointmentFilters.search)
                                    button.doctor-summary-item(
                                        type="submit",
                                        name="status",
                                        value=statusItem.name,
                                        aria-pressed=String(appointmentFilters.status === statusItem.name),
                                        class=[`summary-${statusItem.name.toLowerCase().replaceAll(" ", "-")}`, appointmentFilters.status === statusItem.name ? "is-selected" : ""]
                                    )
                                        span.doctor-summary-icon(aria-hidden="true")= statusItem.name === "Confirmed" || statusItem.name === "Attended" ? "✓" : "×"
                                        span.doctor-summary-copy
                                            strong= statusItem.count
                                            small= statusItem.summaryLabel

                        form.doctor-appointment-filters(method="get", action=appointmentsPath, data-appointment-filters)
                            label.doctor-filter-field
                                span Fecha inicial
                                input(type="date", name="startDate", value=appointmentFilters.startDate)
                            label.doctor-filter-field
                                span Fecha final
                                input(type="date", name="endDate", value=appointmentFilters.endDate)
                            label.doctor-filter-field.doctor-filter-status
                                span Estado
                                select(name="status")
                                    option(value="") Todos
                                    each statusItem in appointmentStatuses
                                        option(value=statusItem.name, selected=appointmentFilters.status === statusItem.name)= statusItem.label
                            label.doctor-filter-field.doctor-filter-search
                                span Buscar paciente
                                input(
                                    type="search",
                                    name="search",
                                    value=appointmentFilters.search,
                                    maxlength="100",
                                    placeholder="Nombre o documento",
                                    autocomplete="off",
                                    data-live-search
                                )
                            .doctor-filter-actions
                                a.doctor-filter-reset(href=appointmentsPath) Limpiar

                        p.doctor-appointment-feedback(aria-live="polite", data-appointment-live-feedback, hidden)
                        .doctor-appointments-table-wrap(
                            data-appointments-table,
                            hidden=appointments.length === 0
                        )
                            table.doctor-appointments-table
                                thead
                                    tr
                                        th(scope="col") Fecha y hora
                                        th(scope="col") Paciente
                                        th(scope="col") Tipo de consulta
                                        th(scope="col") Estado
                                tbody(data-appointments-results)
                                    each appointment in appointments
                                        tr(id=`appointment-${appointment.id}`)
                                            td(data-label="Fecha y hora")
                                                time.doctor-appointment-date(datetime=appointment.startAt.toISOString())
                                                    strong= appointment.dateLabel
                                                    span= `${appointment.time} ${appointment.meridiem}`
                                            td(data-label="Paciente")
                                                .doctor-table-patient
                                                    if appointment.patientPhotoUrl
                                                        span.doctor-patient-avatar(aria-hidden="true")
                                                            img(src=appointment.patientPhotoUrl, alt="", loading="lazy")
                                                    else
                                                        span.doctor-patient-avatar(aria-hidden="true")= appointment.patientName.split(" ").map((name) => name.charAt(0)).slice(0, 2).join("").toUpperCase()
                                                    span.doctor-appointment-info
                                                        strong= appointment.patientName
                                                        small= appointment.specialty
                                            td(data-label="Tipo de consulta")= appointment.reason || appointment.specialty
                                            td(data-label="Estado")
                                                span.doctor-status(class=`status-${appointment.statusKey}`)= appointment.statusLabel
                        .doctor-empty-state.doctor-appointments-empty(
                            data-appointments-empty,
                            hidden=appointments.length > 0
                        )
                            span.doctor-empty-icon(aria-hidden="true") ▦
                            strong(data-appointments-empty-title)= appointmentCount ? "No encontramos citas con esos filtros" : "Aún no tienes citas"
                            p(data-appointments-empty-message)= appointmentCount ? "Prueba cambiar los filtros o limpiar la búsqueda." : "Tus citas asignadas aparecerán aquí."

                        nav.doctor-appointment-pagination(
                            aria-label="Paginación de citas",
                            data-appointments-pagination,
                            hidden=appointmentCount <= appointmentPageSize
                        )
                            p(data-appointments-range) Mostrando #{appointmentCount ? (appointmentPage - 1) * appointmentPageSize + 1 : 0} a #{Math.min(appointmentPage * appointmentPageSize, appointmentCount)} de #{appointmentCount} citas
                            .doctor-pagination-controls
                                form(method="get", action=appointmentsPath, data-appointment-page-filter)
                                    input(type="hidden", name="startDate", value=appointmentFilters.startDate)
                                    input(type="hidden", name="endDate", value=appointmentFilters.endDate)
                                    input(type="hidden", name="status", value=appointmentFilters.status)
                                    input(type="hidden", name="search", value=appointmentFilters.search)
                                    input(type="hidden", name="page", value=appointmentPage - 1, data-previous-page)
                                    button(type="submit", aria-label="Página anterior", disabled=appointmentPage <= 1) Anterior
                                span(data-appointments-page-label) Página #{appointmentPage} de #{appointmentTotalPages}
                                form(method="get", action=appointmentsPath, data-appointment-page-filter)
                                    input(type="hidden", name="startDate", value=appointmentFilters.startDate)
                                    input(type="hidden", name="endDate", value=appointmentFilters.endDate)
                                    input(type="hidden", name="status", value=appointmentFilters.status)
                                    input(type="hidden", name="search", value=appointmentFilters.search)
                                    input(type="hidden", name="page", value=appointmentPage + 1, data-next-page)
                                    button(type="submit", aria-label="Página siguiente", disabled=appointmentPage >= appointmentTotalPages) Siguiente
                include ./partials/bottom-nav.pug
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
        script(src="/js/doctor-appointments.js", defer)
