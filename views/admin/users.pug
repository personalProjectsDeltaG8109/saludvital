doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#063f79")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-users.css")
    body.admin-app.admin-users-page
        include partials/admin-shell.pug
        +adminSidebar("users")
        .admin-main-shell
            +adminTopbar
            main.admin-users-content(
                data-admin-users,
                data-endpoint="/api/admin/users",
                data-update-endpoint="/api/admin/users",
                data-role-endpoint="/api/admin/users",
                data-doctor-status-endpoint="/api/admin/doctors",
                data-details-endpoint="/api/admin/users",
                data-departments-endpoint="/api/admin/locations/departments",
                data-municipalities-endpoint="/api/admin/locations/municipalities",
                data-invitations-endpoint="/api/admin/account-invitations"
            )
                header.admin-users-heading
                    .admin-users-heading-main
                        span.admin-users-heading-icon(aria-hidden="true")
                            svg(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8",
                                stroke-linecap="round",
                                stroke-linejoin="round"
                            )
                                circle(cx="9", cy="8", r="3.5")
                                path(d="M2.8 20v-1.2a6.2 6.2 0 0 1 12.4 0V20")
                                path(d="M16.2 4.8a3.5 3.5 0 0 1 0 6.4")
                                path(d="M18.2 14.4a5.4 5.4 0 0 1 3 4.9V20")
                        .admin-users-heading-copy
                            p.admin-eyebrow Gestión médica
                            h1 Usuarios y roles
                            p Revisa las cuentas registradas y administra su acceso a SaludVital.
                    .admin-users-heading-actions
                        .admin-users-total(aria-live="polite")
                            strong(data-user-count) —
                            span cuentas
                        button.admin-invite-trigger(type="button", data-invitation-open)
                            svg(
                                width="19",
                                height="19",
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="2",
                                stroke-linecap="round",
                                stroke-linejoin="round",
                                aria-hidden="true"
                            )
                                path(d="M12 5v14M5 12h14")
                            | Invitar cuenta
                section.admin-invitations-panel(aria-labelledby="admin-invitations-title")
                    header.admin-invitations-header
                        div
                            h2#admin-invitations-title Invitaciones pendientes
                            p Envía un enlace seguro para que la persona complete su registro.
                        span.admin-invitation-icon(aria-hidden="true")
                            svg(
                                width="22",
                                height="22",
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8",
                                stroke-linecap="round",
                                stroke-linejoin="round"
                            )
                                path(d="M4 6h16v12H4z")
                                path(d="m4 7 8 6 8-6")
                    p.admin-invitations-feedback(
                        role="status",
                        aria-live="polite",
                        data-invitation-feedback
                    ) Cargando invitaciones…
                    .admin-invitation-list(data-invitation-list, aria-live="polite")
                section.admin-users-panel(aria-labelledby="admin-users-title")
                    header.admin-users-panel-header
                        div
                            h2#admin-users-title Cuentas de usuario
                            p Consulta y actualiza roles o estados de cuenta.
                        span.admin-users-security
                            span(aria-hidden="true") ◈
                            | Acceso administrativo protegido
                    form.admin-users-filters(data-user-filters)
                        label.admin-users-search
                            span(aria-hidden="true") ⌕
                            span.sr-only Buscar por nombre o correo
                            input(
                                type="search",
                                placeholder="Buscar por nombre o correo...",
                                maxlength="100",
                                data-user-search
                            )
                        label.admin-users-filter
                            span Rol
                            select(data-user-role)
                                option(value="") Todos los roles
                        label.admin-users-filter
                            span Estado
                            select(data-user-status)
                                option(value="") Todos los estados
                                option(value="active") Activas
                                option(value="inactive") Inactivas
                    p.admin-users-feedback(role="status", aria-live="polite", data-user-feedback) Cargando cuentas…
                    .admin-user-list(data-user-list, aria-live="polite")
                    footer.admin-users-pagination
                        span(data-user-page-label) Página 1 de 1
                        div
                            button.admin-page-button(type="button", data-user-prev, disabled) Anterior
                            button.admin-page-button(type="button", data-user-next, disabled) Siguiente
                p.admin-users-note Los cambios de rol y estado se registran para auditoría. Las cuentas no se eliminan.
            .admin-user-modal-backdrop(hidden, data-invitation-modal)
                section.admin-user-modal.admin-invitation-modal(
                    role="dialog",
                    aria-modal="true",
                    aria-labelledby="admin-invitation-modal-title",
                    tabindex="-1",
                    data-invitation-dialog
                )
                    header.admin-user-modal-header
                        div
                            p.admin-eyebrow Nueva cuenta
                            h2#admin-invitation-modal-title Invitar a SaludVital
                            p.admin-invitation-intro Elige el tipo de cuenta. Enviaremos un enlace al correo para completar el registro.
                        button.admin-user-modal-close(
                            type="button",
                            aria-label="Cerrar invitación",
                            data-invitation-close
                        )
                            svg(
                                width="18",
                                height="18",
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.9",
                                stroke-linecap="round",
                                aria-hidden="true"
                            )
                                path(d="m6 6 12 12M18 6 6 18")
                    p.admin-user-modal-feedback(
                        role="alert",
                        aria-live="assertive",
                        data-invitation-modal-feedback
                    )
                    form(data-invitation-form)
                        fieldset.admin-invitation-roles
                            legend Tipo de cuenta
                            label.admin-invitation-role-card.is-selected(data-account-role-card)
                                input(type="radio", name="accountType", value="patient", checked)
                                span.admin-invitation-role-icon(aria-hidden="true")
                                    svg(
                                        width="23",
                                        height="23",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8",
                                        stroke-linecap="round",
                                        stroke-linejoin="round"
                                    )
                                        path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                        circle(cx="12", cy="7", r="4")
                                span
                                    strong Paciente
                                    small Completa sus datos y acepta el aviso de privacidad.
                            label.admin-invitation-role-card(data-account-role-card)
                                input(type="radio", name="accountType", value="administrator")
                                span.admin-invitation-role-icon.is-admin(aria-hidden="true")
                                    svg(
                                        width="23",
                                        height="23",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8",
                                        stroke-linecap="round",
                                        stroke-linejoin="round"
                                    )
                                        path(
                                            d="M12 3 4.5 6v5.5c0 4.6 3.2 7.6 7.5 9.5 4.3-1.9 7.5-4.9 7.5-9.5V6L12 3Z"
                                        )
                                        path(d="m9 12 2 2 4-4")
                                span
                                    strong Administrador
                                    small Obtiene acceso al panel después de confirmar el correo.
                            label.admin-invitation-role-card(data-account-role-card)
                                input(type="radio", name="accountType", value="doctor")
                                span.admin-invitation-role-icon.is-doctor(aria-hidden="true")
                                    svg(
                                        width="23",
                                        height="23",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8",
                                        stroke-linecap="round",
                                        stroke-linejoin="round"
                                    )
                                        path(d="M8 3v3m8-3v3M7 9h10M6 5h12v5a6 6 0 0 1-12 0V5Z")
                                        path(d="M12 16v2a3 3 0 0 0 6 0v-1")
                                        circle(cx="19", cy="16", r="2")
                                span
                                    strong Médico
                                    small Completa su perfil y espera la revisión del administrador.
                        .admin-invitation-form-fields
                            label.admin-user-form-field(
                                data-invitation-name-field,
                                for="invitation-name"
                            )
                                span Nombre completo
                                input#invitation-name(
                                    type="text",
                                    name="displayName",
                                    autocomplete="name",
                                    maxlength="120",
                                    required
                                )
                            label.admin-user-form-field(
                                data-invitation-specialty-field,
                                for="invitation-specialty",
                                hidden
                            )
                                span Especialidad médica
                                select#invitation-specialty(name="specialtyId", disabled)
                                    option(value="") Selecciona una especialidad
                            label.admin-user-form-field(for="invitation-email")
                                span Correo electrónico
                                input#invitation-email(
                                    type="email",
                                    name="email",
                                    autocomplete="email",
                                    maxlength="320",
                                    required
                                )
                        p.admin-invitation-consent-note(data-invitation-note) El paciente completa su información personal y de salud, acepta el aviso de privacidad y crea su propia contraseña.
                        footer.admin-user-modal-actions
                            button.admin-user-cancel(type="button", data-invitation-cancel) Cancelar
                            button.admin-user-save(type="submit", data-invitation-submit)
                                | Enviar invitación
            .admin-user-modal-backdrop(hidden, data-user-modal)
                section.admin-user-modal(
                    role="dialog",
                    aria-modal="true",
                    aria-labelledby="admin-user-modal-title",
                    tabindex="-1",
                    data-user-dialog
                )
                    header.admin-user-modal-header
                        div
                            p.admin-eyebrow Administración de cuenta
                            h2#admin-user-modal-title Editar usuario
                        button.admin-user-modal-close(
                            type="button",
                            aria-label="Cerrar ventana de edición",
                            data-user-modal-close
                        )
                            svg(
                                width="18",
                                height="18",
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.9",
                                stroke-linecap="round",
                                aria-hidden="true"
                            )
                                path(d="m6 6 12 12M18 6 6 18")
                    .admin-user-modal-profile(data-user-modal-profile)
                    p.admin-user-modal-feedback(
                        role="alert",
                        aria-live="assertive",
                        data-user-modal-feedback
                    )
                    form(data-user-edit-form)
                        .admin-user-edit-fields(data-user-edit-fields)
                        footer.admin-user-modal-actions
                            button.admin-user-cancel(type="button", data-user-modal-cancel) Cancelar
                            button.admin-user-save(type="submit", data-user-modal-save) Guardar cambios
            .admin-user-modal-backdrop(hidden, data-role-modal)
                section.admin-user-modal(
                    role="dialog",
                    aria-modal="true",
                    aria-labelledby="admin-user-role-modal-title",
                    tabindex="-1",
                    data-role-dialog
                )
                    header.admin-user-modal-header
                        div
                            p.admin-eyebrow Administración de cuenta
                            h2#admin-user-role-modal-title Completar perfil
                        button.admin-user-modal-close(
                            type="button",
                            aria-label="Cerrar ventana de cambio de rol",
                            data-role-modal-close
                        )
                            svg(
                                width="18",
                                height="18",
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.9",
                                stroke-linecap="round",
                                aria-hidden="true"
                            )
                                path(d="m6 6 12 12M18 6 6 18")
                    .admin-user-modal-profile(data-role-modal-profile)
                    p.admin-user-role-explanation(data-role-explanation)
                    p.admin-user-role-impact(hidden, data-role-impact)
                    p.admin-user-modal-feedback(
                        role="alert",
                        aria-live="assertive",
                        data-role-feedback
                    )
                    form(data-role-form)
                        .admin-user-edit-fields(data-role-fields)
                        footer.admin-user-modal-actions
                            button.admin-user-cancel(type="button", data-role-modal-cancel) Cancelar
                            button.admin-user-save(type="submit", data-role-modal-save) Guardar rol y perfil
        script(src="/js/session-timeout.js", defer)
        script(src="/js/admin-users.js", defer)
