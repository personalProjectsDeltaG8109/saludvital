mixin adminSidebar(activePage)
    button.admin-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-admin-close)
    aside#admin-sidebar.admin-sidebar(data-admin-sidebar)
        .admin-brand
            a(href="/admin/dashboard", aria-label="SaludVital, panel administrativo")
                img(src="/brand/logo-symbol.png", alt="")
                span
                    strong SaludVital
                    small Panel Administrativo
            button.admin-sidebar-collapse(
                type="button",
                aria-label="Cerrar menú",
                data-admin-close
            ) ×
        nav.admin-navigation(aria-label="Navegación administrativa")
            a.admin-nav-link(
                href="/admin/dashboard",
                class=activePage === "dashboard" ? "is-active" : null,
                aria-current=activePage === "dashboard" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/home.png", alt="")
                span Inicio
            .admin-nav-section Gestión médica
            a.admin-nav-link(
                href="/admin/users",
                class=activePage === "users" ? "is-active" : null,
                aria-current=activePage === "users" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/users-roles.png", alt="")
                span Usuarios y roles
            a.admin-nav-link(
                href="/admin/doctors",
                class=activePage === "doctors" ? "is-active" : null,
                aria-current=activePage === "doctors" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/doctors.png", alt="")
                span Médicos
            a.admin-nav-link(
                href="/admin/specialties",
                class=activePage === "specialties" ? "is-active" : null,
                aria-current=activePage === "specialties" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/specialties.png", alt="")
                span Especialidades
            a.admin-nav-link(
                href="/admin/appointments",
                class=activePage === "appointments" ? "is-active" : null,
                aria-current=activePage === "appointments" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/appointments.png", alt="")
                span Citas médicas
            a.admin-nav-link(
                href="/admin/doctor-schedules",
                class=activePage === "schedules" ? "is-active" : null,
                aria-current=activePage === "schedules" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/schedules.png", alt="")
                span Horarios y disponibilidad
            .admin-nav-section Canales y comunicación
            a.admin-nav-link(
                href="/admin/whatsapp",
                class=activePage === "whatsapp" ? "is-active" : null,
                aria-current=activePage === "whatsapp" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/whatsapp-chatbot.png", alt="")
                span WhatsApp y chatbot
            a.admin-nav-link(
                href="/admin/notifications",
                class=activePage === "notifications" ? "is-active" : null,
                aria-current=activePage === "notifications" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/notifications.png", alt="")
                span Notificaciones
            .admin-nav-section.admin-nav-section-small Control y seguimiento
            a.admin-nav-link(
                href="/admin/audit",
                class=activePage === "audit" ? "is-active" : null,
                aria-current=activePage === "audit" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/audit.png", alt="")
                span Auditoría
            a.admin-nav-link(
                href="/admin/reports",
                class=activePage === "reports" ? "is-active" : null,
                aria-current=activePage === "reports" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/reports.png", alt="")
                span Reportes e indicadores
            a.admin-nav-link(
                href="/admin/profile",
                class=activePage === "profile" ? "is-active" : null,
                aria-current=activePage === "profile" ? "page" : null
            )
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/profile.png", alt="")
                span Mi perfil
        form.admin-logout(action="/logout", method="POST")
            button.admin-nav-link(type="submit")
                span.admin-nav-icon(aria-hidden="true")
                    img(src="/brand/admin-sidebar-icons/logout.png", alt="")
                span Cerrar sesión

        include ../../shared/partials/logout-confirmation.pug

mixin adminTopbar(notificationHref, notificationLabel, notificationCount)
    header.admin-topbar(data-admin-topbar)
        button.admin-menu-toggle(
            type="button",
            aria-label="Abrir menú",
            aria-expanded="false",
            aria-controls="admin-sidebar",
            data-admin-open
        )
            span
            span
            span
        a.admin-mobile-brand(
            href="/admin/dashboard",
            aria-label="SaludVital, panel administrativo"
        )
            img(src="/brand/logo-symbol.png", alt="")
            span
                strong SaludVital
                small Panel Administrativo
        a.admin-notification-button.admin-mobile-notification(
            href=notificationHref || "/admin/notifications",
            aria-label=notificationLabel || "Ver el panel de notificaciones"
        )
            svg(
                viewBox="0 0 24 24",
                fill="none",
                stroke="currentColor",
                stroke-width="1.8",
                stroke-linecap="round",
                stroke-linejoin="round",
                aria-hidden="true"
            )
                path(d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9")
                path(d="M10 21h4")
            if notificationCount
                b= notificationCount
        .admin-user-chip
            span.admin-user-avatar(aria-hidden="true")
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8")
                    circle(cx="12", cy="8", r="3.2")
                    path(d="M5 21v-1.2a7 7 0 0 1 14 0V21z")
                if adminPhotoUrl
                    img(src=adminPhotoUrl, alt="")
            span
                strong= adminHeaderName || adminName
                small= adminHeaderRole || "Administrador"
