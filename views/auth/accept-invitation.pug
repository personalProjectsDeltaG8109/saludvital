doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        meta(name="referrer", content="no-referrer")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
    body.login-page.registration-page.min-h-screen.text-primary.antialiased(
        class=invitation && invitation.accountType === "doctor" ? "doctor-onboarding-page" : ""
    )
        main.registration-shell
            .registration-layout
                include ./partials/login-desktop
                section.registration-panel(aria-labelledby="invitation-title")
                    include ./partials/login-mobile
                    .registration-card(
                        class=invitation && invitation.accountType === "doctor" ? "doctor-onboarding-card" : ""
                    )
                        if invitation
                            .mb-5.flex.items-center.gap-3.rounded-2xl.border.border-sky-100.bg-sky-50.p-4(
                                class=invitation.accountType === "doctor" ? "doctor-onboarding-banner" : ""
                            )
                                span.grid.h-11.w-11.shrink-0.place-items-center.rounded-xl.bg-white.text-sky-700.shadow-sm(
                                    aria-hidden="true"
                                )
                                    if invitation.accountType === "administrator"
                                        svg(
                                            width="24",
                                            height="24",
                                            viewBox="0 0 24 24",
                                            fill="none",
                                            stroke="currentColor",
                                            stroke-width="1.8",
                                            stroke-linecap="round",
                                            stroke-linejoin="round"
                                        )
                                            path(
                                                d="M12 3 4.5 6v5.5c0 4.6 3.2 7.6 7.5 9.5 4.3-1.9 7.5-4.9 7.5-9.5V6L12 3Z"
                                            )
                                            path(d="m9 12 2 2 4-4")
                                    else
                                        svg(
                                            width="24",
                                            height="24",
                                            viewBox="0 0 24 24",
                                            fill="none",
                                            stroke="currentColor",
                                            stroke-width="1.8",
                                            stroke-linecap="round",
                                            stroke-linejoin="round"
                                        )
                                            path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                                            circle(cx="12", cy="7", r="4")
                                div
                                    p.m-0.text-sm.font-bold.text-primary Invitación de SaludVital
                                    p.m-0.mt-1.text-xs.text-slate-600= invitation.accountType === "administrator" ? "Cuenta de administrador" : invitation.accountType === "doctor" ? "Perfil de médico" : "Cuenta de paciente"

                        h1#invitation-title(
                            class=["text-2xl", "font-bold", "tracking-tight", "text-primary", "sm:text-3xl", invitation && invitation.accountType === "doctor" ? "doctor-onboarding-title" : ""]
                        )
                            if invitation
                                | #{ invitation.accountType === "doctor" ? "Completa tu perfil profesional" : "Completa tu registro" }
                            else
                                | Invitación no disponible
                        p.mt-2.text-sm.leading-6.text-slate-600
                            if invitation
                                | #{ invitation.accountType === "doctor" ? "Completa tus datos para que el equipo de SaludVital revise tu perfil antes de activar la cuenta." : "Confirma los datos de tu cuenta y crea una contraseña para continuar." }
                            else
                                | Solicita al administrador que revise el enlace y te envíe una nueva invitación.

                        if error
                            p.mt-4.rounded-xl.border.border-red-200.bg-red-50.p-3.text-sm.text-red-800(
                                role="alert"
                            )= error

                        if invitation
                            .mt-4.rounded-xl.border.border-slate-200.bg-white.px-4.py-3
                                p.m-0.text-xs.font-semibold.uppercase.tracking-wide.text-slate-500 Correo invitado
                                p.m-0.mt-1.break-all.text-sm.font-semibold.text-primary= invitation.email

                            form.mt-5.space-y-5(action="/accept-invitation", method="POST")
                                input(type="hidden", name="token", value=token)
                                if invitation.accountType === "patient"
                                    fieldset.space-y-4
                                        legend.mb-3.text-lg.font-semibold.text-primary Datos personales
                                        .grid.grid-cols-1.gap-4(class="sm:grid-cols-2")
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="first_name"
                                                ) Nombres
                                                input#first_name.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="text",
                                                    name="first_name",
                                                    autocomplete="given-name",
                                                    maxlength="50",
                                                    value=formData.first_name || "",
                                                    required
                                                )
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="last_name"
                                                ) Apellidos
                                                input#last_name.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="text",
                                                    name="last_name",
                                                    autocomplete="family-name",
                                                    maxlength="50",
                                                    value=formData.last_name || "",
                                                    required
                                                )
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="document_type"
                                                ) Tipo de documento
                                                select#document_type.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    name="document_type",
                                                    required
                                                )
                                                    option(value="") Selecciona una opción
                                                    option(
                                                        value="CC",
                                                        selected=formData.document_type === "CC"
                                                    ) Cédula de ciudadanía
                                                    option(
                                                        value="CE",
                                                        selected=formData.document_type === "CE"
                                                    ) Cédula de extranjería
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="document_number"
                                                ) Número de documento
                                                input#document_number.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="text",
                                                    name="document_number",
                                                    maxlength="15",
                                                    inputmode="numeric",
                                                    pattern="[0-9]{1,15}",
                                                    value=formData.document_number || "",
                                                    required
                                                )
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="date_of_birth"
                                                ) Fecha de nacimiento
                                                input#date_of_birth.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="date",
                                                    name="date_of_birth",
                                                    autocomplete="bday",
                                                    value=formData.date_of_birth || "",
                                                    required
                                                )
                                            div
                                                label.mb-2.block.text-sm.font-semibold(for="phone") Teléfono
                                                input#phone.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="tel",
                                                    name="phone",
                                                    autocomplete="tel",
                                                    maxlength="15",
                                                    inputmode="numeric",
                                                    pattern="[0-9]{7,15}",
                                                    value=formData.phone || "",
                                                    required
                                                )
                                    fieldset.space-y-4
                                        legend.mb-3.text-lg.font-semibold.text-primary Contacto y ubicación
                                        .grid.grid-cols-1.gap-4(class="sm:grid-cols-2")
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="department"
                                                ) Departamento
                                                select#department.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    name="department",
                                                    required
                                                )
                                                    option(value="", selected, disabled) Selecciona un departamento
                                            div
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="municipality"
                                                ) Municipio
                                                select#municipality.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    name="municipality",
                                                    required,
                                                    disabled
                                                )
                                                    option(value="", selected, disabled) Primero selecciona un departamento
                                            div(class="sm:col-span-2")
                                                label.mb-2.block.text-sm.font-semibold(
                                                    for="address"
                                                ) Dirección (opcional)
                                                input#address.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                    type="text",
                                                    name="address",
                                                    autocomplete="street-address",
                                                    maxlength="150",
                                                    value=formData.address || ""
                                                )
                                    fieldset.space-y-4
                                        legend.mb-3.text-lg.font-semibold.text-primary Información de salud (opcional)
                                        div
                                            label.mb-2.block.text-sm.font-semibold(
                                                for="blood_type"
                                            ) Grupo sanguíneo
                                            select#blood_type.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                name="blood_type"
                                            )
                                                option(value="") No lo sé / Prefiero no indicarlo
                                                each bloodType in ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
                                                    option(
                                                        value=bloodType,
                                                        selected=formData.blood_type === bloodType
                                                    )= bloodType
                                        div
                                            label.mb-2.block.text-sm.font-semibold(for="allergies") Alergias conocidas
                                            textarea#allergies.block.min-h-20.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                name="allergies",
                                                maxlength="255",
                                                rows="2"
                                            )= formData.allergies || ""
                                        div
                                            label.mb-2.block.text-sm.font-semibold(
                                                for="medical_conditions"
                                            ) Condiciones médicas
                                            textarea#medical_conditions.block.min-h-20.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                name="medical_conditions",
                                                maxlength="255",
                                                rows="2"
                                            )= formData.medical_conditions || ""
                                else if invitation.accountType === "doctor"
                                    if invitation.isCorrection
                                        .doctor-onboarding-correction(role="note")
                                            span.doctor-onboarding-correction-icon(
                                                aria-hidden="true"
                                            )
                                                svg(
                                                    viewBox="0 0 24 24",
                                                    fill="none",
                                                    stroke="currentColor",
                                                    stroke-width="1.8",
                                                    stroke-linecap="round",
                                                    stroke-linejoin="round"
                                                )
                                                    path(d="M12 9v4")
                                                    path(d="M12 17h.01")
                                                    path(
                                                        d="M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3l-7.5-13.1a2 2 0 0 0-3.4 0Z"
                                                    )
                                            div
                                                strong Correcciones solicitadas
                                                p.m-0.mt-1= invitation.reviewNote
                                    fieldset.doctor-onboarding-section
                                        legend Datos personales
                                        .doctor-onboarding-grid
                                            div
                                                label.doctor-onboarding-label(for="first_name") Nombres
                                                input#first_name.doctor-onboarding-control(
                                                    type="text",
                                                    name="first_name",
                                                    autocomplete="given-name",
                                                    maxlength="80",
                                                    value=formData.first_name || invitation.profile.first_name,
                                                    required
                                                )
                                            div
                                                label.doctor-onboarding-label(for="last_name") Apellidos
                                                input#last_name.doctor-onboarding-control(
                                                    type="text",
                                                    name="last_name",
                                                    autocomplete="family-name",
                                                    maxlength="80",
                                                    value=formData.last_name || invitation.profile.last_name,
                                                    required
                                                )
                                            div
                                                label.doctor-onboarding-label(for="document_type") Tipo de documento
                                                select#document_type.doctor-onboarding-control(
                                                    name="document_type",
                                                    required
                                                )
                                                    option(value="") Selecciona una opción
                                                    option(
                                                        value="CC",
                                                        selected=(formData.document_type || invitation.profile.document_type) === "CC"
                                                    ) Cédula de ciudadanía
                                                    option(
                                                        value="CE",
                                                        selected=(formData.document_type || invitation.profile.document_type) === "CE"
                                                    ) Cédula de extranjería
                                            div
                                                label.doctor-onboarding-label(
                                                    for="document_number"
                                                ) Número de documento
                                                input#document_number.doctor-onboarding-control(
                                                    type="text",
                                                    name="document_number",
                                                    maxlength="15",
                                                    inputmode="numeric",
                                                    pattern="[0-9]{1,15}",
                                                    value=formData.document_number || invitation.profile.document_number,
                                                    required
                                                )
                                            div
                                                label.doctor-onboarding-label(for="phone") Celular
                                                input#phone.doctor-onboarding-control(
                                                    type="tel",
                                                    name="phone",
                                                    autocomplete="tel",
                                                    maxlength="15",
                                                    inputmode="numeric",
                                                    pattern="[0-9]{7,15}",
                                                    value=formData.phone || invitation.profile.phone,
                                                    required
                                                )
                                    fieldset.doctor-onboarding-section
                                        legend Información profesional
                                        .doctor-onboarding-grid
                                            div
                                                label.doctor-onboarding-label(
                                                    for="professional_registration_number"
                                                ) Tarjeta profesional
                                                input#professional_registration_number.doctor-onboarding-control(
                                                    type="text",
                                                    name="professional_registration_number",
                                                    maxlength="40",
                                                    pattern="[A-Za-z0-9./-]{3,40}",
                                                    value=formData.professional_registration_number || invitation.profile.professional_registration_number,
                                                    required
                                                )
                                            .doctor-onboarding-specialty
                                                span.doctor-onboarding-specialty-icon(
                                                    aria-hidden="true"
                                                )
                                                    svg(
                                                        viewBox="0 0 24 24",
                                                        fill="none",
                                                        stroke="currentColor",
                                                        stroke-width="1.8",
                                                        stroke-linecap="round",
                                                        stroke-linejoin="round"
                                                    )
                                                        path(d="M12 3v4")
                                                        path(d="M8 7h8")
                                                        path(d="M7 7v4a5 5 0 0 0 10 0V7")
                                                        path(d="M12 16v5")
                                                        path(d="M9 21h6")
                                                div
                                                    span.doctor-onboarding-field-caption Especialidad asignada
                                                    strong= invitation.specialtyName
                                    p.doctor-onboarding-review-note El administrador revisará tus datos antes de activar tu cuenta.
                                else
                                    fieldset.space-y-4
                                        legend.mb-3.text-lg.font-semibold.text-primary Datos de administrador
                                        div
                                            label.mb-2.block.text-sm.font-semibold(
                                                for="display_name"
                                            ) Nombre completo
                                            input#display_name.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900(
                                                type="text",
                                                name="display_name",
                                                autocomplete="name",
                                                maxlength="120",
                                                value=formData.display_name || invitation.displayName,
                                                required
                                            )

                                fieldset(
                                    class=invitation.accountType === "doctor" ? "doctor-onboarding-section" : "space-y-4"
                                )
                                    legend(
                                        class=invitation.accountType === "doctor" ? "" : "mb-3 text-lg font-semibold text-primary"
                                    ) Seguridad de la cuenta
                                    div
                                        label(
                                            class=invitation.accountType === "doctor" ? "doctor-onboarding-label" : "mb-2 block text-sm font-semibold",
                                            for="password"
                                        ) Crea una contraseña
                                        input#password(
                                            class=invitation.accountType === "doctor" ? "doctor-onboarding-control" : "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-900",
                                            type="password",
                                            name="password",
                                            autocomplete="new-password",
                                            minlength="10",
                                            maxlength="50",
                                            required
                                        )
                                        p.mt-1.text-xs.leading-5.text-slate-500 Usa entre 10 y 50 caracteres, con mayúscula, minúsculas, número y carácter especial.
                                        .mt-3(aria-live="polite")
                                            .h-2.w-full.overflow-hidden.rounded-full.bg-slate-200
                                                #password-strength-bar.h-full.w-0.rounded-full.transition-all.duration-300
                                            p#password-strength-text.mt-1.text-xs.text-slate-500 Escribe una contraseña
                                    div
                                        label(
                                            class=invitation.accountType === "doctor" ? "doctor-onboarding-label" : "mb-2 block text-sm font-semibold",
                                            for="password_confirmation"
                                        ) Confirma tu contraseña
                                        input#password_confirmation(
                                            class=invitation.accountType === "doctor" ? "doctor-onboarding-control" : "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-900",
                                            type="password",
                                            name="password_confirmation",
                                            autocomplete="new-password",
                                            minlength="10",
                                            maxlength="50",
                                            required
                                        )
                                        p#password-match-message.mt-2.text-sm(
                                            role="status",
                                            aria-live="polite"
                                        )
                                if invitation.accountType === "patient"
                                    div
                                        label.flex.items-start.gap-3.text-sm.leading-5.text-slate-600(
                                            for="health_data_consent"
                                        )
                                            input#health_data_consent.mt-1.h-4.w-4.rounded.border-slate-300(
                                                type="checkbox",
                                                name="health_data_consent",
                                                value="accepted",
                                                required
                                            )
                                            span Autorizo el tratamiento de mis datos personales y de salud para recibir los servicios de SaludVital.
                                    p.ml-7.mt-2.text-xs.leading-5.text-slate-500
                                        | Lee nuestra
                                        a.ml-1.font-semibold.text-primary.underline(
                                            href="/privacy"
                                        ) política de privacidad
                                        |
                                        | antes de aceptar.
                                button(
                                    class=invitation.accountType === "doctor" ? "doctor-onboarding-submit" : "flex w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 font-semibold text-white shadow-md transition",
                                    type="submit"
                                )
                                    | #{ invitation.accountType === "doctor" ? "Enviar perfil a revisión" : "Activar mi cuenta" }
                                    svg(
                                        width="18",
                                        height="18",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="2",
                                        stroke-linecap="round",
                                        stroke-linejoin="round",
                                        aria-hidden="true"
                                    )
                                        path(d="M5 12h14")
                                        path(d="m12 5 7 7-7 7")
                            p(
                                class=invitation.accountType === "doctor" ? "doctor-onboarding-footnote" : "mt-4 text-center text-xs leading-5 text-slate-500"
                            )
                                if invitation.accountType === "doctor"
                                    | Al enviar tu perfil, quedará pendiente de revisión. Recibirás una respuesta cuando el administrador lo revise.
                                else
                                    | La cuenta se activa después de enviar este formulario. No se crea una contraseña hasta que tú la eliges.
                        else
                            a.mt-5.flex.w-full.items-center.justify-center.rounded-full.border.border-secondary.bg-white.px-4.py-3.font-semibold.text-primary.transition(
                                href="/login"
                            ) Volver a iniciar sesión

        if whatsappContactUrl
            aside.whatsapp-widget(aria-label="Contacto por WhatsApp")
                a.whatsapp-float(
                    href=whatsappContactUrl,
                    target="_blank",
                    rel="noopener noreferrer",
                    aria-label="Contactar a SaludVital por WhatsApp",
                    title="Escríbenos por WhatsApp"
                )
                    img(
                        src="/brand/whatsapp-svgrepo-com.svg",
                        alt="",
                        aria-hidden="true",
                        width="32",
                        height="32"
                    )
    if invitation && invitation.accountType === "patient"
        script(src="/js/registration-locations.js", defer)
    if invitation
        script(src="/js/registration-form.js", defer)
