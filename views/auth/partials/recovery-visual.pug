section.recovery-visual(aria-label="SaludVital, tu salud en buenas manos")
    a.recovery-brand(href="/login", aria-label="SaludVital, volver al inicio de sesión")
        img(src="/brand/login/logo-login-mobile.png", alt="SaludVital", width="300", height="100")
    .recovery-visual-copy
        p.recovery-eyebrow Recupera el acceso a tu cuenta
        h2 Tu salud,
            br
            span en buenas manos.
        p Gestiona tus citas médicas de forma segura y sencilla.
        .login-benefits.recovery-benefits(aria-label="Beneficios de SaludVital")
            .login-benefit
                span.login-benefit-icon(aria-hidden="true")
                    img(src="/brand/calendar-svgrepo-com.svg", alt="")
                .login-benefit-copy
                    strong Agenda tus citas
                    span de forma fácil.
            .login-benefit
                span.login-benefit-icon(aria-hidden="true")
                    svg(
                        viewBox="0 0 24 24",
                        fill="none",
                        stroke="currentColor",
                        stroke-width="1.8"
                    )
                        path(d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9")
                        path(d="M10 21h4")
                .login-benefit-copy
                    strong Recibe recordatorios
                    span y notificaciones.
            .login-benefit
                span.login-benefit-icon(aria-hidden="true")
                    svg(
                        viewBox="0 0 24 24",
                        fill="none",
                        stroke="currentColor",
                        stroke-width="1.8"
                    )
                        path(
                            d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
                        )
                        path(d="M3 12h5l2-3 3 6 2-3h6")
                .login-benefit-copy
                    strong Tu salud siempre
                    span en buenas manos.
    img.recovery-doctor(
        src="/brand/login/girl.png",
        alt="",
        aria-hidden="true",
        width="600",
        height="400"
    )
