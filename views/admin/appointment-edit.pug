doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#063f79")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-appointments.css")
    body.admin-app
        include partials/admin-shell.pug
        +adminSidebar("appointments")
        .admin-main-shell
            +adminTopbar(
                "/admin/appointments",
                "Buscar pacientes por nombre, documento o teléfono...",
            )
            main.admin-appointment-edit-page(
                data-admin-appointment-edit,
                data-appointment-id=appointment.id,
                data-patient-id=appointment.patient.id,
                data-current-specialty-id=appointment.specialty.id,
                data-current-doctor-id=appointment.doctor.id,
                data-doctors-endpoint="/api/admin/appointment-edit/doctors",
                data-specialties-endpoint="/api/admin/appointment-edit/specialties",
                data-availability-endpoint="/api/admin/appointment-booking/availability",
                data-update-endpoint=`/api/admin/appointments/${appointment.id}/reschedule`
            )
                a.appointment-details-back(href=`/admin/appointments/${appointment.id}`)
                    span(aria-hidden="true") ‹
                    | Volver al detalle
                header.appointments-heading
                    span.appointments-heading-icon(aria-hidden="true")
                        svg(
                            viewBox="0 0 24 24",
                            fill="none",
                            stroke="currentColor",
                            stroke-width="1.8",
                            stroke-linecap="round",
                            stroke-linejoin="round"
                        )
                            rect(x="3", y="5", width="18", height="16", rx="2")
                            path(d="M16 3v4M8 3v4M3 10h18")
                            path(d="m16 14 4 4m0-4-4 4")
                    div
                        h1 Editar y reprogramar cita
                        p Actualiza la asignación y el horario de la cita.
                section.appointment-edit-summary(aria-label="Información actual de la cita")
                    div
                        span Número de cita
                        strong= `#${appointment.id}`
                    div
                        span Paciente
                        strong= appointment.patient.name
                    div
                        span Especialidad actual
                        strong= appointment.specialty.name
                    div
                        span Médico actual
                        strong= appointment.doctor.name
                    div
                        span Fecha y hora actual
                        strong= `${appointment.currentDateLabel} · ${appointment.currentTime}`
                    span.appointment-status-badge.status-confirmed= appointment.statusLabel
                if appointment.canEdit
                    form.appointment-edit-form(data-appointment-edit-form)
                        p.appointment-edit-feedback(
                            role="status",
                            aria-live="polite",
                            data-edit-feedback
                        )
                            | Consultando las opciones disponibles...
                        p.appointment-edit-error(role="alert", data-edit-error, hidden)
                        .appointment-edit-grid
                            label.appointment-edit-field(for="edit-specialty")
                                span Especialidad
                                select#edit-specialty(
                                    name="specialtyId",
                                    required,
                                    data-edit-specialty
                                )
                                    option(value="") Cargando especialidades...
                            label.appointment-edit-field(for="edit-doctor")
                                span Médico
                                select#edit-doctor(name="doctorId", required, data-edit-doctor)
                                    option(value="") Selecciona una especialidad primero
                            label.appointment-edit-field(for="edit-date")
                                span Nueva fecha
                                input#edit-date(
                                    type="date",
                                    name="date",
                                    required,
                                    value=appointment.currentDate,
                                    data-edit-date
                                )
                            label.appointment-edit-field(for="edit-time")
                                span Nuevo horario
                                select#edit-time(name="time", required, data-edit-time)
                                    option(value="") Selecciona un horario disponible
                            label.appointment-edit-field.appointment-edit-reason(for="edit-reason")
                                span Motivo de la cita
                                span.appointment-edit-optional Opcional
                                textarea#edit-reason(
                                    name="reason",
                                    rows="4",
                                    maxlength="500",
                                    data-edit-reason
                                )= appointment.reason
                        p.appointment-edit-limit= `Reprogramaciones disponibles: ${appointment.reschedulesRemaining}`
                        footer.appointment-edit-actions
                            a.appointment-create-cancel(
                                href=`/admin/appointments/${appointment.id}`
                            ) Cancelar
                            button.appointment-create-submit(
                                type="submit",
                                data-edit-submit,
                                disabled
                            )
                                | Guardar cambios
                else
                    section.appointment-edit-unavailable(role="status")
                        h2 No es posible editar esta cita
                        p= appointment.unavailableMessage
                        a.appointment-create-submit(href=`/admin/appointments/${appointment.id}`) Volver al detalle
                dialog.appointment-create-success(
                    data-edit-success,
                    aria-labelledby="appointment-edit-success-title"
                )
                    span.appointment-create-success-icon(aria-hidden="true") ✓
                    h2#appointment-edit-success-title ¡Cita actualizada!
                    p(data-edit-success-message) La cita se reprogramó correctamente.
                    a.appointment-create-submit(href="/admin/appointments") Volver al listado
            script(src="/js/admin-dashboard.js", defer)
            script(src="/js/admin-appointment-edit.js", defer)
