//- Shared login form for desktop and mobile layouts.
.w-full
    //- Login heading.
    h1#login-title.text-2xl.font-bold.tracking-tight.text-primary(class="sm:text-3xl")
        | Bienvenido de nuevo

    p.mt-2.text-sm.leading-6.text-slate-600
        | Inicia sesión para acceder a tu cuenta de salud.

    //- Authentication error.
    if error
        p#login-error.mt-4.rounded-xl.border.border-red-200.bg-red-50.p-3.text-sm.text-red-800(
            role="alert"
        )= error

    //- Login form.
    form.mt-10.space-y-5(action="/login", method="POST")
        //- Email field.
        div
            label.mb-2.block.text-sm.font-semibold.text-primary(for="email") Correo electrónico

            input#email.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900.outline-none.transition(
                class="placeholder:text-slate-400 focus:border-secondary focus:ring-2 focus:ring-secondary/20",
                type="email",
                name="email",
                autocomplete="username",
                maxlength="80",
                placeholder="Ingresa tu correo electrónico",
                required,
                aria-describedby=error ? "login-error" : undefined
            )

        //- Password field.
        div
            .mb-2.flex.flex-wrap.items-center.justify-between.gap-2
                label.block.text-sm.font-semibold.text-primary(for="password") Contraseña

                a.text-sm.font-semibold.text-primary(class="hover:underline", href="/forgot-password") ¿Olvidaste tu contraseña?

            input#password.block.w-full.rounded-xl.border.border-slate-300.bg-white.px-4.py-3.text-base.text-slate-900.outline-none.transition(
                class="placeholder:text-slate-400 focus:border-secondary focus:ring-2 focus:ring-secondary/20",
                type="password",
                name="password",
                autocomplete="current-password",
                placeholder="Ingresa tu contraseña",
                required
            )

        //- Centered primary action.
        .flex.justify-center.pt-2
            button.w-full.max-w-xs.rounded-full.bg-primary.px-4.py-2.font-semibold.text-white.shadow-md.transition(
                class="hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2",
                type="submit"
            ) Iniciar sesión

    //- Registration section.
    .mt-7.border-t.border-slate-200.pt-6
        p.text-center.text-sm.text-slate-600
            | ¿Aún no tienes una cuenta?

        a.mx-auto.mt-3.flex.w-full.max-w-xs.items-center.justify-center.rounded-full.border.border-secondary.bg-white.px-4.py-2.font-semibold.text-primary.transition(
            class="hover:bg-sky-50 focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2",
            href="/register"
        ) Crear una cuenta

    //- Security notice.
    p.mt-5.text-center.text-xs.leading-5.text-slate-500
        span.font-semibold.text-primary Acceso seguro
        |
        | · Tu información de salud está protegida.
