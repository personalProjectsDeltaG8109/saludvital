section.login-visual(aria-label="SaludVital, tu salud siempre conectada")
    img.login-visual-background(
        src="/brand/login/background-login.png",
        alt="",
        aria-hidden="true"
    )
    .login-visual-content
        img.login-brand-logo(
            src="/brand/logo-primary.png",
            alt="SaludVital",
            width="300",
            height="100"
        )
        p.login-eyebrow Tu salud, siempre conectada
        h2 Tu bienestar es nuestra prioridad.
        p.login-intro Gestiona tus citas médicas y mantente en contacto con tu equipo de salud desde un solo lugar.
        img.login-doctor-illustration(
            src="/brand/login/girl.png",
            alt="",
            aria-hidden="true",
            width="600",
            height="400"
        )
        .login-benefits
            p
                span(aria-hidden="true") ✓
                | Agenda tus citas de forma rápida y sencilla.
            p
                span(aria-hidden="true") ✓
                | Recibe recordatorios y mantén tu salud en buenas manos.
