doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        meta(name="description", content=pageDescription)
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/login-footer.css")

    body.legal-page
        header.legal-shell-header
            a.legal-brand(href="/login", aria-label="SaludVital, ir al inicio de sesión")
                img.legal-brand-logo(
                    src="/brand/login/logo-login.png",
                    alt="SaludVital",
                    width="900",
                    height="387"
                )

            nav.legal-nav(aria-label="Páginas de información")
                a(
                    class=activeLegalPage === "privacy" ? "is-active" : "",
                    href="/privacy",
                    aria-current=activeLegalPage === "privacy" ? "page" : undefined
                ) Privacidad
                a(
                    class=activeLegalPage === "terms" ? "is-active" : "",
                    href="/terms",
                    aria-current=activeLegalPage === "terms" ? "page" : undefined
                ) Términos
                a(
                    class=activeLegalPage === "help" ? "is-active" : "",
                    href="/help",
                    aria-current=activeLegalPage === "help" ? "page" : undefined
                ) Ayuda

            a.legal-login-button(href="/login") Iniciar sesión

        main.legal-main(aria-label="Información de SaludVital")
            .legal-breadcrumb(aria-label="Ruta de navegación")
                a(href="/login") Inicio
                span(aria-hidden="true") /
                span(aria-current="page")= pageHeading

            header.legal-page-heading
                .legal-heading-copy
                    p.legal-eyebrow= pageEyebrow
                    h1#legal-page-title= pageHeading
                    p= pageDescription
                if pageMeta
                    .legal-page-meta
                        span.legal-meta-dot(aria-hidden="true")
                        span= pageMeta

            .legal-document-body
                block legalBody

        include ../auth/partials/footer/public-footer
