doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/doctor-dashboard.css")
    body.sv-dashboard.doctor-home-page.patient-home-page
        .sv-layout
            include ./partials/sidebar.pug
            button.sv-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main
                include ./partials/topbar.pug
                main.doctor-content
                    section.doctor-hero(aria-labelledby="doctor-hero-title")
                        .doctor-hero-copy
                            p.doctor-eyebrow Tu agenda
                            h2#doctor-hero-title Tu jornada médica de hoy
                            p Consulta tus citas y revisa lo que viene en tu día.
                        img.doctor-hero-image(src="/brand/patient/banner-home-patient.png", alt="Ilustración de un médico preparando su agenda")

                    section.doctor-metrics(aria-label="Resumen de actividad")
                        a.doctor-metric-card.metric-blue(href="/doctor/appointments", aria-label=`Citas de hoy: ${metrics.appointmentsToday}. Abrir agenda.`)
                            span.metric-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h2m3 0h2")
                            span.metric-copy
                                strong= metrics.appointmentsToday
                                span Citas de hoy
                            span.metric-card-hint Abrir agenda →
                        a.doctor-metric-card.metric-green(href="/doctor/patients", aria-label=`Pacientes activos: ${metrics.activePatients}. Abrir pacientes.`)
                            span.metric-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-3a4 4 0 0 1 0 7m3 6v-2a4 4 0 0 0-3-3.87")
                            span.metric-copy
                                strong= metrics.activePatients
                                span Pacientes activos
                            span.metric-card-hint Abrir pacientes →
                        article.doctor-metric-card.metric-purple
                            span.metric-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(d="M7 3h8l4 4v14H5V3h2Zm7 0v5h5M8 12h8m-8 4h8")
                            span.metric-copy
                                strong= metrics.consultationsThisWeek
                                span Consultas esta semana
                        article.doctor-metric-card.metric-orange
                            span.metric-icon(aria-hidden="true")
                                svg(viewBox="0 0 24 24")
                                    path(d="M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM12 2v2m10 8h-2")
                            span.metric-copy
                                strong= averageDurationLabel
                                span Tiempo promedio

                    .doctor-dashboard-grid
                        section.doctor-panel.doctor-today(aria-labelledby="today-title")
                            .doctor-panel-heading
                                div
                                    h2#today-title Citas de hoy
                                a.doctor-panel-action(href="/doctor/agenda") Ver agenda
                            if todayAppointments.length
                                ul.doctor-appointment-list
                                    each appointment in todayAppointments
                                        li.doctor-appointment-row(
                                            id=`appointment-${appointment.id}`,
                                            class=appointment.patientPhotoUrl ? null : "without-photo"
                                        )
                                            time.doctor-appointment-time(datetime=appointment.startAt.toISOString())
                                                strong= appointment.time
                                                small= appointment.meridiem
                                            .doctor-patient-summary
                                                if appointment.patientPhotoUrl
                                                    span.doctor-patient-avatar(aria-hidden="true")
                                                        img(src=appointment.patientPhotoUrl, alt="", loading="lazy")
                                                else
                                                    span.doctor-patient-avatar(aria-hidden="true")= appointment.patientName.split(" ").map((name) => name.charAt(0)).slice(0, 2).join("").toUpperCase()
                                                span.doctor-appointment-info
                                                    strong= appointment.patientName
                                                    small= appointment.reason || "Consulta médica"
                                            span.doctor-status(class=`status-${appointment.statusKey}`)= appointment.statusLabel
                                            if appointment.status !== "Cancelled"
                                                a.doctor-row-link(href=`/doctor/agenda#appointment-${appointment.id}`, aria-label=`Iniciar consulta con ${appointment.patientName}`) Iniciar consulta
                            else
                                .doctor-empty-state
                                    span.doctor-empty-icon(aria-hidden="true") ▦
                                    strong No tienes citas programadas para hoy
                                    p Cuando tengas una cita, aparecerá aquí.

                        section.doctor-panel.doctor-next(aria-labelledby="next-title")
                            .doctor-panel-heading
                                h2#next-title Próxima cita
                                a.doctor-panel-action(href="/doctor/agenda") Ver agenda
                            if nextAppointment
                                .doctor-next-card
                                    .doctor-next-date(aria-label=nextAppointment.dateLabel)
                                        strong= nextAppointment.day
                                        span= nextAppointment.month
                                    .doctor-next-details
                                        .doctor-next-meta
                                            strong.doctor-next-time= `${nextAppointment.time} ${nextAppointment.meridiem}`
                                            span.doctor-status(class=`status-${nextAppointment.statusKey}`)= nextAppointment.statusLabel
                                        .doctor-next-identity
                                            if nextAppointment.patientPhotoUrl
                                                span.doctor-patient-avatar.doctor-next-avatar(aria-hidden="true")
                                                    img(src=nextAppointment.patientPhotoUrl, alt="", loading="lazy")
                                            else
                                                span.doctor-patient-avatar.doctor-next-avatar(aria-hidden="true")= nextAppointment.patientName.split(" ").map((name) => name.charAt(0)).slice(0, 2).join("").toUpperCase()
                                            .doctor-next-info
                                                strong= nextAppointment.patientName
                                                span= nextAppointment.reason || "Consulta médica"
                                        .doctor-next-contact
                                            span
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 21a7 7 0 0 1 14 0")
                                                = nextAppointment.patientAge === null ? "Edad no disponible" : `${nextAppointment.patientAge} años`
                                            span
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 3.2 2 2 0 0 1 4.11 1h3a2 2 0 0 1 2 1.72c.12.9.34 1.78.65 2.62a2 2 0 0 1-.45 2.11L8.04 8.72a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.84.31 1.72.53 2.62.65a2 2 0 0 1 1.96 2.27Z")
                                                = nextAppointment.patientPhone || "Teléfono no registrado"
                                            span
                                                svg(viewBox="0 0 24 24", aria-hidden="true")
                                                    path(d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 2-10 7L2 6")
                                                = nextAppointment.patientEmail || "Correo no registrado"
                                    a.doctor-primary-link(href=`/doctor/agenda#appointment-${nextAppointment.id}`) Iniciar consulta
                            else
                                .doctor-empty-state.doctor-next-empty
                                    span.doctor-empty-icon(aria-hidden="true") ◷
                                    strong No tienes próximas citas
                                    p Las próximas citas aparecerán aquí.

                include ./partials/bottom-nav.pug
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-sidebar.js", defer)
