doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#063f79")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/admin-dashboard.css")
        link(rel="stylesheet", href="/css/admin-whatsapp.css")
    body.admin-app(
        data-whatsapp-page,
        data-whatsapp-endpoint="/api/admin/whatsapp",
        data-selected-tab=whatsapp.selectedTab,
        data-current-page=whatsapp.pagination.page,
        data-activity-period=whatsapp.activityPeriodDays,
        data-search=whatsapp.search,
        data-status=whatsapp.status,
        data-request-search=whatsapp.requestFilters && whatsapp.requestFilters.search,
        data-request-status=whatsapp.requestFilters && whatsapp.requestFilters.status,
        data-request-specialty=whatsapp.requestFilters && whatsapp.requestFilters.specialtyId,
        data-request-date-from=whatsapp.requestFilters && whatsapp.requestFilters.dateFrom,
        data-request-date-to=whatsapp.requestFilters && whatsapp.requestFilters.dateTo,
        data-delivery-status=whatsapp.deliveryFilters && whatsapp.deliveryFilters.status,
        data-delivery-date-from=whatsapp.deliveryFilters && whatsapp.deliveryFilters.dateFrom,
        data-delivery-date-to=whatsapp.deliveryFilters && whatsapp.deliveryFilters.dateTo
    )
        include partials/admin-shell.pug
        +adminSidebar("whatsapp")
        .admin-main-shell
            header.admin-topbar
                button.admin-menu-toggle(
                    type="button",
                    aria-label="Abrir menú",
                    aria-expanded="false",
                    aria-controls="admin-sidebar",
                    data-admin-open
                )
                    span
                    span
                    span
                a.admin-mobile-brand(
                    href="/admin/dashboard",
                    aria-label="SaludVital, panel administrativo"
                )
                    img(src="/brand/logo-symbol.png", alt="")
                    span
                        strong SaludVital
                        small Panel Administrativo
                form.admin-global-search(role="search", action="/admin/dashboard", method="get")
                    label.sr-only(for="admin-search") Buscar en el panel
                    span(aria-hidden="true") ⌕
                    input#admin-search(
                        type="search",
                        placeholder="Buscar personas, citas, médicos o secciones...",
                        autocomplete="off"
                    )
                a.admin-notification-button(
                    href="/admin/dashboard#admin-notifications-title",
                    aria-label="Ver dashboard y notificaciones"
                )
                    svg(
                        viewBox="0 0 24 24",
                        fill="none",
                        stroke="currentColor",
                        stroke-width="1.8",
                        stroke-linecap="round",
                        stroke-linejoin="round",
                        aria-hidden="true"
                    )
                        path(d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9")
                        path(d="M10 21h4")
                    if whatsapp.notificationAlertCount
                        b= whatsapp.notificationAlertCount
                .admin-user-chip
                    span.admin-user-avatar(aria-hidden="true")
                        svg(
                            viewBox="0 0 24 24",
                            fill="none",
                            stroke="currentColor",
                            stroke-width="1.8"
                        )
                            circle(cx="12", cy="8", r="3.2")
                            path(d="M5 21v-1.2a7 7 0 0 1 14 0V21z")
                    span
                        strong Administrador
                        small SaludVital
                    span.admin-user-chevron(aria-hidden="true") ⌄
            main.admin-dashboard.admin-whatsapp-page
                header.admin-whatsapp-heading
                    span.admin-whatsapp-heading-icon(aria-hidden="true")
                        img(src="/brand/whatsapp-svgrepo-com.svg", alt="")
                    div
                        p.admin-eyebrow Canales y comunicación
                        h1 WhatsApp y chatbot
                        p Gestiona la atención automatizada, las conversaciones y las solicitudes de citas por WhatsApp.
                    button.admin-whatsapp-settings-shortcut(
                        type="button",
                        data-whatsapp-tab-link="settings"
                    )
                        span(aria-hidden="true") ⚙
                        span Configuración e integración
                nav.admin-whatsapp-tabs(role="tablist", aria-label="Secciones de WhatsApp")
                    button#admin-whatsapp-tab-summary.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "summary" || whatsapp.selectedTab === "deliveries" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="summary"
                    ) Resumen
                    button#admin-whatsapp-tab-conversations.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "conversations" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="conversations"
                    ) Conversaciones
                    button#admin-whatsapp-tab-requests.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "requests" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="requests"
                    ) Solicitudes de citas
                    button#admin-whatsapp-tab-flows.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "flows" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="flows"
                    ) Flujos del chatbot
                    button#admin-whatsapp-tab-templates.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "templates" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="templates"
                    ) Plantillas de mensajes
                    button#admin-whatsapp-tab-settings.admin-whatsapp-tab(
                        type="button",
                        role="tab",
                        aria-selected=whatsapp.selectedTab === "settings" ? "true" : "false",
                        aria-controls="admin-whatsapp-panel",
                        data-whatsapp-tab="settings"
                    ) Configuración
                section#admin-whatsapp-panel.admin-whatsapp-panel(
                    class=whatsapp.selectedTab === "summary" ? "is-summary-panel" : "",
                    role="tabpanel",
                    aria-labelledby="admin-whatsapp-tab-" + (whatsapp.selectedTab === "deliveries" ? "summary" : whatsapp.selectedTab),
                    tabindex="0",
                    data-whatsapp-panel
                )
                    if whatsapp.selectedTab === "summary"
                        include partials/admin-whatsapp-summary.pug
                    else if whatsapp.selectedTab === "conversations" || whatsapp.selectedTab === "requests" || whatsapp.selectedTab === "deliveries"
                        header.admin-whatsapp-list-heading
                            div
                                h2= whatsapp.selectedTab === "conversations" ? "Conversaciones recientes" : whatsapp.selectedTab === "requests" ? "Solicitudes de citas" : "Mensajes y estado de envío"
                                p(data-whatsapp-result-count)= whatsapp.pagination.totalItems.toLocaleString("es-CO") + " registros"
                            if whatsapp.selectedTab === "deliveries"
                                a.admin-whatsapp-view-all(
                                    href="/admin/whatsapp",
                                    data-whatsapp-back-summary
                                ) Volver al resumen
                        if whatsapp.selectedTab === "conversations"
                            form.admin-whatsapp-conversation-filters(
                                data-conversation-filters,
                                role="search"
                            )
                                label.admin-whatsapp-search-field(
                                    for="whatsapp-conversation-search"
                                )
                                    span.sr-only Buscar por nombre o número de contacto
                                    input#whatsapp-conversation-search(
                                        type="search",
                                        name="search",
                                        value=whatsapp.search,
                                        maxlength="100",
                                        placeholder="Buscar conversaciones...",
                                        autocomplete="off"
                                    )
                                label.admin-whatsapp-status-filter(
                                    for="whatsapp-conversation-status"
                                )
                                    span.sr-only Filtrar por estado
                                    select#whatsapp-conversation-status(name="status")
                                        option(value="", selected=!whatsapp.status) Todos los estados
                                        option(
                                            value="Active",
                                            selected=whatsapp.status === "Active"
                                        ) Activas
                                        option(
                                            value="Completed",
                                            selected=whatsapp.status === "Completed"
                                        ) Finalizadas
                                        option(
                                            value="Expired",
                                            selected=whatsapp.status === "Expired"
                                        ) Vencidas
                                        option(
                                            value="Blocked",
                                            selected=whatsapp.status === "Blocked"
                                        ) Bloqueadas
                        else if whatsapp.selectedTab === "requests"
                            form.admin-whatsapp-request-filters(data-request-filters)
                                label.admin-whatsapp-search-field(for="whatsapp-request-search")
                                    span.sr-only Buscar por paciente o número de contacto
                                    input#whatsapp-request-search(
                                        type="search",
                                        name="search",
                                        value=whatsapp.requestFilters.search,
                                        maxlength="100",
                                        placeholder="Buscar por nombre o número...",
                                        autocomplete="off"
                                    )
                                label.admin-whatsapp-request-control(for="whatsapp-request-status")
                                    span Estado
                                    select#whatsapp-request-status(name="status")
                                        option(value="", selected=!whatsapp.requestFilters.status) Todos
                                        option(
                                            value="Pending",
                                            selected=whatsapp.requestFilters.status === "Pending"
                                        ) Pendientes
                                        option(
                                            value="Confirmed",
                                            selected=whatsapp.requestFilters.status === "Confirmed"
                                        ) Confirmadas
                                        option(
                                            value="Rejected",
                                            selected=whatsapp.requestFilters.status === "Rejected"
                                        ) Rechazadas
                                        option(
                                            value="Cancelled",
                                            selected=whatsapp.requestFilters.status === "Cancelled"
                                        ) Canceladas
                                        option(
                                            value="Expired",
                                            selected=whatsapp.requestFilters.status === "Expired"
                                        ) Vencidas
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-request-specialty"
                                )
                                    span Especialidad
                                    select#whatsapp-request-specialty(name="specialtyId")
                                        option(
                                            value="",
                                            selected=!whatsapp.requestFilters.specialtyId
                                        ) Todas
                                        each specialty in whatsapp.requestSpecialties
                                            option(
                                                value=specialty.id,
                                                selected=Number(whatsapp.requestFilters.specialtyId) === specialty.id
                                            )= specialty.name
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-request-date-from"
                                )
                                    span Fecha desde
                                    input#whatsapp-request-date-from(
                                        type="date",
                                        name="dateFrom",
                                        value=whatsapp.requestFilters.dateFrom
                                    )
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-request-date-to"
                                )
                                    span Fecha hasta
                                    input#whatsapp-request-date-to(
                                        type="date",
                                        name="dateTo",
                                        value=whatsapp.requestFilters.dateTo
                                    )
                                button.admin-whatsapp-request-submit(type="submit") Buscar
                        else
                            .admin-whatsapp-count-grid(
                                aria-label="Resumen de estados de mensajes WhatsApp"
                            )
                                article.admin-whatsapp-count-card
                                    span Total de mensajes
                                    strong= whatsapp.deliveryTotal.toLocaleString("es-CO")
                                    small Histórico de WhatsApp
                                each item in whatsapp.deliveryStatuses
                                    article.admin-whatsapp-count-card
                                        span= item.label
                                        strong= item.count.toLocaleString("es-CO")
                            form.admin-whatsapp-request-filters(data-delivery-filters)
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-delivery-status"
                                )
                                    span Estado
                                    select#whatsapp-delivery-status(name="status")
                                        option(value="", selected=!whatsapp.deliveryFilters.status) Todos los estados
                                        option(
                                            value="Pending",
                                            selected=whatsapp.deliveryFilters.status === "Pending"
                                        ) Pendiente
                                        option(
                                            value="Processing",
                                            selected=whatsapp.deliveryFilters.status === "Processing"
                                        ) En proceso
                                        option(
                                            value="Sent",
                                            selected=whatsapp.deliveryFilters.status === "Sent"
                                        ) Aceptado por proveedor
                                        option(
                                            value="Failed",
                                            selected=whatsapp.deliveryFilters.status === "Failed"
                                        ) Fallido
                                        option(
                                            value="Cancelled",
                                            selected=whatsapp.deliveryFilters.status === "Cancelled"
                                        ) Cancelado
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-delivery-date-from"
                                )
                                    span Fecha desde
                                    input#whatsapp-delivery-date-from(
                                        type="date",
                                        name="dateFrom",
                                        value=whatsapp.deliveryFilters.dateFrom
                                    )
                                label.admin-whatsapp-request-control(
                                    for="whatsapp-delivery-date-to"
                                )
                                    span Fecha hasta
                                    input#whatsapp-delivery-date-to(
                                        type="date",
                                        name="dateTo",
                                        value=whatsapp.deliveryFilters.dateTo
                                    )
                                button.admin-whatsapp-request-submit(type="submit") Filtrar
                        if whatsapp.rows.length
                            ul.admin-whatsapp-record-list(data-whatsapp-record-list)
                                each record in whatsapp.rows
                                    li
                                        if whatsapp.selectedTab === "conversations"
                                            button.admin-whatsapp-conversation-open(
                                                type="button",
                                                data-conversation-open=record.id,
                                                aria-label="Abrir conversación de " + record.patientName
                                            )
                                                span.admin-message-avatar(aria-hidden="true")= record.patientName.split(" ").map((part) => part.charAt(0)).slice(0, 1).join("").toUpperCase()
                                                span.admin-whatsapp-record-copy
                                                    strong= record.patientName
                                                    small= record.contactNumber || "Número no disponible"
                                                span.admin-whatsapp-record-status(
                                                    class="is-" + record.status.toLowerCase()
                                                )= record.statusLabel
                                                time(datetime=record.lastActivityAt)= new Intl.DateTimeFormat("es-CO", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit", hour12: true, timeZone: "America/Bogota" }).format(new Date(record.lastActivityAt))
                                        else if whatsapp.selectedTab === "requests"
                                            span.admin-message-avatar(aria-hidden="true")= record.patientName.split(" ").map((part) => part.charAt(0)).slice(0, 1).join("").toUpperCase()
                                            span.admin-whatsapp-record-copy
                                                strong= record.patientName
                                                small= record.contactNumber || "Número no disponible"
                                                small= record.specialty || "Especialidad por definir"
                                                if record.updatedAt
                                                    small= "Actualizada: " + new Intl.DateTimeFormat("es-CO", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit", hour12: true, timeZone: "America/Bogota" }).format(new Date(record.updatedAt))
                                            span.admin-whatsapp-record-status(
                                                class="is-" + record.status.toLowerCase()
                                            )= record.statusLabel
                                            time(datetime=record.createdAt)= new Intl.DateTimeFormat("es-CO", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit", hour12: true, timeZone: "America/Bogota" }).format(new Date(record.createdAt))
                                        else
                                            span.admin-message-avatar(aria-hidden="true")= record.recipientName.split(" ").map((part) => part.charAt(0)).slice(0, 1).join("").toUpperCase()
                                            span.admin-whatsapp-record-copy
                                                strong= record.recipientName
                                                small= record.contactNumber || "Número no disponible"
                                                small= record.eventLabel
                                                if record.error
                                                    small.admin-whatsapp-delivery-error= record.error.description + (record.error.code ? " (código " + record.error.code + ")" : "")
                                            span.admin-whatsapp-record-status(
                                                class="is-" + record.status.toLowerCase()
                                            )= record.statusLabel
                                            time(datetime=record.occurredAt)= new Intl.DateTimeFormat("es-CO", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit", hour12: true, timeZone: "America/Bogota" }).format(new Date(record.occurredAt))
                        else
                            p.admin-whatsapp-empty(data-whatsapp-empty) No hay registros para esta sección.
                        .admin-whatsapp-pagination(data-whatsapp-pagination)
                            button(
                                type="button",
                                data-page-previous,
                                disabled=whatsapp.pagination.page <= 1
                            ) Anterior
                            span(data-page-label)= "Página " + whatsapp.pagination.page + " de " + whatsapp.pagination.totalPages
                            button(
                                type="button",
                                data-page-next,
                                disabled=whatsapp.pagination.page >= whatsapp.pagination.totalPages
                            ) Siguiente
                    else if whatsapp.selectedTab === "flows"
                        include partials/admin-whatsapp-flows.pug
                    else if whatsapp.selectedTab === "templates"
                        include partials/admin-whatsapp-templates.pug
                    else if whatsapp.selectedTab === "settings"
                        section.admin-whatsapp-info-card
                            h2 Configuración e integración
                            p El estado describe la configuración local; no verifica conexión con Twilio.
                            dl.admin-whatsapp-configuration-list
                                div
                                    dt Proveedor
                                    dd= whatsapp.integrationConfiguration.provider
                                div
                                    dt Remitente configurado
                                    dd= whatsapp.integrationConfiguration.senderConfigured ? "Sí" : "No"
                                div
                                    dt Credenciales disponibles
                                    dd= whatsapp.integrationConfiguration.credentialsConfigured ? "Sí" : "No"
                                div
                                    dt Conexión con el proveedor
                                    dd Estado no verificado
                                div
                                    dt Chatbot
                                    dd Estado no disponible
                            p No se muestran credenciales y esta vista no modifica la configuración.
                p.admin-whatsapp-feedback(
                    role="status",
                    aria-live="polite",
                    data-whatsapp-feedback
                )
        script(src="/js/session-timeout.js", defer)
        script(src="/js/admin-dashboard.js", defer)
        script(src="/js/admin-whatsapp.js", defer)
