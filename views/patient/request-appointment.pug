doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f2faff")
        title= pageTitle || "Pedir una nueva cita | SaludVital"
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")
        link(rel="stylesheet", href="/css/patient-dashboard.css")
        link(rel="stylesheet", href="/css/patient-appointment.css")
    body.sv-dashboard.booking-page
        .sv-layout
            include partials/sidebar
            button.booking-sidebar-backdrop(type="button", aria-label="Cerrar menú", data-close-sidebar)
            .sv-main.booking-main
                header.booking-header
                    a.booking-mobile-logo(href="/patient/dashboard", aria-label="SaludVital, inicio")
                        picture
                            source(media="(max-width: 760px)", srcset="/brand/patient/logo-primary-background.png")
                            img(src="/brand/logo-primary.png", alt="SaludVital")
                    button.booking-menu-toggle(type="button", aria-label="Abrir menú", aria-expanded="false", aria-controls="patient-sidebar", data-toggle-sidebar)
                        span
                        span
                        span
                    .booking-heading
                        h1 Pedir una nueva cita
                        p Sigue los pasos para agendar tu cita médica de forma rápida y segura.
                    .booking-account
                        a.sv-bell(href="/patient/notifications", aria-label="Notificaciones")
                            svg(viewBox="0 0 24 24", aria-hidden="true")
                                path(d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 12h4")
                            span 2
                        span.booking-avatar(aria-hidden="true") JM
                        span.booking-account-name
                            strong Juan Esteban
                            small Paciente
                        span.booking-account-chevron(aria-hidden="true") ⌄

                main.booking-content
                    ol.booking-stepper(aria-label="Pasos para pedir una cita")
                        li.is-current(data-step-indicator="1")
                            span 1
                            strong Especialidad
                        li(data-step-indicator="2")
                            span 2
                            strong Médico
                        li(data-step-indicator="3")
                            span 3
                            strong Fecha y hora
                        li(data-step-indicator="4")
                            span 4
                            strong Confirmación

                    form#appointment-booking-form.booking-form
                        section.booking-panel.is-active(data-booking-step="1", aria-labelledby="specialty-heading")
                            .booking-panel-heading
                                div
                                    span.booking-section-number 1.
                                    h2#specialty-heading Selecciona la especialidad
                                    p Elige la especialidad que necesitas para tu cita médica.
                                label.booking-search
                                    svg(viewBox="0 0 24 24", aria-hidden="true")
                                        circle(cx="11", cy="11", r="7")
                                        path(d="m20 20-4-4")
                                    input#specialty-search(type="search", placeholder="Buscar especialidad...", autocomplete="off")
                            p.booking-message#specialty-message(role="status") Cargando especialidades...
                            .booking-specialty-grid#specialty-list

                        section.booking-panel(data-booking-step="2", aria-labelledby="doctor-heading")
                            .booking-panel-heading.booking-doctor-heading
                                div
                                    span.booking-section-number 2.
                                    h2#doctor-heading Selecciona el médico
                                    p Elige el profesional con el que deseas agendar tu cita.
                                label.booking-sort
                                    span Ordenar por
                                    select#doctor-sort(aria-label="Ordenar médicos")
                                        option(value="availability") Disponibilidad
                                        option(value="name") Nombre
                            p.booking-message#doctor-message(role="status") Selecciona una especialidad para ver médicos disponibles.
                            .booking-doctor-grid#doctor-list

                        section.booking-panel(data-booking-step="3", aria-labelledby="datetime-heading")
                            .booking-panel-heading
                                div
                                    span.booking-section-number 3.
                                    h2#datetime-heading Selecciona la fecha y hora
                                    p Elige el día y la hora que mejor se adapte a tu disponibilidad.
                            .booking-date-time-grid
                                .booking-calendar
                                    .booking-calendar-heading
                                        button(type="button", aria-label="Mes anterior", data-month-shift="-1") ‹
                                        h3#calendar-month Octubre 2026
                                        button(type="button", aria-label="Mes siguiente", data-month-shift="1") ›
                                    .booking-weekdays(aria-hidden="true")
                                        span Do
                                        span Lu
                                        span Ma
                                        span Mi
                                        span Ju
                                        span Vi
                                        span Sá
                                    .booking-calendar-days#calendar-days
                                .booking-times
                                    h3 Horarios disponibles
                                    p#selected-date-label Selecciona un día para consultar horarios.
                                    p.booking-message#time-message(role="status") Primero selecciona un médico.
                                    .booking-time-grid#time-list

                        section.booking-panel.booking-confirmation(data-booking-step="4", aria-labelledby="confirm-heading")
                            .booking-panel-heading
                                div
                                    span.booking-section-number 4.
                                    h2#confirm-heading Confirma tu cita
                                    p Revisa los datos antes de finalizar la solicitud.
                            .booking-summary#booking-summary
                                p Selecciona especialidad, médico, fecha y hora para continuar.
                            label.booking-reason-label(for="appointment-reason") Motivo de consulta
                                span (opcional)
                            textarea#appointment-reason(name="reason", rows="3", maxlength="500", placeholder="Cuéntanos brevemente el motivo de tu cita")

                        p.booking-form-message#booking-result(role="status", aria-live="polite")
                        .booking-actions
                            button.booking-back(type="button", data-booking-back, hidden) ← Atrás
                            button.booking-next(type="button", data-booking-next)
                                span Siguiente
                                span(aria-hidden="true") →
                            button.booking-submit(type="submit", hidden) Confirmar cita

                include partials/bottom-nav
        script(src="/js/session-timeout.js", defer)
        script(src="/js/patient-appointment-booking.js", defer)
