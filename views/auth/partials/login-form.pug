.login-form-wrap
    img.login-form-logo(
        src="/brand/login/logo-login-mobile.png",
        alt="SaludVital",
        width="280",
        height="94"
    )
    h1#login-title ¡Bienvenido de nuevo!
    p.login-subtitle Inicia sesión para acceder a tu cuenta de salud.

    if error
        p#login-error.login-error(role="alert")= error

    if loginLockedUntil
        p.login-lock-countdown(
            role="status",
            aria-live="polite",
            data-login-lock-countdown,
            data-lock-until=loginLockedUntil
        )
            | Podrás volver a intentarlo en
            strong(data-login-lock-time) Calculando tiempo restante…

    form.login-form(action="/login", method="POST")
        div
            label(for="email") Correo electrónico
            .login-input-wrap
                svg.login-input-icon(
                    aria-hidden="true",
                    viewBox="0 0 24 24",
                    fill="none",
                    stroke="currentColor",
                    stroke-width="1.8"
                )
                    rect(x="3", y="5", width="18", height="14", rx="2")
                    path(d="m3 7 9 6 9-6")
                input#email(
                    type="email",
                    name="email",
                    autocomplete="username",
                    maxlength="320",
                    placeholder="Ingresa tu correo electrónico",
                    required,
                    disabled=Boolean(loginLockedUntil),
                    aria-describedby=loginLockedUntil ? "login-error login-lock-countdown" : error ? "login-error" : undefined
                )

        div
            .login-password-heading
                label(for="password") Contraseña
            .login-password-field
                svg.login-input-icon(
                    aria-hidden="true",
                    viewBox="0 0 24 24",
                    fill="none",
                    stroke="currentColor",
                    stroke-width="1.8"
                )
                    rect(x="4", y="10", width="16", height="11", rx="2")
                    path(d="M8 10V7a4 4 0 0 1 8 0v3")
                input#password(
                    type="password",
                    name="password",
                    autocomplete="current-password",
                    placeholder="Ingresa tu contraseña",
                    required,
                    disabled=Boolean(loginLockedUntil),
                    aria-describedby=loginLockedUntil ? "login-error login-lock-countdown" : undefined
                )
                button.login-password-toggle(
                    type="button",
                    data-password-toggle,
                    disabled=Boolean(loginLockedUntil),
                    aria-label="Mostrar contraseña",
                    aria-pressed="false"
                )
                    svg(
                        aria-hidden="true",
                        viewBox="0 0 24 24",
                        fill="none",
                        stroke="currentColor",
                        stroke-width="1.8"
                    )
                        path(d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z")
                        circle(cx="12", cy="12", r="3")
                    span.sr-only(data-password-toggle-label) Mostrar contraseña
            .login-forgot-link
                a(href="/forgot-password") ¿Olvidaste tu contraseña?

        button.login-submit(type="submit", disabled=Boolean(loginLockedUntil))
            | Iniciar sesión
            span(aria-hidden="true") →

    .login-register
        span o
        p ¿Aún no tienes una cuenta?
        a(href="/register") Crear una cuenta

    p.login-security-note
        span(aria-hidden="true") ◈
        | Tu información de salud está protegida.
