doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="robots", content="noindex, nofollow")
        meta(name="theme-color", content="#123B73")
        title= verified ? "Cuenta confirmada | SaludVital" : "Enlace de verificación no vigente | SaludVital"
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.recovery-page.text-primary.antialiased
        main.recovery-layout
            include ./partials/recovery-visual

            section.recovery-panel(aria-labelledby="verification-title")
                include ./partials/recovery-mobile-hero

                article.recovery-card.email-verification-card
                    img.recovery-card-logo(
                        src="/brand/login/logo-login-mobile.png",
                        alt="SaludVital",
                        width="240",
                        height="80"
                    )

                    if verified
                        .recovery-art-slot.recovery-art-slot-plain.recovery-art-slot-compact(
                            data-image-slot="account-confirmed",
                            aria-hidden="true"
                        )
                            img.recovery-security-illustration(
                                src="/brand/login/recovery-link-sent.png",
                                alt="",
                                width="1536",
                                height="1024"
                            )

                        span.email-verification-badge(role="status")
                            span(aria-hidden="true") ✓
                            | Cuenta confirmada

                        h1#verification-title ¡Tu cuenta ha sido confirmada con éxito!
                        p.recovery-description Ahora puedes iniciar sesión y comenzar a gestionar tus citas médicas en SaludVital.

                        a.recovery-primary-action(href="/login")
                            | Ir al inicio de sesión
                            span(aria-hidden="true") →
                    else
                        .mx-auto.mb-6.flex.h-20.w-20.items-center.justify-center.rounded-full.bg-amber-50.ring-8(
                            class="ring-amber-50/70",
                            aria-hidden="true"
                        )
                            svg.h-10.w-10.text-amber-600(
                                viewBox="0 0 24 24",
                                fill="none",
                                stroke="currentColor",
                                stroke-width="1.8",
                                stroke-linecap="round",
                                stroke-linejoin="round"
                            )
                                circle(cx="12", cy="12", r="9")
                                path(d="M12 8v4")
                                path(d="M12 16h.01")

                        span.email-verification-badge.email-verification-badge-warning(role="status")
                            span(aria-hidden="true") !
                            | Enlace caducado o ya utilizado

                        h1#verification-title Este enlace ya no está vigente
                        p.recovery-description El enlace pudo haber caducado, ser inválido o ya haberse utilizado. Si tu cuenta ya fue confirmada, inicia sesión. Si aún no, comunícate con soporte para solicitar ayuda.

                        a.recovery-primary-action(href="/login") Volver al inicio de sesión

                    include ./partials/recovery-whatsapp

        script(src="/js/login.js", defer)
