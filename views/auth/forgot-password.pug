doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#123B73")
        title= pageTitle
        link(rel="icon", type="image/x-icon", href="/brand/logo-symbol.ico")
        link(rel="stylesheet", href="/css/app.css")

    body.recovery-page.text-primary.antialiased
        main.recovery-layout
            include ./partials/recovery-visual

            section.recovery-panel(aria-labelledby="recovery-title")
                include ./partials/recovery-mobile-hero

                article.recovery-card
                    img.recovery-card-logo(
                        src="/brand/login/logo-login-mobile.png",
                        alt="SaludVital",
                        width="240",
                        height="80"
                    )

                    if success
                        .recovery-art-slot.recovery-art-slot-plain(
                            data-image-slot="recovery-link-sent",
                            aria-hidden="true"
                        )
                            img.recovery-security-illustration(
                                src="/brand/login/recovery-link-sent.png",
                                alt="",
                                width="1536",
                                height="1024"
                            )
                        h1#recovery-title Hemos enviado el enlace
                        p.recovery-description= success
                        .recovery-information(role="note")
                            span.recovery-information-icon(aria-hidden="true") i
                            p Revisa tu bandeja de entrada y, si no lo encuentras, verifica la carpeta de correo no deseado.
                        a.recovery-primary-action(href=returnDestination.href)= returnDestination.label
                    else
                        .recovery-art-slot.recovery-art-slot-lock(
                            data-image-slot="forgot-password",
                            aria-hidden="true"
                        )
                            img.recovery-security-illustration(
                                src="/brand/login/password-security.png",
                                alt="",
                                width="1536",
                                height="1024"
                            )
                        h1#recovery-title ¿Olvidaste tu contraseña?
                        p.recovery-description Ingresa el correo electrónico con el que creaste tu cuenta y te enviaremos un enlace para restablecer tu contraseña.

                        if error
                            p.recovery-error(role="alert")= error

                        form.recovery-form(action="/forgot-password", method="POST")
                            input(type="hidden", name="source", value=source)
                            div
                                label(for="email") Correo electrónico
                                .recovery-input-wrap
                                    svg(
                                        aria-hidden="true",
                                        viewBox="0 0 24 24",
                                        fill="none",
                                        stroke="currentColor",
                                        stroke-width="1.8"
                                    )
                                        rect(x="3", y="5", width="18", height="14", rx="2")
                                        path(d="m3 7 9 6 9-6")
                                    input#email(
                                        type="email",
                                        name="email",
                                        autocomplete="email",
                                        maxlength="320",
                                        placeholder="Ingresa tu correo electrónico",
                                        required
                                    )
                            button.recovery-primary-action(type="submit")
                                | Enviar enlace
                                span(aria-hidden="true") →
                            a.recovery-back-link(href=returnDestination.href) ← #{ returnDestination.label }

                    include ./partials/recovery-whatsapp

        script(src="/js/login.js", defer)
